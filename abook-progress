#!/usr/bin/env python3
"""abook-progress — простая страница с глобальным прогрессом скачивания аудиотеки.

Читает (только чтение) ~/abook/state.json, ~/abook/abook.log и манифесты текущего прохода
(форматы .mp3 и .m4a, движки vydra и direct),
отдаёт страницу на http://127.0.0.1:8791/ с автообновлением каждые 5 с.
"""
import json
import re
import socket
import sys
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from zoneinfo import ZoneInfo

KYIV = ZoneInfo("Europe/Kyiv")

HOME = Path.home() / "abook"
STATE = HOME / "state.json"
LOG = HOME / "abook.log"
MANIFESTS = [HOME / "manifests" / f for f in (
    "D-discoveries.json", "E-works.json", "A-prose.json", "B-scifi.json", "C-classics.json",
    "G2-russian-classics.json", "G1-western-classics.json", "H-radioplays.json", "I-games.json", "J-extra.json")] + [HOME / "F-buldakov-top.json"]
LOG_RE = re.compile(r"^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\] \[([^\]]+)\] (.*)$")
RUN_RE = re.compile(r"^\[[^\]]+\] processing \d+ item\(s\) with --jobs \d+(?:, engine (\w+))?")
PART_RE = re.compile(r"downloading part (\d+)/(\d+)(?:, playlist #(\d+))?")
PLAYLIST_RE = re.compile(r"playlist url #(\d+): (\d+) entries")
MERGE_RE = re.compile(r"downloaded (\d+) part\(s\)(?: in (\d+)s)?, merging(?: -> (\w+))?")
FINAL_RE = re.compile(r"^(DONE|FAILED|skip|was left|DRY-RUN|ERROR)")

# Этапы обработки книги: (метка, доля готовности книги). Строки лога — из abook
# (vydra и direct): downloading part i/n [, playlist #k] → downloaded … merging [-> m4a] → DONE.
# Промежуточные этапы direct-движка (перекодирование, проверка, SHA-256, копирование) в логе
# могут появиться позже — распознаются по ключевым словам.
STAGE_WORDS = [
    (re.compile(r"transcod|re-?encod|harmonis|aac", re.I), "перекодирование в AAC", 0.82),
    (re.compile(r"verif|check|decode|проверк", re.I), "проверка склейки: длительность, главы, полное декодирование", 0.9),
    (re.compile(r"sha-?256|hash", re.I), "подсчёт SHA-256", 0.93),
    (re.compile(r"cop(y|ying)|копир", re.I), "копирование на D: и сверка SHA-256 копии", 0.96),
]


def load_items():
    items = {}
    for m in MANIFESTS:
        try:
            for it in json.loads(m.read_text(encoding="utf-8")).get("items", []):
                items[it["id"]] = it
        except (OSError, ValueError, KeyError, TypeError):
            pass
    return items


def tail_log(max_bytes=400_000):
    try:
        with LOG.open("rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            return f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return []


def classify(msg, prev):
    """Строка лога → (этап, доля) или None, если строка не меняет этап (WARN и т. п.)."""
    pm = PART_RE.search(msg)
    if pm:
        i, n = int(pm.group(1)), int(pm.group(2))
        pl = f" · ролик плейлиста #{pm.group(3)}" if pm.group(3) else ""
        return f"скачивание · часть {i} из {n}{pl}", (i - 1) / n * 0.8
    pm = PLAYLIST_RE.search(msg)
    if pm:
        return f"получен список плейлиста (ссылка #{pm.group(1)}): {pm.group(2)} роликов", max(prev[1], 0.01)
    pm = MERGE_RE.search(msg)
    if pm:
        n, sec, fmt = pm.group(1), pm.group(2), pm.group(3)
        dl = f", скачано за {int(sec) // 60} мин {int(sec) % 60} с" if sec else ""
        if fmt:
            return (f"склейка в {fmt} ({n} ч.{dl}) → проверка: длительность, главы, полное декодирование, "
                    f"SHA-256 → копирование на D:"), 0.88
        return f"склейка {n} ч. в MP3 и проверка", 0.9
    if "attempt" in msg or "backing off" in msg.lower() or "bot-check" in msg:
        return "повтор после ошибки · " + prev[0], prev[1]
    if msg.startswith("WARN"):
        return None
    for rx, label, frac in STAGE_WORDS:
        if rx.search(msg):
            return label, max(frac, prev[1])
    return msg[:80], prev[1]


def item_checks_ok(st):
    """Проверено = есть SHA-256, отметка verified_at и ни одной проваленной проверки."""
    if not (st.get("sha256") and st.get("verified_at")):
        return False
    checks = st.get("checks")
    vals = []
    if isinstance(checks, dict):
        vals = list(checks.values())
    elif isinstance(checks, list):
        vals = checks
    for v in vals:
        if v is False:
            return False
        if isinstance(v, str) and v.lower() in ("fail", "failed", "error", "bad"):
            return False
        if isinstance(v, dict) and (v.get("ok") is False or str(v.get("status", "")).lower() in ("fail", "failed")):
            return False
    return True


def item_has_warnings(st):
    if st.get("warnings"):
        return True
    checks = st.get("checks")
    vals = checks.values() if isinstance(checks, dict) else checks if isinstance(checks, list) else []
    return any((isinstance(v, str) and v.lower() in ("warn", "warning")) or
               (isinstance(v, dict) and str(v.get("status", "")).lower() in ("warn", "warning")) for v in vals)


def snapshot():
    items = load_items()
    try:
        state = json.loads(STATE.read_text(encoding="utf-8")).get("items", {})
    except (OSError, ValueError):
        state = {}

    cur = {}  # id -> {"ts", "stage", "frac", "since", "warn"}
    engine = None
    for line in tail_log():
        rm = RUN_RE.match(line)
        if rm:
            engine = rm.group(1) or "vydra"
            continue
        m = LOG_RE.match(line)
        if not m or m.group(2) not in items:
            continue
        iid, ts, msg = m.group(2), m.group(1), m.group(3)
        if FINAL_RE.match(msg):
            cur.pop(iid, None)
            continue
        c = cur.setdefault(iid, {"ts": ts, "since": ts, "stage": "", "frac": 0.0, "warn": 0})
        if msg.startswith("WARN"):
            c["warn"] += 1
        r = classify(msg, (c["stage"], c["frac"]))
        if r:
            c["stage"], c["frac"] = r
        c["ts"] = ts

    total_h = sum(float(it.get("duration_h") or 0) for it in items.values())
    done_h = failed = done = verified = warned = 0
    size = 0
    done_times = []
    active = []
    partial_h = 0.0
    formats, engines = {}, {}
    for iid, it in items.items():
        st = state.get(iid) or {}
        status = st.get("status")
        est_h = float(it.get("duration_h") or 0)
        if status == "done":
            done += 1
            done_h += (st.get("duration_sec") or est_h * 3600) / 3600
            size += st.get("size_bytes") or 0
            fmt = st.get("format") or Path(st.get("final_path") or "x.mp3").suffix.lstrip(".").lower() or "?"
            formats[fmt] = formats.get(fmt, 0) + 1
            eng = st.get("engine") or "vydra"
            engines[eng] = engines.get(eng, 0) + 1
            verified += item_checks_ok(st)
            warned += item_has_warnings(st)
            try:
                done_times.append((datetime.fromisoformat(st["updated"]).timestamp(),
                                   (st.get("duration_sec") or 0) / 3600))
            except (KeyError, ValueError, TypeError):
                pass
        elif status == "failed":
            failed += 1
        elif status == "in_progress" and iid in cur:
            c = cur[iid]
            frac = min(0.99, c["frac"])
            partial_h += est_h * frac
            active.append({"author": it.get("author", ""), "title": it.get("title", ""),
                           "hours": round(est_h, 1), "stage": c["stage"] or "подготовка",
                           "frac": round(frac, 3), "since": c["since"][11:16], "warn": c["warn"],
                           "parts": len(it.get("urls") or [])})

    now = time.time()
    recent = [h for t, h in done_times if now - t <= 3600]
    rate = sum(recent)  # аудиочасов за последний час
    remaining = max(0.0, total_h - done_h - partial_h)
    eta = None
    if rate > 1:
        eta_ts = now + remaining / rate * 3600
        eta = datetime.fromtimestamp(eta_ts, KYIV).strftime("%d.%m %H:%M") + " (Киев)"
    return {
        "total_h": round(total_h, 1), "done_h": round(done_h, 1), "partial_h": round(partial_h, 1),
        "pct": round(100 * (done_h + partial_h) / total_h, 2) if total_h else 0,
        "books_total": len(items), "books_done": done, "failed": failed,
        "verified": verified, "warned": warned, "formats": formats, "engines": engines,
        "engine": engine,
        "gb": round(size / 1024**3, 1), "rate": round(rate, 1), "eta": eta,
        "active": sorted(active, key=lambda a: -a["frac"]),
        "updated": datetime.now(KYIV).strftime("%H:%M:%S") + " Киев",
    }


