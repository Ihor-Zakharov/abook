       q.position AS qpos
FROM items i LEFT JOIN files f ON f.item_id=i.id LEFT JOIN reviews r ON r.item_id=i.id AND r.profile_id=?
LEFT JOIN queue q ON q.item_id=i.id AND q.profile_id=?
"""


def _item_dict(r, full=False):
    d = {"id": r["id"], "author": r["author"], "title": r["title"], "section": r["section"],
         "bucket": r["bucket"], "hours": r["hours"], "hours_exact": bool(r["hours_exact"]),
         "narrator": r["narrator"], "lang": r["lang"], "ai_voice": bool(r["ai_voice"]),
         "kind": r["kind"], "source": r["source"], "custom": bool(r["custom"]),
         "in_library": bool(r["in_library"]), "start_here": bool(r["start_here"]), "note": r["note"],
         "status": r["fstatus"] or "pending", "has_file": bool(r["fstatus"] == "done" and r["path_wsl"]),
         "overall": r["overall"], "rstatus": r["rstatus"], "in_queue": r["qpos"] is not None,
         "year": r["year"], "format": r["format"], "editable": bool(r["custom"]),
         "fmt": (Path(r["path_wsl"]).suffix.lstrip(".").lower() if r["fstatus"] == "done" and r["path_wsl"] else "")}
    if full:
        d.update(about=r["about"], why=r["why"], path_win=r["path_win"],
                 urls=json.loads(r["urls"] or "[]"))
    return d


def get_items(conn, ids=None, where=None, args=(), full=False):
    if ids is not None:
        if not ids:
            return []
        rows = conn.execute(_ITEM_SELECT + f" WHERE i.id IN ({','.join('?' * len(ids))})",
                            [_pid(), _pid()] + list(ids)).fetchall()
        by = {r["id"]: _item_dict(r, full) for r in rows}
        return [by[i] for i in ids if i in by]
    sql = _ITEM_SELECT + (f" WHERE {where}" if where else "") + " ORDER BY i.section, i.author, i.title, i.id"
    return [_item_dict(r, full) for r in conn.execute(sql, [_pid(), _pid()] + list(args))]


def _review_row_dict(r, tags):
