_SEARCH_CACHE = {}


def _osa(a, b):
    """Optimal string alignment distance (Damerau-Levenshtein with adjacent swaps)."""
    la, lb = len(a), len(b)
    if abs(la - lb) > 2:
        return 3
    d = [[0] * (lb + 1) for _ in range(la + 1)]
    for i in range(la + 1):
        d[i][0] = i
    for j in range(lb + 1):
        d[0][j] = j
    for i in range(1, la + 1):
        for j in range(1, lb + 1):
            c = 0 if a[i - 1] == b[j - 1] else 1
            d[i][j] = min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + c)
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                d[i][j] = min(d[i][j], d[i - 2][j - 2] + 1)
    return d[la][lb]


def _tri(w):
    w = f" {w} "
    return {w[i:i + 3] for i in range(len(w) - 2)}


def _fuzzy_index(conn):
    key = _meta_get(conn, "synced_at")
    if _SEARCH_CACHE.get("key") == key:
        return _SEARCH_CACHE["idx"]
    word_ids, tri_words = {}, {}
    for r in conn.execute("SELECT id, author, title FROM items"):
        for w in re.findall(r"\w+", _norm(f"{r[1]} {r[2]}")):
            if len(w) >= 3:
                word_ids.setdefault(w, set()).add(r[0])
    for w in word_ids:
        for t in _tri(w):
            tri_words.setdefault(t, set()).add(w)
    idx = {"words": word_ids, "tri": tri_words}
    _SEARCH_CACHE.update(key=key, idx=idx)
    return idx


def _fuzzy_ids(conn, toks):
    idx = _fuzzy_index(conn)
    result = None
    for t in toks:
        ids = set()
        cands = set()
        for tr in _tri(t):
            cands |= idx["tri"].get(tr, set())
        lim = 1 if len(t) <= 8 else 2
        for w in cands:
            if w.startswith(t) or _osa(t, w) <= lim or (len(w) > len(t) and _osa(t, w[:len(t)]) <= lim - (len(t) <= 4)):
                ids |= idx["words"][w]
        result = ids if result is None else result & ids
        if not result:
            return set()
    return result or set()


def search_ids(conn, q, limit=30):
    toks = re.findall(r"\w+", _norm(q))
    if not toks:
        return []
    out, seen = [], set()

    def add(ids):
        for i in ids:
            if i not in seen:
                seen.add(i)
                out.append(i)

    # tier 1: FTS5 prefix over author/title («кафки» also tries «кафк*»)
    parts = []
    for t in toks:
        alts = {t} | ({t[:-1]} if len(t) >= 5 else set()) | ({t[:-2]} if len(t) >= 7 else set())
        parts.append("(" + " OR ".join(f'"{a}"*' for a in sorted(alts)) + ")")
    expr = "{author title} : (" + " AND ".join(parts) + ")"
    try:
        add(r[0] for r in conn.execute(
            "SELECT f.id FROM items_fts f JOIN items i ON i.id=f.id WHERE items_fts MATCH ? "
            "ORDER BY i.in_library DESC, bm25(items_fts,0,6.0,10.0,1,1,0,0) LIMIT 80", (expr,)))
    except sqlite3.OperationalError:
        pass
    # tier 2: trigram substring (mid-word fragments like «ругац»)
    if len(out) < 10 and _meta_get(conn, "fts_trigram") == "1":
        subs = [t for t in toks if len(t) >= 3]
        if subs:
            with contextlib.suppress(sqlite3.OperationalError):
                add(r[0] for r in conn.execute(
                    "SELECT t.id FROM items_tri t JOIN items i ON i.id=t.id WHERE items_tri MATCH ? "
                    "ORDER BY i.in_library DESC LIMIT 60", (" AND ".join(f'"{s}"' for s in subs),)))
    # tier 3: typos («ремрак» → Ремарк, «кофка» → Кафка)
    if len(out) < 5:
        fz = _fuzzy_ids(conn, [t for t in toks if len(t) >= 3] or toks)
        if fz:
            add(sorted(fz, key=lambda i: (i.startswith(("read:", "custom:")), i)))
    return out[:limit]


def similar_items(conn, author, title, limit=5):
    """Trigram (Dice) similarity of «author title» against every item — for the dedup warning."""
    q = _norm(f"{author} {title}")
    qt = set()
    for w in re.findall(r"\w+", q):
        qt |= _tri(w)
    tq = set()
    for w in re.findall(r"\w+", _norm(title)):
        tq |= _tri(w)
    if not qt:
        return []
    scored = []
    for r in conn.execute("SELECT id, author, title FROM items"):
        it = set()
        for w in re.findall(r"\w+", _norm(f"{r[1]} {r[2]}")):
            it |= _tri(w)
        tt = set()
        for w in re.findall(r"\w+", _norm(r[2])):
            tt |= _tri(w)
        d_all = 2 * len(qt & it) / (len(qt) + len(it) or 1)
        d_title = 2 * len(tq & tt) / (len(tq) + len(tt) or 1) if tq else 0
        sc = max(d_title, 0.5 * d_all + 0.5 * d_title) if tq else d_all
        if sc >= 0.55:
            scored.append((-round(sc, 4), r[0]))
    scored.sort()
    ids = [i for _, i in scored[:limit]]
    sims = {i: -s for s, i in scored[:limit]}
    return [dict(x, similarity=round(sims[x["id"]], 2)) for x in get_items(conn, ids=ids)]


