_YT_ID = re.compile(r"(?:[?&]v=|youtu\.be/|/shorts/|/live/|/embed/)([A-Za-z0-9_-]{11})")


def source_id(url):
    """Stable id of a source video/file (YouTube id, archive.org item/file, else host+path)."""
    u = (url or "").strip()
    if "youtu" in u:
        m = _YT_ID.search(u)
        if m:
            return "yt:" + m.group(1)
    m = re.search(r"archive\.org/(?:download|details|items|\d+/items)/([^?#]+)", u)
    if m:
        from urllib.parse import unquote
        return "archive:" + unquote(m.group(1)).strip("/")
    p = urlparse(u)
    host = p.netloc.lower()
    for pre in ("www.", "m."):
        if host.startswith(pre):
            host = host[len(pre):]
    return (host + p.path.rstrip("/") + (("?" + p.query) if p.query else "")) or u


_ROMAN_VAL = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100}


def _to_roman(n):
    out = ""
    for v, s in ((100, "C"), (90, "XC"), (50, "L"), (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I")):
        while n >= v:
            out += s
            n -= v
    return out


def _roman(s):
    s = (s or "").upper()
    if not s or any(c not in _ROMAN_VAL for c in s):
        return None
    total = 0
    for i, c in enumerate(s):
        v = _ROMAN_VAL[c]
        nxt = _ROMAN_VAL[s[i + 1]] if i + 1 < len(s) else 0
        total += -v if v < nxt else v
    return total if total > 0 and _to_roman(total) == s else None


def _num(tok):
    return int(tok) if tok.isdigit() else _roman(tok)


_VOL_KW = r"том|книга|кн\.?|volume|vol\.?|book|сезон|season"
_PART_KW = (r"частина|часть|ч\.|глава|гл\.|розділ|раздел|part|pt\.?|chapter|chap\.?|ch\.|серия|серія|"
            r"выпуск|эпизод|episode|ep\.?|№|#|трек|track")
_VOL_RE = re.compile(rf"^(?:{_VOL_KW})$", re.I)
_KW_AFTER = re.compile(rf"(?<!\w)(?P<kw>{_VOL_KW}|{_PART_KW})(?![^\W\d_])\s*[:.\-]?\s*"
                       rf"(?P<n>\d{{1,4}}|[IVXLCivxlc]{{1,7}})(?!\w)", re.I)
_KW_BEFORE = re.compile(rf"(?<![\w/])(?P<n>\d{{1,3}})\s*(?:-?(?:я|й|ая|ий|ый|th|st|nd|rd))?\s+"
                        rf"(?P<kw>{_VOL_KW}|{_PART_KW})(?![^\W\d_])", re.I)
_FRACTION = re.compile(r"(?<![\w/])(\d{1,3})\s*(?:/|из|of|з)\s*(\d{1,3})(?![\w/])", re.I)
_NUM_TOKEN = re.compile(r"(?<![^\W_])(\d{1,3})(?![^\W_])")
_TRAIL_ROMAN = re.compile(r"(?<=[\s.,(\-])([IVXLC]{1,7})\s*[)\]]?\s*$")


def title_numbers(title):
    """Part/chapter numbers in a part title as a comparable tuple, or None.
    Priority: keyword numbers (том/часть/глава/Part/#…, volume-level first), «3/8» / «3 из 8»,
    standalone 1–3 digit tokens (01_…, … 3), a trailing Roman numeral."""
    t = title or ""
    found, used = [], set()
    for rx in (_KW_AFTER, _KW_BEFORE):
        for m in rx.finditer(t):
            n = _num(m.group("n"))
            if n is None or m.start("n") in used:
                continue
            used.add(m.start("n"))
            kw = m.group("kw").strip().lower()
            found.append((0 if _VOL_RE.match(kw) else 1, m.start(), n))
    if found:
        found.sort()
        return tuple(n for _, _, n in found)
    m = _FRACTION.search(t)
    if m and int(m.group(1)) <= int(m.group(2)):
        return (int(m.group(1)),)
    toks = [int(x) for x in _NUM_TOKEN.findall(t)]
    if toks:
        return tuple(toks)
    m = _TRAIL_ROMAN.search(t)
    if m and _roman(m.group(1)):
        return (_roman(m.group(1)),)
    return None


def title_order_problem(titles):
    """Text describing why the numbered titles are out of order, or None."""
    keys = [title_numbers(t) for t in titles]
    have = [(i, k) for i, k in enumerate(keys) if k]
    n = len(titles)
    if n < 2 or len(have) < max(2, math.ceil(ORDER_MIN_FRACTION * n)):
        return None
    bad = []
    for (i1, k1), (i2, k2) in zip(have, have[1:]):
        if k2 < k1:
            f = lambda k: ".".join(map(str, k))  # noqa: E731
            bad.append(f"часть #{i2 + 1} «{_one_line(titles[i2])[:70]}» (номер {f(k2)}) стоит после "
                       f"#{i1 + 1} «{_one_line(titles[i1])[:70]}» (номер {f(k1)})")
    if not bad:
        return None
    more = f" и ещё {len(bad) - 2}" if len(bad) > 2 else ""
    return "; ".join(bad[:2]) + more


def order_and_check_parts(parts, item):
    """Sort parts by (url_index, playlist_index) and refuse duplicates, playlist gaps and
    numbered titles that go backwards (unless the manifest says "order_ok": true)."""
    parts.sort(key=lambda p: (p["url_index"], p.get("playlist_index") or 0))
    seen = {}
    for i, p in enumerate(parts, 1):
        sid = p.get("source_id")
        if sid and sid in seen:
            raise ItemFailed(f"дубликат части: #{seen[sid]} и #{i} — один и тот же источник ({sid})")
        if sid:
            seen[sid] = i
    if not item.get("gaps_ok"):
        by_url = {}
        for p in parts:
            if p.get("playlist_index") is not None:
                by_url.setdefault(p["url_index"], []).append(p["playlist_index"])
        for ui, idxs in sorted(by_url.items()):
            idxs = sorted(idxs)
            if idxs != list(range(1, len(idxs) + 1)):
                missing = sorted(set(range(1, idxs[-1] + 1)) - set(idxs))
                raise ItemFailed(f"пропуски в плейлисте (ссылка #{ui + 1}): нет позиций "
                                 f"{', '.join(map(str, missing[:20]))} (если так и надо — \"gaps_ok\": true в манифесте)")
    if not item.get("order_ok"):
        prob = title_order_problem([p.get("title") or "" for p in parts])
        if prob:
            raise ItemFailed(f"порядок частей под сомнением: {prob}. Если порядок верный — "
                             f"поставьте \"order_ok\": true у этой книги в манифесте")


