    timestamp changes), so two versions diff cleanly."""
    brief = load_brief()
    lib = get_items(conn, where="i.in_library=1", full=True)
    outside = get_items(conn, where="i.in_library=0 AND i.custom=0 AND i.source!='orphan'", full=True)
    own = get_items(conn, where="i.custom=1 OR i.source='orphan'", full=True)
    extra_ids = [r[0] for r in conn.execute(
        "SELECT item_id FROM reviews WHERE profile_id=? UNION SELECT item_id FROM queue WHERE profile_id=? ORDER BY 1",
        (_pid(), _pid()))]
    if _pid() != DEFAULT_PROFILE_ID:   # own/«уже прочитано» books of other listeners are not this one's
        own = [i for i in own if i["id"] in set(extra_ids)]
    by_id = {i["id"]: i for i in lib + outside}
    for i in own:
        by_id[i["id"]] = i
    for i in get_items(conn, ids=[x for x in extra_ids if x not in by_id], full=True):
        by_id[i["id"]] = i
    revs = all_reviews(conn, with_history=True)
    queue = get_queue(conn)
    stats = compute_stats(conn)
    notes = json.loads(_meta_get(conn, "section_notes", "{}") or "{}")
    start_lists = json.loads(_meta_get(conn, "start_lists", "[]") or "[]")
    hours_lib = sum(i["hours"] or 0 for i in lib)
    n_dl = sum(1 for i in lib if i["status"] == "done")
    mode = "lite" if lite else "full"
    prof = conn.execute("SELECT name, slug FROM profiles WHERE id=?", (_pid(),)).fetchone()
    L = [f"<!-- abook:aidoc v{AIDOC_VERSION} · mode {mode} · profile {prof[1] if prof else _pid()} · "
         f"generated {datetime.now():%Y-%m-%d %H:%M} · "
         f"items {len(lib)} · downloaded {n_dl} · reviews {len(revs)} · queue {len(queue)} · "
         f"hours {hours_lib:.0f} -->", ""]

    # §0 README
    L += ["# §0 README",
          "Ты — консультант по личной аудиобиблиотеке одного слушателя. Файл — дамп его базы "
          "(SQLite library.db): профиль, вычисленный вкус, отзывы, очередь, каталог, индексы.",
          "Как отвечать:",
          "- Советуй ТОЛЬКО из §5 CATALOG, если не просят иначе; ссылайся на книги по id в квадратных "
          "скобках, напр. [kafka-protsess]. Сначала — скачанное (ст=✓) без отзыва и то, что в §4 QUEUE.",
          "- Главный сигнал — §2 TASTE и §3 REVIEWS: оценка 8–10 — ищи похожее и объясняй сходство "
          "(автор, раздел, чтец, темы, теги); 0–4 или «бросил» — избегай похожего и скажи, чем "
          "рекомендация отличается.",
          "- Свежие отзывы важнее старых: при подборе опирайся в первую очередь на „Сейчас в фокусе“ (§2) "
          "и колонку вес (§3); старые отзывы — фон. вес = 0.5^(возраст_дней/"
          f"{RECENCY_HALF_LIFE_DAYS:g}), не ниже {RECENCY_FLOOR:g}; последние {RECENCY_RECENT_N} отзывов — "
          f"не ниже {RECENCY_RECENT_MIN:g}; возраст считается от даты «законч» (или обновления) до даты файла.",
          "- Не предлагай как новое то, что уже в §1 «Уже прочитано», названо в анкете (§1) или имеет отзыв (оц в §5).",
          "- Когда просят «чего не хватает» — предлагай книги ВНЕ каталога: автор, название, почему "
