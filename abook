// wash a grey band under tables, fewer foreground flecks over text, and the photon ring a touch brighter so it stays crisp
// through the shade. Every key is interpolated by the spring, so hero → side is one continuous gesture of hole + light.
// card and side share x/y/r on purpose: opening a book → any data screen is a change of light only, never a second move
// one place for the star: left of the search/card column. hero = home and the open card (live); side = every data screen —
// the same place, v 1: the shader dims the frame to ~8 % and pauses («за горизонтом» by state, the kit demo's dark).
// The hole never moves on desktop; only the light changes. Phone: «text above, hole below».
// kit defaults (cosmos.js DEF, ring .88) = the demo's «витрина»; «ось» = components.css [data-comp="center"]; v 1 = the demo's
// «за горизонтом» (the shader dims to ~8 % and the render pauses). Phone: text above, the star below, dark off home.
const COMPS={hero:{x:.70,y:.54,r:.13,halo:1,mist:1,near:1,flare:1,plane:1,far:.85,waves:1,ring:.88,beam:160,v:0},
  side:{x:.5,y:.70,r:.11,halo:1,mist:1,near:1,flare:1,plane:.8,far:.85,waves:1,ring:.88,beam:90,v:1}};
const COMPS_PHONE={hero:{x:.5,y:.86,r:.07,halo:1,mist:1,near:.5,flare:1,plane:.8,far:.85,waves:1,ring:.88,beam:90,v:0},
  far:{x:.5,y:.86,r:.07,halo:1,mist:1,near:.5,flare:1,plane:.8,far:.85,waves:1,ring:.88,beam:90,v:1}};
