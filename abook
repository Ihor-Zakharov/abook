# Media probing, hashing, integrity
# --------------------------------------------------------------------------

def probe_media(path):
    cmd = [FFPROBE_BIN, "-v", "error", "-show_entries",
           "format=duration,size,format_name:format_tags:stream=index,codec_type,codec_name,sample_rate,channels",
           "-show_chapters", "-of", "json", str(path)]
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=FFPROBE_TIMEOUT * 2)
    if proc.returncode != 0:
        raise RuntimeError(f"ffprobe failed on {path}: {proc.stderr.strip()[-300:]}")
    d = json.loads(proc.stdout or "{}")
    fmt = d.get("format") or {}
    if not fmt.get("duration"):
        raise RuntimeError(f"ffprobe returned no duration for {path}")
    aud = [s for s in d.get("streams") or [] if s.get("codec_type") == "audio"]
    chs = []
    for c in d.get("chapters") or []:
        chs.append((float(c.get("start_time") or 0), float(c.get("end_time") or 0),
                    (c.get("tags") or {}).get("title", "")))
    return {"duration": float(fmt["duration"]), "format_name": fmt.get("format_name", ""),
            "tags": {k.lower(): v for k, v in (fmt.get("tags") or {}).items()},
            "audio": aud[0] if aud else None, "chapters": chs}


def sha256_file(path, drop_cache=False):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        if drop_cache:
            with contextlib.suppress(Exception):
                os.posix_fadvise(f.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)
        size, pos, errs = 4 << 20, 0, 0
        while True:
            try:
                chunk = f.read(size)
            except OSError as e:
                # drvfs (/mnt/d) under page-cache pressure sometimes returns ENOMEM on big reads:
                # back off, shrink the read size and resume from the same offset
                if e.errno != errno.ENOMEM or errs >= 20:
                    raise
                errs += 1
                size = max(64 << 10, size // 2)
                time.sleep(min(10, 1 + errs))
                f.seek(pos)
                continue
            if not chunk:
                break
            h.update(chunk)
            pos += len(chunk)
    return h.hexdigest()


def decode_errors(path):
    """Full decode of the audio stream; returns ffmpeg's error output ('' = clean)."""
    cmd = [FFMPEG_BIN, "-nostdin", "-hide_banner", "-v", "error", "-i", str(path), "-map", "0:a",
           "-f", "null", "-"]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=DECODE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return "decode timed out"
    err = (proc.stderr or "").strip()
    return err or ("" if proc.returncode == 0 else f"ffmpeg exit {proc.returncode}")


def decode_scan(path, drop_cache=False):
    """ONE read of the file: SHA-256 + full decode of the audio (bytes are teed into ffmpeg's stdin)
    + silencedetect + the decoded duration. Returns {"sha256", "errors", "decoded_sec", "silences"}."""
    h = hashlib.sha256()
    cmd = [FFMPEG_BIN, "-hide_banner", "-nostats", "-loglevel", "level+info", "-i", "pipe:0", "-map", "0:a",
           "-af", f"silencedetect=noise={SILENCE_NOISE}:d={SILENCE_MIN_SEC}",
           "-progress", "pipe:1", "-f", "null", "-"]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    outbuf, errbuf = [], []
    t1 = threading.Thread(target=lambda: outbuf.append(proc.stdout.read()), daemon=True)
    t2 = threading.Thread(target=lambda: errbuf.append(proc.stderr.read()), daemon=True)
    t1.start()
    t2.start()
    broken = False
    try:
        with open(path, "rb") as f:
            if drop_cache:
                with contextlib.suppress(Exception):
                    os.posix_fadvise(f.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)
            while True:
                chunk = f.read(1 << 20)
                if not chunk:
                    break
                h.update(chunk)
                if not broken:
                    try:
                        proc.stdin.write(chunk)
                    except (BrokenPipeError, OSError):
                        broken = True
    finally:
        with contextlib.suppress(Exception):
            proc.stdin.close()
        try:
            proc.wait(timeout=DECODE_TIMEOUT)
        except subprocess.TimeoutExpired:
            proc.kill()
        t1.join(30)
        t2.join(30)
    res = _parse_decode_output(b"".join(x for x in outbuf if x).decode("utf-8", "replace"),
                               b"".join(x for x in errbuf if x).decode("utf-8", "replace"), proc.returncode)
    if res["errors"] and ("moov atom not found" in res["errors"] or broken):
        # a non-streamable container: decode from the file itself (second read)
        cmd2 = [c if c != "pipe:0" else str(path) for c in cmd]
        try:
            p2 = subprocess.run(cmd2, capture_output=True, timeout=DECODE_TIMEOUT)
            res = _parse_decode_output(p2.stdout.decode("utf-8", "replace"), p2.stderr.decode("utf-8", "replace"),
                                       p2.returncode)
        except subprocess.TimeoutExpired:
            res = {"errors": "decode timed out", "decoded_sec": None, "silences": []}
    res["sha256"] = h.hexdigest()
    return res


_SIL_START = re.compile(r"silence_start: (-?[\d.]+)")
_SIL_END = re.compile(r"silence_end: ([\d.]+) \| silence_duration: ([\d.]+)")


def _parse_decode_output(out, err, rc):
    decoded = None
    for m in re.finditer(r"out_time_us=(\d+)", out):
        decoded = max(decoded or 0, int(m.group(1)) / 1e6)
    errors, sil, start = [], [], None
    for line in err.splitlines():
        if "[error]" in line or "[fatal]" in line or "[panic]" in line:
            errors.append(re.sub(r"^\[[^]]*@ 0x[0-9a-f]+\] ", "", line).replace("[error] ", "").strip())
            continue
        m = _SIL_START.search(line)
        if m:
            start = max(0.0, float(m.group(1)))
            continue
        m = _SIL_END.search(line)
        if m:
            d = float(m.group(2))
            sil.append((round(float(m.group(1)) - d, 1), round(d, 1)))
            start = None
    if start is not None and decoded:          # silence that runs to the very end
        sil.append((round(start, 1), round(decoded - start, 1)))
    text = "; ".join(dict.fromkeys(errors))[:600]
    if rc not in (0, None) and not text:
        text = f"ffmpeg exit {rc}"
    return {"errors": text, "decoded_sec": decoded, "silences": sil}


def silence_verdict(silences):
    """(problems, warnings) from [(start, duration)] silences ≥ SILENCE_MIN_SEC."""
    if not silences:
        return [], []
    total = sum(d for _, d in silences)
    longest = max(silences, key=lambda x: x[1])
    fmt = lambda s: f"{int(s // 3600)}:{int(s % 3600 // 60):02d}:{int(s % 60):02d}"  # noqa: E731
    probs, warns = [], []
    if longest[1] > SILENCE_FAIL_SINGLE:
        probs.append(f"тишина {longest[1] / 60:.1f} мин подряд (с {fmt(longest[0])})")
    if total > SILENCE_FAIL_TOTAL:
        probs.append(f"суммарно тишины {total / 60:.1f} мин")
    if not probs:
        for st, d in silences:
            if d > SILENCE_WARN_SINGLE:
                warns.append(f"тишина {d / 60:.1f} мин (с {fmt(st)})")
    return probs, warns


def _mp4_mdat_bytes(f, size):
    pos, total = 0, 0
    while pos + 8 <= size:
        f.seek(pos)
        h = f.read(16)
        sz, typ, hdr = int.from_bytes(h[:4], "big"), h[4:8], 8
        if sz == 1:
            sz, hdr = int.from_bytes(h[8:16], "big"), 16
        elif sz == 0:
            sz = size - pos
        if sz < hdr:
            break
        if typ == b"mdat":
            total += sz - hdr
        pos += sz
    return total


def audio_payload_bytes(path):
    """File size without container/tag overhead (ID3v2 incl. cover art, ID3v1; for MP4 the mdat
    payload), so «merged ≈ sum of parts» holds even though every part had its own tags/cover."""
    p = Path(path)
    size = p.stat().st_size
    with open(p, "rb") as f:
        head = f.read(12)
        if head[4:8] == b"ftyp":
            return _mp4_mdat_bytes(f, size)
        n = 0
        if head[:3] == b"ID3" and len(head) >= 10:
            b = head[6:10]
            n = 10 + ((b[0] << 21) | (b[1] << 14) | (b[2] << 7) | b[3]) + (10 if head[5] & 0x10 else 0)
        f.seek(max(0, size - 128))
        v1 = 128 if f.read(3) == b"TAG" else 0
        return size - n - v1


def chapter_problems(chs, part_durations):
    """chs: [(start, end, title)]. Chapters must be one per part (none for a single part),
    strictly increasing, starting at the cumulative part durations (±CHAPTER_TOL_SEC)."""
    n = len(part_durations)
    exp = n if n > 1 else 0
    if len(chs) != exp:
        return [f"глав {len(chs)} вместо {exp}"]
    cum, prev = 0.0, None
    for i, (s, _e, _t) in enumerate(chs):
        if prev is not None and s <= prev:
            return [f"начала глав не возрастают (глава {i + 1})"]
        if abs(s - cum) > CHAPTER_TOL_SEC:
            return [f"глава {i + 1} начинается в {s:.2f} с, а по длительностям частей — в {cum:.2f} с"]
        prev = s
        cum += part_durations[i]
    return []


def check_merged_file(path, part_durations, expected_payload=None):
    """(a) duration ≈ sum of parts, (b) chapters, (c) clean full decode whose length matches the
    container, no long silences, (d) payload ≈ sum of parts. SHA-256 comes from the same read."""
    with contextlib.suppress(OSError):          # durable before we hash it
        fd = os.open(path, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    problems = []
    pr = probe_media(path)
    real, total = pr["duration"], sum(part_durations)
    tol = max(2.0, total * 0.02)
    if abs(real - total) > tol:
        problems.append(f"длительность {real:.1f} с ≠ сумме частей {total:.1f} с (допуск {tol:.1f} с)")
    problems += chapter_problems(pr["chapters"], part_durations)
    dec = decode_scan(path)
    problems += media_problems(dec, real)[0]
    warnings = media_problems(dec, real)[1]
    if expected_payload:
        got = audio_payload_bytes(path)
        tol_b = max(16384, expected_payload * SIZE_TOL)
        if abs(got - expected_payload) > tol_b:
            problems.append(f"аудиоданных {got} байт, а сумма частей {expected_payload} (допуск ±2%)")
    return {"duration": real, "chapters": len(pr["chapters"]), "sha256": dec["sha256"], "problems": problems,
            "warnings": warnings, "probe": pr, "decoded_sec": dec["decoded_sec"], "silences": dec["silences"]}


def media_problems(dec, container_sec):
    """(problems, warnings) from a decode_scan() result."""
    probs, warns = [], []
    if dec["errors"]:
        probs.append("ошибка декодирования: " + _one_line(dec["errors"])[:300])
    ds = dec.get("decoded_sec")
    if ds is None:
        probs.append("не удалось измерить декодированную длительность")
    elif abs(ds - container_sec) > DECODED_TOL_SEC:
        probs.append(f"декодировано {ds:.1f} с, а заявлено {container_sec:.1f} с")
    p, w = silence_verdict(dec.get("silences") or [])
    return probs + p, warns + w


# --------------------------------------------------------------------------
# Library checksums (CHECKSUMS.sha256 in the library root, `sha256sum -c` compatible)
# --------------------------------------------------------------------------

@contextlib.contextmanager
def _file_lock(lock_path):
    Path(lock_path).parent.mkdir(parents=True, exist_ok=True)
    with open(lock_path, "a+") as lf:
        fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lf.fileno(), fcntl.LOCK_UN)


def lib_rel(path):
    try:
        return Path(path).relative_to(AUDIOBOOKS_ROOT).as_posix()
    except ValueError:
        return None


_CHECKSUM_LINE = re.compile(r"^\\?([0-9a-fA-F]{64}) [ *](.+)$")


def checksums_read():
    out = {}
    try:
        text = (AUDIOBOOKS_ROOT / CHECKSUMS_NAME).read_text(encoding="utf-8")
    except (FileNotFoundError, OSError):
        return out
    for line in text.splitlines():
        m = _CHECKSUM_LINE.match(line)
        if m:
            out[m.group(2)] = m.group(1).lower()
    return out


def checksums_update(set_entries=None, remove=()):
    """Merge {relpath: sha256} into CHECKSUMS.sha256 and drop `remove` paths, under a lock."""
    set_entries = {k: v for k, v in (set_entries or {}).items() if k and v}
    remove = {r for r in remove if r}
    if not set_entries and not remove:
        return
    path = AUDIOBOOKS_ROOT / CHECKSUMS_NAME
    with _file_lock(STATE_PATH.parent / "checksums.lock"):
        cur = checksums_read()
        new = dict(cur)
        new.update(set_entries)
        for r in remove:
            new.pop(r, None)
        if new == cur and path.exists():
            return
        body = "".join(f"{h}  {p}\n" for p, h in sorted(new.items()))
        tmp = path.with_name(path.name + f".tmp.{os.getpid()}.{threading.get_ident()}")
        with open(tmp, "w", encoding="utf-8", newline="\n") as f:
            f.write(body)
        os.replace(tmp, path)


def copy_verified(src, final_path, sha):
    """Copy to the library via <name>.part + replace; re-read the copy and compare SHA-256.
    Mismatch → delete the copy, retry once, then fail."""
    final_path = Path(final_path)
    dest_tmp = final_path.with_name(final_path.name + ".part")
    for attempt in (1, 2):
        # buffered copy: sendfile()/copy_file_range to drvfs (/mnt/d) can fail with ENOMEM on big files
        with open(src, "rb") as fin, open(dest_tmp, "wb") as fout:
            shutil.copyfileobj(fin, fout, 8 << 20)
            fout.flush()
            with contextlib.suppress(OSError):
                os.fsync(fout.fileno())
        with contextlib.suppress(OSError):
            fd = os.open(dest_tmp, os.O_RDONLY)
            try:
                os.fsync(fd)
            finally:
                os.close(fd)
        got = sha256_file(dest_tmp, drop_cache=True)
        if got == sha:
            os.replace(dest_tmp, final_path)
            return
        log(f"  WARN: SHA-256 of the copy on the library disk differs (attempt {attempt}): {got} != {sha}")
        with contextlib.suppress(OSError):
            dest_tmp.unlink()
    raise ItemFailed(f"копия на диске библиотеки не совпадает с исходником по SHA-256 (2 попытки): {final_path}")


