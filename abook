SHORT_LIMIT_SEC = 2 * 3600


def bucket_dir(duration_sec):
    """Короткое (до 2 ч) / Длинное (от 2 ч) — top-level split by real duration."""
    return "Короткое (до 2 ч)" if duration_sec <= SHORT_LIMIT_SEC else "Длинное (от 2 ч)"


def section_dir(section, duration_sec):
    parts = [sanitize_filename(x) for x in section.split("/") if x.strip()]
    return AUDIOBOOKS_ROOT.joinpath(bucket_dir(duration_sec), *parts)


def process_item(item, dry_run=False, bitrate=DEFAULT_BITRATE, engine=DEFAULT_ENGINE):
    iid = item["id"]
    section = item.get("section") or "Без раздела"
    author = item.get("author") or "Неизвестный автор"
    title = item.get("title") or iid
    narrator = item.get("narrator") or ""
    urls = item.get("urls") or []
    fmt = "m4a" if engine == "direct" else "mp3"

    # keep the title intact (it's what distinguishes volumes); shorten the author part first
    a_short = author
    while len(f"{a_short} — {title}".encode("utf-8")) > MAX_NAME_BYTES and len(a_short) > 12:
        a_short = a_short[: max(12, len(a_short) - 10)].rstrip(" ,;(") + "…"
    final_name = sanitize_filename(f"{a_short} — {title}") + "." + fmt
    final_dir = section_dir(section, (item.get("duration_h") or 0) * 3600)  # refined after merge
    final_path = final_dir / final_name

    if not urls:
        log(f"[{iid}] FAILED: manifest item has no 'urls'")
        if not dry_run:
            state_update_item(iid, status="failed", error="no urls in manifest",
                               section=section, author=author, title=title, updated=now_iso())
        return

    if dry_run:
        log(f"[{iid}] DRY-RUN: {len(urls)} url(s), engine={engine}, bitrate={bitrate} -> {final_path}")
        return

    check_free_space()

    state_update_item(iid, status="in_progress", section=section, author=author,
                       title=title, narrator=narrator, bitrate=bitrate, engine=engine, updated=now_iso())

    _stagger.wait()

    item_stage = STAGING_DIR / iid
    if item_stage.exists():
        shutil.rmtree(item_stage, ignore_errors=True)
    item_stage.mkdir(parents=True, exist_ok=True)

    def fail(reason):
        log(f"[{iid}] FAILED: {reason}")
        state_update_item(iid, status="failed", error=reason, updated=now_iso())
        shutil.rmtree(item_stage, ignore_errors=True)

    try:
        _process_item_body(item, item_stage, bitrate, engine, fmt, final_name)
    except GetCancelled:
        log(f"[{iid}] CANCELLED: прервано по SIGTERM")
        with contextlib.suppress(Exception):
            state_update_item(iid, status="failed", error="отменено пользователем", updated=now_iso())
        shutil.rmtree(item_stage, ignore_errors=True)
        raise
    except LowDiskSpace:
        raise
    except ItemFailed as e:
        fail(str(e))
    except Exception as e:
        import traceback
        log(f"[{item.get('id')}] TRACEBACK: " + " | ".join(traceback.format_exc().strip().splitlines()[-6:]))
        fail(f"{type(e).__name__}: {e}")


def _process_item_body(item, item_stage, bitrate, engine, fmt, final_name):
    iid = item["id"]
    section = item.get("section") or "Без раздела"
    urls = item.get("urls") or []
    t0 = time.monotonic()

    if engine == "direct":
        parts = download_parts_direct(item, urls, item_stage, bitrate)
    else:
        parts = download_parts_vydra(item, urls, item_stage, bitrate)
    if not parts:
        raise ItemFailed("no files produced")
    t_dl = time.monotonic() - t0

    # 1. explicit, checked order: (url_index, playlist_index); no duplicates, gaps, backwards numbers
    order_and_check_parts(parts, item)

    # 2. every part complete vs. the source's own duration
    for p in parts:
        pr = probe_media(p["path"])
        p["duration"], p["_audio"] = pr["duration"], pr["audio"]
    trunc = truncated_parts(parts)
    if trunc:
        raise ItemFailed("неполная загрузка: " + "; ".join(trunc[:3]))

    # 3. m4a: AAC as-is, anything else → AAC (the only re-encoding left); mp3: equalise sample rates
    if fmt == "m4a":
        harmonise_aac(parts, bitrate)
    else:
        harmonise_mp3(parts, bitrate)
    for p in parts:
        p["sha256"] = sha256_file(p["path"])
        p["payload"] = audio_payload_bytes(p["path"])

    log(f"[{iid}] downloaded {len(parts)} part(s) in {t_dl:.0f}s, merging -> {fmt}...")
    durations = [p["duration"] for p in parts]
    merged_tmp = item_stage / f"merged.{fmt}"
    if fmt == "m4a":
        build_merged_m4a(parts, durations, item, merged_tmp)
    else:
        build_merged(parts, durations, item, merged_tmp)

    # 4. merge integrity: duration, chapters, full decode, payload size (+ SHA-256 in the same pass)
    chk = check_merged_file(merged_tmp, durations, sum(p["payload"] for p in parts))
    if chk["problems"]:
        raise ItemFailed("проверка склейки не пройдена: " + "; ".join(chk["problems"]))
    real_duration, sha = chk["duration"], chk["sha256"]

    warnings = chk["warnings"] + short_part_warnings(durations)
    w = manifest_duration_warning(real_duration, item.get("duration_h"))
    if w:
        warnings.append(w)

    # 5. copy to the library, re-read and compare SHA-256; record in CHECKSUMS.sha256
    final_dir = section_dir(section, real_duration)
    final_path = final_dir / final_name
    # never let two different books share one file (same author+title, e.g. audiobook vs radio play)
    try:
        taken = {v.get("final_path") for k, v in load_state().get("items", {}).items()
                 if k != item["id"] and v.get("final_path")}
    except Exception:
        taken = set()
    if str(final_path) in taken:
        stem, ext = final_name.rsplit(".", 1)
        tag = "радиоспектакль" if (item.get("kind") == "radioplay") else (item.get("narrator") or item["id"])
        final_name = sanitize_filename(f"{stem} ({tag})") + "." + ext
        final_path = final_dir / final_name
        if str(final_path) in taken:
            final_name = sanitize_filename(f"{stem} [{item['id']}]") + "." + ext
            final_path = final_dir / final_name
    final_dir.mkdir(parents=True, exist_ok=True)
    copy_verified(merged_tmp, final_path, sha)
    size = final_path.stat().st_size
    rel = lib_rel(final_path)
    if rel:
        try:
            checksums_update({rel: sha})
        except Exception as e:
            log(f"[{iid}] WARN: {CHECKSUMS_NAME} not updated: {e}")
    shutil.rmtree(item_stage, ignore_errors=True)

    state_replace_item(iid, {
        "status": "done",
        "final_path": str(final_path),
        "format": fmt,
        "engine": engine,
        "duration_sec": real_duration,
        "size_bytes": size,
        "sha256": sha,
        "chapters": chk["chapters"],
        "parts": [{"url": p["url"], "url_index": p["url_index"], "playlist_index": p.get("playlist_index"),
                   "title": p.get("title"), "source_id": p.get("source_id"), "duration": round(p["duration"], 3),
                   "source_duration": p.get("source_duration"), "sha256": p["sha256"],
                   **({"transcoded_from": p["transcoded_from"]} if p.get("transcoded_from") else {})}
                  for p in parts],
        "verified_at": now_iso(),
        "warnings": warnings,
        "download_sec": round(t_dl, 1),
        "process_sec": round(time.monotonic() - t0, 1),
        "source_urls": urls,
        "section": section,
        "author": item.get("author") or "Неизвестный автор",
        "title": item.get("title") or iid,
        "narrator": item.get("narrator") or "",
        "bitrate": bitrate,
        "about": item.get("about", ""),
        "why": item.get("why", ""),
        "updated": now_iso(),
        "error": None,
    })
    for w in warnings:
        log(f"[{iid}] WARN: {w}")
    log(f"[{iid}] DONE -> {final_path}  ({real_duration / 3600:.2f} h, {size / 1024**2:.1f} MB, "
        f"{time.monotonic() - t0:.0f}s, sha256 {sha[:12]}…)")


