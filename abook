def download_parts_direct(item, urls, stage, bitrate):
    import functools
    iid = item["id"]
    parts = []
    for ui, url in enumerate(urls):
        entries = [{"playlist_index": None, "url": url, "title": None, "duration": None}]
        if is_playlist_url(url):
            res, err = download_url_with_retry(url, stage, bitrate, runner=ytdlp_list_playlist)
            if res is None:
                raise ItemFailed(f"url #{ui + 1} ({url}): не удалось получить список плейлиста: {err}")
            if res.get("playlist"):
                entries = res["entries"]
                if not entries:
                    raise ItemFailed(f"url #{ui + 1} ({url}): плейлист пуст")
                bad = [e["playlist_index"] for e in entries if e["unavailable"]]
                if bad and not item.get("gaps_ok"):
                    raise ItemFailed(f"в плейлисте (ссылка #{ui + 1}) недоступна часть "
                                     f"{', '.join(map(str, bad[:20]))} (если так и надо — "
                                     f"\"gaps_ok\": true в манифесте)")
                pc = res.get("playlist_count")
                if pc and pc != len(entries) and not item.get("gaps_ok"):
                    raise ItemFailed(f"в плейлисте (ссылка #{ui + 1}) {pc} роликов по данным площадки, а в списке "
                                     f"{len(entries)} — скрытые/удалённые части")
                entries = [e for e in entries if not e["unavailable"]]
                log(f"[{iid}] playlist url #{ui + 1}: {len(entries)} entries")
        for e in entries:
            pi = e["playlist_index"]
            label = f"part {ui + 1}/{len(urls)}" + (f", playlist #{pi}" if pi else "")
            log(f"[{iid}] downloading {label}: {e['url']}")
            runner = functools.partial(run_ytdlp_download, stem=f"u{ui:03d}_p{(pi or 0):04d}")
            res, err = download_url_with_retry(e["url"], stage, bitrate, runner=runner)
            if res is None:
                where = f"в плейлисте (ссылка #{ui + 1}) недоступна часть {pi}" if pi else f"недоступна часть #{ui + 1}"
                raise ItemFailed(f"{where} ({e['url']}): {err}")
            info = res["info"]
            if (info.get("extractor_key") or "").lower().startswith("youtube") and info.get("id"):
                sid = "yt:" + info["id"]
            else:
                sid = source_id(e["url"] if pi else url)
            parts.append({"path": info["filepath"], "url": e["url"], "url_index": ui, "playlist_index": pi,
                          "title": info.get("title") or e.get("title") or Path(info["filepath"]).stem,
                          "source_id": sid, "source_duration": info.get("duration") or e.get("duration")})
    return parts


def download_parts_vydra(item, urls, stage, bitrate):
    iid = item["id"]
    parts = []
    for idx, url in enumerate(urls):
        log(f"[{iid}] downloading part {idx + 1}/{len(urls)}: {url}")
        result, err = download_url_with_retry(url, stage, bitrate=bitrate)
        if result is None:
            raise ItemFailed(f"url #{idx + 1} ({url}) failed after {RETRY_ATTEMPTS} attempts: {err}")
        files = []
        jobs = result.get("jobs") or []
        if not jobs:
            files = [(f, None) for f in result.get("files") or []]
            if not files:
                raise ItemFailed(f"url #{idx + 1} ({url}) produced no files")
        else:
            for job in jobs:
                if job.get("status") != "done":
                    raise ItemFailed(f"url #{idx + 1} ({url}): sub-item {job.get('title')!r} "
                                     f"failed: {job.get('error')}")
                files += [(f, job.get("title")) for f in job.get("files", [])]
        multi = len(files) > 1
        for pos, (f, jtitle) in enumerate(files, 1):
            try:
                tags = probe_media(f["path"])["tags"]
            except Exception:
                tags = {}
            comment = tags.get("comment") or ""
            parts.append({"path": f["path"], "url": url, "url_index": idx,
                          "playlist_index": pos if multi else None,
                          "title": tags.get("title") or Path(f["path"]).stem or jtitle or f.get("title"),
                          "source_id": source_id(comment if (multi and comment.startswith("http")) else url),
                          "source_duration": None})
    return parts


# --------------------------------------------------------------------------
# Completeness heuristics (shared by `get` and `verify`)
# --------------------------------------------------------------------------

def truncated_parts(parts):
    out = []
    for i, p in enumerate(parts, 1):
        sd, d = p.get("source_duration"), p.get("duration")
        if sd and d is not None and abs(d - float(sd)) > max(2.0, 0.005 * float(sd)):
            out.append(f"часть #{i} «{_one_line(p.get('title') or '')[:50]}»: {d:.0f} с из {float(sd):.0f} с по источнику")
    return out


def short_part_warnings(durations):
    if len(durations) < 3:
        return []
    med = statistics.median(durations)
    out = []
    last = len(durations) - 1
    for i, d in enumerate(durations):
        if d < 0.2 * med and not (i in (0, last) and d < 600):
            out.append(f"подозрительно короткая часть #{i + 1}: {d / 60:.1f} мин при медиане {med / 60:.1f} мин")
    return out


def manifest_duration_warning(real_sec, duration_h):
    try:
        exp = float(duration_h) * 3600
    except (TypeError, ValueError):
        return None
    if exp > 0 and abs(real_sec - exp) > 0.05 * exp:
        return f"объём не совпадает с ожидаемым: {real_sec / 3600:.2f} ч вместо ~{exp / 3600:.2f} ч по манифесту"
    return None


