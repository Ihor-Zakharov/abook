def load_manifest_raw(path):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def merge_manifest_items(manifest_paths):
    """Flatten items across manifests, dedupe by id (last wins), warn on dup."""
    merged = {}
    order = []
    for p in manifest_paths:
        manifest = load_manifest_raw(p)
        for it in manifest.get("items", []):
            iid = it.get("id")
            if not iid:
                log(f"WARN: item without 'id' in {p}, skipping: {it!r}")
                continue
            if iid in merged:
                log(f"WARN: duplicate item id {iid!r} (also in an earlier manifest); "
                    f"using the definition from {p}")
            else:
                order.append(iid)
            merged[iid] = it
    return [merged[i] for i in order]


