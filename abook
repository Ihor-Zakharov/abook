def load_state():
    if STATE_PATH.exists():
        try:
            return json.loads(STATE_PATH.read_text(encoding="utf-8"))
        except Exception as e:
            backup = STATE_PATH.with_suffix(".json.bak")
            log(f"WARN: state.json unreadable ({e}), backing up to {backup} and starting fresh")
            try:
                STATE_PATH.rename(backup)
            except Exception:
                pass
    return {"items": {}}


def save_state(state):
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_PATH.with_name(STATE_PATH.name + f".tmp.{os.getpid()}.{threading.get_ident()}")
    tmp.write_text(json.dumps(state, ensure_ascii=False, indent=2), encoding="utf-8")
    tmp.replace(STATE_PATH)


@contextlib.contextmanager
def _state_lock():
    """Exclusive file lock so concurrent threads/processes don't race on state.json.

    Guards a read-modify-write cycle: callers must re-read the state from disk
    *inside* the lock (not reuse a snapshot taken earlier) before writing.
    """
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    lock_path = STATE_PATH.with_name(STATE_PATH.name + ".lock")
    with open(lock_path, "a+") as lf:
        fcntl.flock(lf.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lf.fileno(), fcntl.LOCK_UN)


def state_update_item(iid, **fields):
    """Locked read-modify-write: merge `fields` into item `iid` and save atomically."""
    with _state_lock():
        state = load_state()
        cur = dict(state["items"].get(iid, {}))
        cur.update(fields)
        state["items"][iid] = cur
        save_state(state)
        return cur


def state_replace_item(iid, new_dict):
    """Locked read-modify-write: replace item `iid` wholesale and save atomically."""
    with _state_lock():
        state = load_state()
        state["items"][iid] = new_dict
        save_state(state)


WIN_FORBIDDEN = re.compile(r'[<>:"/\\|?*\x00-\x1f]')


MAX_NAME_BYTES = 170


def sanitize_filename(name):
    name = str(name)
    name = WIN_FORBIDDEN.sub("", name)
    name = name.strip(" .")
    # ext4/drvfs limit a path component to 255 bytes; leave room for ".m4a.part" and temp suffixes
    if len(name.encode("utf-8")) > MAX_NAME_BYTES:
        b = name.encode("utf-8")[:MAX_NAME_BYTES - 3]
        name = b.decode("utf-8", "ignore").rstrip(" .,;") + "…"
    return name or "untitled"


def ffmeta_escape(s):
    return re.sub(r'([=;#\\\n])', r'\\\1', str(s))


def write_windows_text(path, text):
    """UTF-8 with BOM, CRLF line endings, for Windows Notepad."""
    content = text.replace("\r\n", "\n").replace("\n", "\r\n")
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "wb") as f:
        f.write(b"\xef\xbb\xbf")
        f.write(content.encode("utf-8"))


def ffprobe_duration(path):
    cmd = [FFPROBE_BIN, "-v", "error", "-show_entries", "format=duration",
           "-of", "csv=p=0", str(path)]
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=FFPROBE_TIMEOUT)
    if proc.returncode != 0:
        raise RuntimeError(f"ffprobe failed on {path}: {proc.stderr.strip()}")
    out = proc.stdout.strip()
    if not out:
        raise RuntimeError(f"ffprobe returned no duration for {path}")
    return float(out)


def has_video_stream(path):
