        conn.execute("DELETE FROM files")
        conn.executemany("INSERT INTO files(item_id,status,path_wsl,path_win,seconds,bytes,updated)"
                         " VALUES(?,?,?,?,?,?,?)", file_rows)
        _rebuild_fts(conn)
        _meta_set(conn, "section_notes", json.dumps(notes, ensure_ascii=False))
        _meta_set(conn, "start_lists", json.dumps(start_lists, ensure_ascii=False))
        _meta_set(conn, "manifest_errors", json.dumps(errors, ensure_ascii=False))
        _meta_set(conn, "synced_at", now)
        _meta_set(conn, "sources_sig", sig)
    _SEARCH_CACHE.clear()
    n = conn.execute("SELECT count(*), sum(in_library), (SELECT count(*) FROM files WHERE status='done')"
                     " FROM items WHERE source!='read'").fetchone()
    return {"items": n[0], "in_library": n[1] or 0, "downloaded": n[2], "manifest_errors": errors,
            "stale": len(stale), "ms": int((time.time() - t0) * 1000)}


