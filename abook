            seen.add(r["id"])
        # items that vanished from their (successfully parsed) source
        stale = [r["id"] for r in conn.execute(
            "SELECT id, source FROM items WHERE source NOT IN ('custom','read','orphan')")
            if r["id"] not in seen and (r["source"] in ok_sources or r["source"] == "state")]
        for iid in stale:
            used = conn.execute(
