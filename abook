function hbars(rows,{max=10,fmt=v=>v,color=()=>'#d9dbe3',marker=null}={}){if(!rows.length)return '<div class="sub">нет данных</div>';
  const W=560,rh=24,lw=200,H=rows.length*rh+4;let s=`<svg viewBox="0 0 ${W} ${H}" width="100%" role="img">`;
  rows.forEach((r,i)=>{const y=i*rh+2,w=Math.max(2,(W-lw-70)*(r.v/max));const lab=r.name.length>28?r.name.slice(0,27)+'…':r.name;
    s+=`<text x="${lw-8}" y="${y+15}" text-anchor="end">${esc(lab)}</text><rect x="${lw}" y="${y+6}" width="${w}" height="${rh-12}" rx="2" fill="${color(r.v)}"/>`;
    if(marker&&r.m!=null){const mx=lw+(W-lw-70)*(r.m/max);s+=`<rect x="${mx-1}" y="${y+2}" width="2" height="${rh-4}" rx="1" fill="#ffffff"><title>свежее ${r.m}</title></rect>`}
    s+=`<text x="${lw+w+6}" y="${y+15}">${esc(fmt(r.v))}${r.sub?` <tspan class="ax">${esc(r.sub)}</tspan>`:''}</text>`});return s+'</svg>'}
function vbars(vals,labels,colorF){const W=560,H=150,pad=18,n=vals.length,bw=(W-pad*2)/Math.max(n,1),mx=Math.max(1,...vals);let s=`<svg viewBox="0 0 ${W} ${H}" width="100%" role="img">`;
  vals.forEach((v,i)=>{const h=(H-44)*(v/mx),x=pad+i*bw+3,y=H-22-h;s+=`<rect x="${x}" y="${y}" width="${bw-6}" height="${v?Math.max(h,2):0}" rx="2" fill="${colorF(i)}"/><text class="ax" x="${x+(bw-6)/2}" y="${H-6}" text-anchor="middle">${esc(labels[i])}</text>`;if(v)s+=`<text x="${x+(bw-6)/2}" y="${y-5}" text-anchor="middle">${v}</text>`});
  return s+`<line x1="${pad}" x2="${W-pad}" y1="${H-21}" y2="${H-21}" stroke="rgba(255,255,255,.14)" stroke-width="1"/></svg>`}
