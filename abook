  if(SC.comp===name&&!immediate)return;SC.comp=name;SC.from={...SC.cur};SC.to=to;SC.k.snap(0);if(immediate)SC.k.snap(1);else SC.k.set(1);
  if(still())SC.api?.setPointer(0,0);smoke();sceneWake()}
const scrollDim=()=>SC.comp==='hero'?scrollY/(innerHeight*.85):0;   // home scrolled past the hero: the demo's «за горизонтом»
function sceneWrite(){const c=SC.cur,w=SC.wrap;if(!c)return;const railW=phone()?0:$('.rail').offsetWidth,vw=innerWidth;
