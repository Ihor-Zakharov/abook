  const drift=[...s.drift.rising.map(x=>`<span class="chip on">↑ ${esc(x.kind)} ${esc(x.name)} ${f1(x.avg)}→${f1(x.wavg)}</span>`),...s.drift.falling.map(x=>`<span class="chip">↓ ${esc(x.kind)} ${esc(x.name)} ${f1(x.avg)}→${f1(x.wavg)}</span>`)].join(' ')||'<span class="sub">дрейф пока не выражен</span>';
  h+=`<div class="cols">${pn('Сейчас в фокусе',`<div class="list">${focus}</div>`)}${pn('Дрейф вкуса (в среднем → свежее)',`<div class="chips">${drift}</div>`)}</div>`;
  const ar=a=>a.slice(0,10).map(x=>({name:x.name,v:x.avg,m:x.wavg,sub:'n='+x.n}));const opt={fmt:f1,color:v=>rcol(v),marker:true};
  h+=`<div class="cols">${pn('Средняя по разделам (| — свежее)',hbars(ar(s.avg_by.section),opt))}${pn('Средняя по авторам',hbars(ar(s.avg_by.author),opt))}</div>`;
  h+=`<div class="cols">${pn('Средняя по чтецам',hbars(ar(s.avg_by.narrator),opt))}${pn('Подоценки (средние)',hbars(Object.values(s.subscores).filter(x=>x.n).map(x=>({name:x.label,v:x.avg,sub:'n='+x.n})),{fmt:f1,color:v=>rcol(v)}))}</div>`;
  const lst=a=>a.map((t,i)=>`<div class="ri" data-id="${esc(t.item_id)}" style="padding:8px 12px;align-items:center">${scoreHtml(t.overall,true)}<div class="body"><div class="tt">${i+1}. ${esc((t.author?t.author+' — ':'')+t.title)}</div></div></div>`).join('');
  h+=`<div class="cols">${pn('Топ-10',`<div class="list">${lst(s.top)}</div>`)}${pn('Антитоп',`<div class="list">${lst(s.bottom.slice(0,10))}</div>`)}</div>`;
  const tg=(a,c)=>a.length?a.map(t=>`<span class="chip ${c} on">${esc(t.tag)} · ${f1(t.avg)} · n${t.n}</span>`).join(' '):'<span class="sub">пока нет</span>';
  h+=`<div class="cols">${pn('Любимые теги (средняя ≥ 7,5)',`<div class="chips">${tg(s.loved_tags,'pos')}</div>`)}${pn('Нелюбимые теги',`<div class="chips">${tg(s.disliked_tags,'neg')}</div>`)}</div>`;
  return h}

