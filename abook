def _set_library_root(p):
    global AUDIOBOOKS_ROOT, LIBRARY_ROOT, OUT_DIR, LAUNCHER_PATH
    AUDIOBOOKS_ROOT = Path(p).expanduser().resolve()
    LIBRARY_ROOT = AUDIOBOOKS_ROOT.parent
    OUT_DIR = AUDIOBOOKS_ROOT
    LAUNCHER_PATH = AUDIOBOOKS_ROOT / "Отзывы.bat"


def _bitrate_type(s):
    v = int(s)
    if v not in VALID_BITRATES:
        raise argparse.ArgumentTypeError(f"must be one of {VALID_BITRATES}")
    return v


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--state", metavar="PATH",
                         help="override path to state.json (default ~/abook/state.json "
                              "or $ABOOK_STATE); use for testing without touching a live run")
    common.add_argument("--library", metavar="DIR",
                         help="library root instead of D:\\VideoDownloader\\Аудиокниги (or $ABOOK_LIBRARY)")

    parser = argparse.ArgumentParser(prog="abook", description=__doc__,
                                      formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p_get = sub.add_parser("get", parents=[common], help="download and merge items from manifest(s)")
    p_get.add_argument("manifests", nargs="+")
    p_get.add_argument("--only", nargs="+", metavar="ID", help="process only these item ids")
    p_get.add_argument("--dry-run", action="store_true")
    p_get.add_argument("--retry-failed", action="store_true")
    p_get.add_argument("--jobs", type=int, default=1, metavar="N",
                        help="process N items concurrently (default 1)")
    p_get.add_argument("--bitrate", type=_bitrate_type, default=DEFAULT_BITRATE,
                        metavar="{128,192,256,320}",
                        help=f"mp3 bitrate, kbps (default {DEFAULT_BITRATE}: YouTube audio "
                             f"sources are ~130kbps opus, so 128 is effectively source quality)")
    p_get.add_argument("--engine", choices=("direct", "vydra"), default=DEFAULT_ENGINE,
                        help="direct (default): yt-dlp best audio, AAC kept as-is, merged to .m4a; "
                             "vydra: the old path, re-encoded .mp3")
    p_get.set_defaults(func=cmd_get)

    p_verify = sub.add_parser("verify", parents=[common],
                              help="check downloaded files: existence+size (--quick) or SHA-256, decode, "
                                   "chapters, silences, completeness (--full); --fix quarantines broken ones")
    p_verify.add_argument("manifests", nargs="*", help="manifests defining the library (default: all)")
    g = p_verify.add_mutually_exclusive_group()
    g.add_argument("--quick", action="store_true", help="existence + size only (default)")
    g.add_argument("--full", action="store_true", help="SHA-256, full decode, chapters, silences, completeness")
    p_verify.add_argument("--fix", action="store_true",
                          help="move broken files to .quarantine/ and mark them failed (for get --retry-failed)")
    p_verify.add_argument("--no-net", action="store_true",
                          help="--full: don't ask the platform for source durations of old items")
    p_verify.add_argument("--json", action="store_true", help="print the result as JSON")
    p_verify.set_defaults(func=cmd_verify)

    p_status = sub.add_parser("status", parents=[common], help="show progress table")
    p_status.add_argument("manifests", nargs="*")
    p_status.set_defaults(func=cmd_status)

    p_notes = sub.add_parser("notes", parents=[common], help="write ОБ ЭТОМ.txt / ЧИТАЙ МЕНЯ.txt")
    p_notes.add_argument("manifests", nargs="+")
    p_notes.set_defaults(func=cmd_notes)

    dbopt = argparse.ArgumentParser(add_help=False)
    dbopt.add_argument("--db", metavar="PATH", help="library DB (default ~/abook/library.db or $ABOOK_DB); "
                       "a separate DB = test mode: outputs go to <db dir>/out, no cloud/launcher")
    dbopt.add_argument("--out-dir", metavar="DIR", help="where the AI doc, lite, library.csv and .reviews.json "
                       "are written (default D:\\VideoDownloader\\Аудиокниги or $ABOOK_OUT_DIR)")

    p_sync = sub.add_parser("sync", parents=[common, dbopt],
                             help="import manifests + state.json into library.db, regenerate the AI doc")
    p_sync.set_defaults(func=cmd_sync)

    p_aidoc = sub.add_parser("aidoc", parents=[common, dbopt],
                              help="write БИБЛИОТЕКА_ДЛЯ_ИИ.md (+ _lite.md, library.csv) from library.db")
    p_aidoc.add_argument("--lite", action="store_true", help="also print the lite doc path")
    p_aidoc.set_defaults(func=cmd_aidoc)

    p_review = sub.add_parser("review", parents=[common, dbopt],
                               help="local web app for reviews (127.0.0.1, Ctrl+C to stop)")
    p_review.add_argument("--port", type=int, default=REVIEW_DEFAULT_PORT,
                           help=f"first port to try (default {REVIEW_DEFAULT_PORT}; next free one is used)")
    p_review.add_argument("--no-browser", action="store_true", help="don't open a browser")
    p_review.set_defaults(func=cmd_review)

    args = parser.parse_args()

    global STATE_PATH, STAGING_DIR, LOG_PATH
    state_override = getattr(args, "state", None) or os.environ.get("ABOOK_STATE")
    if state_override:
        STATE_PATH = Path(state_override).expanduser().resolve()
        if STATE_PATH.parent != ABOOK_DIR.resolve():     # isolated run: own log + staging
            STAGING_DIR = STATE_PATH.parent / "staging"
            LOG_PATH = STATE_PATH.parent / "abook.log"
    if getattr(args, "library", None):
        _set_library_root(args.library)

    ABOOK_DIR.mkdir(parents=True, exist_ok=True)
    STAGING_DIR.mkdir(parents=True, exist_ok=True)
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    args.func(args)


if __name__ == "__main__":
    try:
        main()
    except LowDiskSpace as e:
        log(str(e))
        sys.exit(1)
    except KeyboardInterrupt:
        log("Interrupted by user")
        sys.exit(130)
    except GetCancelled:
        log("Cancelled (SIGTERM)")
        sys.exit(143)
