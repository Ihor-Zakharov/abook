def _words(text):
    out = {}
    for w in re.findall(r"[^\W\d_]+", _norm(text)):
        if len(w) >= 5 and w not in _STOP:
            st = w[:6]
            out[st] = out.get(st, 0) + 1
    return out


def _display_words(text):
    m = {}
    for w in re.findall(r"[^\W\d_]+", _norm(text)):
        if len(w) >= 5 and w not in _STOP:
            m.setdefault(w[:6], w)
    return m


def recommend(conn, limit=10):
    items = [i for i in get_items(conn, where="i.in_library=1", full=True)]
    revs = {r["item_id"]: r for r in _joined_reviews(conn)}
    queue = get_queue(conn)
    qpos = {k: i for i, k in enumerate(queue)}
    tagmap = _tags_map(conn)
    # TF-IDF over «о чём / почему / теги» for every library item (+ reviewed outside ones)
    docs = {}
    for it in items:
        docs[it["id"]] = _words(" ".join([it["about"], it["why"], it["title"], " ".join(tagmap.get(it["id"], []))]))
    for iid, r in revs.items():
        if iid not in docs:
            docs[iid] = _words(" ".join([r["title"], " ".join(r["tags"])]))
    N = max(1, len(docs))
    df = {}
    for d in docs.values():
        for w in d:
            df[w] = df.get(w, 0) + 1
    vec = {}
    for iid, d in docs.items():
        v = {w: (1 + math.log(c)) * math.log(1 + N / df[w]) for w, c in d.items()}
        n = math.sqrt(sum(x * x for x in v.values())) or 1.0
        vec[iid] = {w: x / n for w, x in v.items()}

    def cos(a, b):
        va, vb = vec.get(a, {}), vec.get(b, {})
        if len(va) > len(vb):
            va, vb = vb, va
        return sum(x * vb.get(w, 0.0) for w, x in va.items())

    weights, _ = review_weights(list(revs.values()))
    seeds = []
    for iid, r in sorted(revs.items()):
        if r["status"] == "want":
            continue
        rating = r["overall"] if isinstance(r["overall"], int) else (2 if r["status"] == "dropped" else None)
        if rating is None:
            continue
        rw, age = weights[iid]
        seeds.append({"id": iid, "r": r, "w": (rating - 5.5) * rw, "rw": rw, "age": age, "author": _norm(r["author"]),
                      "section": r["section"], "narrator": _norm(r["narrator"])})
    stats = compute_stats(conn)
    dropped_by_section = {}
    for r in revs.values():
        if r["status"] == "dropped" and r["section"]:
            dropped_by_section[r["section"]] = dropped_by_section.get(r["section"], 0) + 1
    recent = sorted(revs.values(), key=lambda r: r["updated"], reverse=True)[:6]
    long_drops = sum(1 for r in recent if r["status"] == "dropped" and r["bucket"] == "long")
    bad_tags = [t["tag"] for t in stats["disliked_tags"] if t["n"]]
    top_narr = {_norm(x["name"]): x for x in stats["avg_by"]["narrator"] if x["avg"] >= 8}
    out = []
    for c in items:
        rv = revs.get(c["id"])
        if rv and rv["status"] != "want":
            continue
        score, plus, minus, best = 0.0, [], [], None
        for s in seeds:
            same_a = bool(s["author"]) and _norm(c["author"]) == s["author"]
            same_s = bool(s["section"]) and s["section"] != OUTSIDE_SECTION and c["section"] == s["section"]
            same_n = bool(s["narrator"]) and bool(c["narrator"]) and _norm(c["narrator"]) == s["narrator"]
            cs = cos(c["id"], s["id"])
            sim = 0.35 * same_a + 0.20 * same_s + 0.10 * same_n + 0.35 * cs
            contrib = sim * s["w"]
            score += contrib
            if sim > 0.05 and (best is None or abs(contrib) > abs(best[0])):
                best = (contrib, s, same_a, same_s, same_n, cs)
        if best:
            contrib, s, a, se, n, cs = best
            bits = [b for b, on in (("тот же автор", a), ("тот же раздел", se), ("тот же чтец", n)) if on]
            if cs > 0.08:
                shared = sorted(set(vec.get(c["id"], {})) & set(vec.get(s["id"], {})),
                                key=lambda w: -(vec[c["id"]][w] * vec[s["id"]][w]))[:3]
                disp = _display_words(" ".join([c["about"], c["why"], c["title"]]))
                if shared:
                    bits.append("общие мотивы: " + ", ".join(disp.get(w, w) for w in shared))
            rating_s = f"{s['r']['overall']}/10" if s["r"]["overall"] is not None else "брошено"
            label = f"«{s['r']['title']}» ({rating_s}, {_age_ru(s['age'])}, вес {s['rw']:.2f})"
            if contrib > 0:
                plus.append(f"после {label}: " + ", ".join(bits))
            else:
                minus.append(f"похоже на {label}: " + ", ".join(bits))
        cw = docs.get(c["id"], {})
        pen_tags = [t for t in bad_tags if any(w[:6] in cw for w in re.findall(r"\w{5,}", _norm(t)))]
        if pen_tags:
            score -= 0.8 * min(len(pen_tags), 2)
            minus.append("есть черты нелюбимых тегов: " + ", ".join(pen_tags[:2]))
        if dropped_by_section.get(c["section"]):
            k = dropped_by_section[c["section"]]
            score -= 0.7 * min(k, 3)
            minus.append(f"в разделе «{c['section']}» брошено: {k}")
        if c["bucket"] == "long" and long_drops >= 2:
            score -= 0.5
            minus.append(f"длинное, а вы недавно бросили {long_drops} длинные книги")
        if c["id"] in qpos:
            score += 1.0 * (1 - qpos[c["id"]] / max(1, len(queue)))
            plus.append(f"в очереди (#{qpos[c['id']] + 1})")
        tn = top_narr.get(_norm(c["narrator"])) if c["narrator"] else None
        if tn:
            score += 0.6
            plus.append(f"любимый чтец {c['narrator']} (средняя {tn['avg']})")
        if c["status"] == "done":
            score += 0.3
        if c["ai_voice"]:
            score -= 0.3
            minus.append("ИИ-озвучка")
        if not seeds:
            if not c["start_here"]:
                continue
            score += 1.0
            plus.append("стартовая точка составителя каталога")
        elif score <= 0.05:
            continue
        out.append({**{k: c[k] for k in ("id", "author", "title", "section", "hours", "hours_exact",
                                           "bucket", "narrator", "ai_voice", "status", "in_queue", "about")},
                    "score": round(score, 3), "plus": plus, "minus": minus})
    out.sort(key=lambda x: (-x["score"], x["id"]))
    return {"items": out[:limit], "seeds": len(seeds), "recency": stats["recency"],
            "recent": [{"item_id": s["id"], "title": s["r"]["title"], "w": s["rw"], "age_ru": _age_ru(s["age"])}
                       for s in sorted(seeds, key=lambda s: (-s["rw"], s["id"]))[:5]]}


