    hist = [{"id": h["id"], "saved_at": h["saved_at"], "reason": h["reason"], **json.loads(h["snapshot"])}
            for h in conn.execute("SELECT * FROM review_history WHERE profile_id=? AND item_id=? ORDER BY id DESC",
                                  (_pid(), iid))]
