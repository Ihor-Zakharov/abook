# ------------------------------ review writes ------------------------------

_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def _clean_review(payload):
    status = payload.get("status") or "listened"
    if status not in REVIEW_STATUSES:
        raise ValueError(f"Неизвестный статус: {status}")

    def score(v, what):
        if v in (None, ""):
            return None
        try:
            v = int(v)
        except (TypeError, ValueError):
            raise ValueError(f"{what}: нужно число 0–10")
        if not 0 <= v <= 10:
            raise ValueError(f"{what}: от 0 до 10")
        return v

    overall = score(payload.get("overall"), "Общая оценка")
    if overall is None and status != "want":
        raise ValueError("Нужна общая оценка 0–10")
    scores = {k: score((payload.get("scores") or {}).get(k), lab) for k, lab, _ in SUBSCORES}
    tags, seen = [], set()
    for t in payload.get("tags") or []:
        t = re.sub(r"\s+", " ", str(t)).strip()[:40]
        if t and _norm(t) not in seen:
            seen.add(_norm(t))
            tags.append(t)
    dates = {}
    for k in ("started", "finished"):
        v = str(payload.get(k) or "").strip()
        if v and not _DATE_RE.match(v):
            raise ValueError("Дата: формат ГГГГ-ММ-ДД")
        dates[k] = v
    text = str(payload.get("text") or "").replace("\r\n", "\n").strip()
    quote = str(payload.get("quote") or "").replace("\r\n", "\n").strip()
    if len(text) > 50000 or len(quote) > 5000:
        raise ValueError("Слишком длинный текст")
    return {"overall": overall, "scores": {k: v for k, v in scores.items() if v is not None},
            "status": status, "stopped_at": str(payload.get("stopped_at") or "").strip()[:200],
            "started": dates["started"], "finished": dates["finished"], "quote": quote,
            "relisten": bool(payload.get("relisten")), "text": text, "tags": tags[:30]}


_CMP_FIELDS = ("overall", "scores", "status", "stopped_at", "started", "finished", "quote",
               "relisten", "text", "tags")


def _snapshot(rev):
    return {k: rev.get(k) for k in _CMP_FIELDS + ("updated",)}


def _canon_tags(conn, tags):
    existing = {_norm(r[0]): r[0] for r in conn.execute("SELECT tag FROM tags")}
    out = []
    for t in tags:
        c = existing.get(_norm(t))
        if not c:
            conn.execute("INSERT INTO tags(tag,is_preset,polarity) VALUES(?,0,0)", (t,))
            existing[_norm(t)] = c = t
        out.append(c)
    return out


def _queue_add(conn, iid):
    if conn.execute("SELECT 1 FROM queue WHERE profile_id=? AND item_id=?", (_pid(), iid)).fetchone():
        return
    pos = conn.execute("SELECT coalesce(max(position),0)+1 FROM queue WHERE profile_id=?", (_pid(),)).fetchone()[0]
    conn.execute("INSERT INTO queue(profile_id,item_id,position,added) VALUES(?,?,?,?)", (_pid(), iid, pos, now_iso()))


def _write_review(conn, iid, f, reason="update"):
    """Inside a transaction: current -> history (if it differs), then upsert."""
    cur = get_review(conn, iid)
    now = now_iso()
    if cur and any(cur.get(k) != f.get(k) for k in _CMP_FIELDS):
        conn.execute("INSERT INTO review_history(profile_id,item_id,snapshot,saved_at,reason) VALUES(?,?,?,?,?)",
                     (_pid(), iid, json.dumps(_snapshot(cur), ensure_ascii=False), now, reason))
    sc = f["scores"]
    conn.execute(f"""
        INSERT INTO reviews(profile_id,item_id,overall,{','.join(SUB_KEYS)},status,stopped_at,started,finished,
                            quote,relisten,text,created,updated)
        VALUES(?,?,?,{','.join('?' * len(SUB_KEYS))},?,?,?,?,?,?,?,?,?)
        ON CONFLICT(profile_id,item_id) DO UPDATE SET overall=excluded.overall,
          {','.join(f'{k}=excluded.{k}' for k in SUB_KEYS)}, status=excluded.status,
          stopped_at=excluded.stopped_at, started=excluded.started, finished=excluded.finished,
          quote=excluded.quote, relisten=excluded.relisten, text=excluded.text, updated=excluded.updated""",
                 [_pid(), iid, f["overall"]] + [sc.get(k) for k in SUB_KEYS] +
                 [f["status"], f["stopped_at"], f["started"], f["finished"], f["quote"],
                  1 if f["relisten"] else 0, f["text"], (cur or {}).get("created") or now, now])
    conn.execute("DELETE FROM item_tags WHERE profile_id=? AND item_id=?", (_pid(), iid))
    conn.executemany("INSERT OR IGNORE INTO item_tags(profile_id,item_id,tag) VALUES(?,?,?)",
                     [(_pid(), iid, t) for t in _canon_tags(conn, f["tags"])])
    if f["status"] == "want":
        _queue_add(conn, iid)
    else:
        conn.execute("DELETE FROM queue WHERE profile_id=? AND item_id=?", (_pid(), iid))


def save_review(conn, payload):
    f = _clean_review(payload)
    iid = str(payload.get("item_id") or "").strip()
    with _WRITE_LOCK:
        with _tx(conn):
            row = conn.execute("SELECT custom FROM items WHERE id=?", (iid,)).fetchone()
            if iid == "custom:new" or (row and row["custom"]):
                cf = {k: str(payload.get(k) or "").strip()[:300] for k in ("author", "title", "year", "section", "format", "note")}
                if not cf["title"]:
                    raise ValueError("Укажите название произведения")
                cf["section"] = cf["section"] or OUTSIDE_SECTION
                if iid == "custom:new":
                    base = "custom:" + _translit_slug(f"{cf['author']} {cf['title']}" if cf["author"] else cf["title"])
                    iid, n = base, 2
                    while conn.execute("SELECT 1 FROM items WHERE id=?", (iid,)).fetchone():
                        iid, n = f"{base}-{n}", n + 1
                    conn.execute("INSERT INTO items(id,source,custom,in_library,added,synced) VALUES(?,'custom',1,0,?,?)",
                                 (iid, now_iso(), now_iso()))
                conn.execute("UPDATE items SET author=?,title=?,year=?,section=?,format=?,note=? WHERE id=?",
                             (cf["author"], cf["title"], cf["year"], cf["section"], cf["format"], cf["note"], iid))
                it = conn.execute("SELECT id,author,title,section,narrator,about,why FROM items WHERE id=?", (iid,)).fetchone()
                conn.execute("DELETE FROM items_fts WHERE id=?", (iid,))
                conn.execute("INSERT INTO items_fts(id,author,title,section,narrator,about,why) VALUES(?,?,?,?,?,?,?)",
                             (it[0],) + tuple(_norm(x) for x in it[1:]))
                if _meta_get(conn, "fts_trigram") == "1":
                    conn.execute("DELETE FROM items_tri WHERE id=?", (iid,))
                    conn.execute("INSERT INTO items_tri(id,name) VALUES(?,?)", (iid, _norm(f"{cf['author']} {cf['title']}")))
                _SEARCH_CACHE.clear()
            elif not row:
                raise ValueError(f"Нет такой позиции: {iid}")
            _write_review(conn, iid, f)
        out = refresh_outputs(conn, "save")
    rev, hist = get_review(conn, iid, with_history=True)
    return {"item_id": iid, "review": rev, "history": hist, **out}


def restore_review(conn, iid, hid):
    with _WRITE_LOCK:
        with _tx(conn):
            h = conn.execute("SELECT snapshot FROM review_history WHERE id=? AND item_id=? AND profile_id=?",
                             (hid, iid, _pid())).fetchone()
            if not h:
                raise ValueError("Версия не найдена")
            snap = json.loads(h[0])
            f = _clean_review({**snap, "status": snap.get("status") or "listened"})
            _write_review(conn, iid, f, reason="before-restore")
        out = refresh_outputs(conn, "restore")
    rev, hist = get_review(conn, iid, with_history=True)
    return {"item_id": iid, "review": rev, "history": hist, **out}


def delete_review(conn, iid):
    with _WRITE_LOCK:
        with _tx(conn):
            cur = get_review(conn, iid)
            if not cur:
                raise ValueError("Отзыв не найден")
            conn.execute("INSERT INTO review_history(profile_id,item_id,snapshot,saved_at,reason) "
                         "VALUES(?,?,?,?,'deleted')",
                         (_pid(), iid, json.dumps(_snapshot(cur), ensure_ascii=False), now_iso()))
            conn.execute("DELETE FROM reviews WHERE profile_id=? AND item_id=?", (_pid(), iid))
            conn.execute("DELETE FROM item_tags WHERE profile_id=? AND item_id=?", (_pid(), iid))
        out = refresh_outputs(conn, "delete")
