_cloud_cache = {}


def cloud_backup_dir():
    """Google Drive for desktop folder on Windows, if any (probed once, read-only)."""
    if TEST_MODE:
        return None
    if "dir" in _cloud_cache:
        return _cloud_cache["dir"]
    cands = [Path("/mnt/g/My Drive"), Path("/mnt/g/Мой диск"), Path("/mnt/g")]
    if _probe_dir("/mnt/c/Users"):
        users = [Path("/mnt/c/Users/Ihor")]
        with contextlib.suppress(Exception):
            users += [u for u in Path("/mnt/c/Users").iterdir()
                      if u.name not in ("Ihor", "Public", "Default", "Default User", "All Users")]
        for u in users:
            for pat in ("Google Drive*", "My Drive", "Мой диск"):
                with contextlib.suppress(Exception):
                    for g in sorted(u.glob(pat)):
                        cands += [g / "My Drive", g / "Мой диск", g]
    found = None
    for c in cands:
        if _probe_dir(c):
            found = c / "abook-backup"
            break
    _cloud_cache["dir"] = found
    return found


def _out_dir_ready():
    """OUT_DIR must exist or be creatable *inside an existing parent*: never create
    /mnt/d/... on the Linux root fs when D: isn't mounted."""
    if _probe_dir(OUT_DIR):
        return True
    if _probe_dir(OUT_DIR.parent):
        OUT_DIR.mkdir(exist_ok=True)
        return True
    raise OSError(f"{OUT_DIR} недоступен")


def _content_key(blob):
    """Snapshot identity without the `exported` timestamp (skip identical snapshots)."""
    try:
        d = json.loads(blob)
        d.pop("exported", None)
        return json.dumps(d, sort_keys=True, ensure_ascii=False)
    except Exception:
        return blob


_ALL_PROFILES_REASONS = {"sync", "startup", "rebuild", "get", "aidoc"}


def refresh_outputs(conn, reason=""):
    """Called after EVERY change (review save/delete/restore, queue, sync, questionnaire, AI run):
    regenerate the AI documents on D: atomically — of the current profile, or of every profile after
    a sync/startup/rebuild — write .reviews.json on D: (all profiles), the home copy, a timestamped
    snapshot, the daily DB snapshot and the cloud copy. D: failures never fail the save."""
    with _WRITE_LOCK:
        warnings = []
        cur = _pid()
        pids = _profile_ids(conn) if reason in _ALL_PROFILES_REASONS else [cur]
        if cur not in pids:
            pids.insert(0, cur)
        docs = {}
        for p in pids:
            with _profile_ctx(p):
                docs[p] = (build_aidoc(conn, lite=False), build_aidoc(conn, lite=True))
        full, lite = docs[cur]
        blob = json.dumps(AI.export_all(conn) if AI else export_reviews_obj(conn),
                          ensure_ascii=False, indent=2) + "\n"
        for p, (f_, l_) in docs.items():
            OUT_STATUS["aidoc_p"][p] = {m: {"chars": len(t), "bytes": len(t.encode("utf-8")),
                                            "tokens": int(len(t) / 3.5)} for m, t in (("full", f_), ("lite", l_))}
        OUT_STATUS["aidoc"] = OUT_STATUS["aidoc_p"][cur]
        try:
            _atomic_write_text(home_reviews_path(), blob)
            snapshots_dir().mkdir(parents=True, exist_ok=True)
            snaps = sorted(snapshots_dir().glob("reviews-*.json"))
            if not snaps or _content_key(snaps[-1].read_text(encoding="utf-8")) != _content_key(blob):
                stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")[:-3]
                _atomic_write_text(snapshots_dir() / f"reviews-{stamp}.json", blob)
            for old in sorted(snapshots_dir().glob("reviews-*.json"))[:-SNAPSHOT_KEEP]:
                old.unlink(missing_ok=True)
            OUT_STATUS["home_time"] = now_iso()
        except Exception as e:
            warnings.append(f"локальная копия не записана: {e}")
        try:
            db_backups_dir().mkdir(parents=True, exist_ok=True)
            day = db_backups_dir() / f"library-{datetime.now():%Y-%m-%d}.db"
            if not day.exists():
                conn.execute("VACUUM INTO ?", (str(day),))
                for old in sorted(db_backups_dir().glob("library-*.db"))[:-DB_BACKUP_KEEP]:
                    old.unlink(missing_ok=True)
        except Exception as e:
            warnings.append(f"снимок базы не сделан: {e}")
        try:
            _out_dir_ready()
            for p, (f_, l_) in docs.items():
                fn, ln = _aidoc_names(conn, p)
                _atomic_write_text(OUT_DIR / fn, f_, mkdir=False)
                _atomic_write_text(OUT_DIR / ln, l_, mkdir=False)
            _atomic_write_text(OUT_DIR / D_REVIEWS_NAME, blob, mkdir=False)
            with _profile_ctx(DEFAULT_PROFILE_ID):   # library.csv on D: = the default profile's view
                _atomic_write_text(OUT_DIR / LIBRARY_CSV_NAME, library_csv(conn), mkdir=False)
            OUT_STATUS.update(d_ok=True, d_time=now_iso(), d_error=None)
        except Exception as e:
            OUT_STATUS.update(d_ok=False, d_error=str(e))
            warnings.append(f"копия на D: не обновлена ({e}); повторю при следующем сохранении")
        cloud = cloud_backup_dir()
        if cloud:
            try:
                _atomic_write_text(cloud / "reviews.json", blob)
                if DEFAULT_PROFILE_ID in docs:
                    _atomic_write_text(cloud / AIDOC_NAME, docs[DEFAULT_PROFILE_ID][0])
                OUT_STATUS["cloud_time"] = now_iso()
            except Exception as e:
                warnings.append(f"облачная копия не записана: {e}")
        OUT_STATUS["warnings"] = warnings
        return {"warnings": warnings, "out": out_status(), "_full": full, "_lite": lite}


def out_status():
