def _age_ru(days):
    if days <= 0:
        return "сегодня"
    if days == 1:
        return "вчера"
    n = days % 100
    word = "дней" if 11 <= n <= 14 else {1: "день", 2: "дня", 3: "дня", 4: "дня"}.get(days % 10, "дней")
    return f"{days} {word} назад"


def _rev_date(r):
    return (r.get("finished") or (r.get("updated") or "")[:10])[:10]


def review_weights(revs, today=None):
    """Recency weight per review: 0.5^(age/half-life), floored; the newest N (non-«хочу»)
    reviews get at least RECENCY_RECENT_MIN. Age = today − finished (fallback: updated).
    Returns ({item_id: (weight, age_days)}, taste reviews newest-first)."""
    today = today or datetime.now().date()
    taste = sorted([r for r in revs if r["status"] != "want"],
                   key=lambda r: (_rev_date(r), r.get("updated") or "", r["item_id"]), reverse=True)
    rank = {r["item_id"]: i for i, r in enumerate(taste)}
    w = {}
    for r in revs:
        try:
            age = max(0, (today - datetime.strptime(_rev_date(r), "%Y-%m-%d").date()).days)
        except ValueError:
            age = 0
        x = max(RECENCY_FLOOR, 0.5 ** (age / RECENCY_HALF_LIFE_DAYS))
        if rank.get(r["item_id"], 10 ** 9) < RECENCY_RECENT_N:
            x = max(x, RECENCY_RECENT_MIN)
        w[r["item_id"]] = (round(x, 4), age)
    return w, taste


def _wmean(pairs):
    sw = sum(w for w, _ in pairs)
    return round(sum(w * v for w, v in pairs) / sw, 2) if sw else None


def compute_stats(conn, today=None):
    revs = _joined_reviews(conn)
    weights, taste = review_weights(revs, today)
    rated = [r for r in revs if isinstance(r["overall"], int)]
    by_status = {k: 0 for k in REVIEW_STATUSES}
    for r in revs:
        by_status[r["status"]] = by_status.get(r["status"], 0) + 1
    listened = [r for r in revs if r["status"] == "listened"]
    groups = {"section": {}, "author": {}, "narrator": {}}
    for r in rated:
        for g in groups:
            if r[g] and not (g == "section" and r[g] == OUTSIDE_SECTION):
                groups[g].setdefault(r[g], []).append((weights[r["item_id"]][0], r["overall"]))
    avg_by = {g: sorted(({"name": k, "avg": _mean([v for _, v in p]), "wavg": _wmean(p), "n": len(p)}
                         for k, p in d.items()), key=lambda x: (-x["avg"], -x["n"], x["name"]))
              for g, d in groups.items()}
    dist = [0] * 11
    for r in rated:
        dist[r["overall"]] += 1

    def brief(r):
        return {"item_id": r["item_id"], "author": r["author"], "title": r["title"],
                "overall": r["overall"], "status": r["status"]}

    top = [brief(r) for r in sorted(rated, key=lambda r: (-r["overall"], r["item_id"])) if r["overall"] >= 6][:10]
    bottom = [brief(r) for r in sorted(rated, key=lambda r: (r["overall"], r["item_id"])) if r["overall"] <= 5][:10]
    polarity = {r[0]: r[1] for r in conn.execute("SELECT tag, polarity FROM tags")}
    tagd = {}
    for r in revs:
        for t in r["tags"]:
            d = tagd.setdefault(t, {"tag": t, "n": 0, "ratings": [], "wr": [], "dropped": 0,
                                    "polarity": polarity.get(t, 0)})
            d["n"] += 1
            if isinstance(r["overall"], int):
                d["ratings"].append(r["overall"])
                d["wr"].append((weights[r["item_id"]][0], r["overall"]))
            if r["status"] == "dropped":
                d["dropped"] += 1
    tags = sorted(({"tag": d["tag"], "n": d["n"], "avg": _mean(d["ratings"]), "wavg": _wmean(d["wr"]),
                    "dropped": d["dropped"], "polarity": d["polarity"]} for d in tagd.values()),
                  key=lambda x: (-x["n"], x["tag"]))
    loved = sorted([t for t in tags if t["avg"] is not None and t["avg"] >= 7.5],
                   key=lambda x: (-x["avg"], -x["n"], x["tag"]))
    disliked = sorted([t for t in tags if (t["avg"] is not None and t["avg"] <= 4.5) or t["dropped"]
                       or (t["polarity"] < 0)], key=lambda x: (x["avg"] if x["avg"] is not None else 0, -x["n"], x["tag"]))
    loved_recent = sorted([t for t in tags if t["wavg"] is not None and t["wavg"] >= 7.5],
                          key=lambda x: (-x["wavg"], -x["n"], x["tag"]))
    disliked_recent = sorted([t for t in tags if t["wavg"] is not None and t["wavg"] <= 4.5],
                             key=lambda x: (x["wavg"], -x["n"], x["tag"]))
    focus = []
    for r in taste[:10]:
        wt, age = weights[r["item_id"]]
        focus.append({"item_id": r["item_id"], "author": r["author"], "title": r["title"],
                      "overall": r["overall"], "status": r["status"], "tags": r["tags"], "weight": wt,
                      "age": age, "age_ru": _age_ru(age), "date": _rev_date(r),
                      "gist": _one_line(r["text"])[:160]})
    drift = {"rising": [], "falling": []}
    for kind, rows in (("тег", tags), ("раздел", avg_by["section"]), ("автор", avg_by["author"])):
        for x in rows:
            if x["n"] >= 2 and x.get("wavg") is not None and x.get("avg") is not None:
                dlt = round(x["wavg"] - x["avg"], 2)
                name = x.get("tag") or x.get("name")
                if dlt >= 0.5:
                    drift["rising"].append({"kind": kind, "name": name, "avg": x["avg"], "wavg": x["wavg"], "delta": dlt})
                elif dlt <= -0.5:
                    drift["falling"].append({"kind": kind, "name": name, "avg": x["avg"], "wavg": x["wavg"], "delta": dlt})
    drift["rising"].sort(key=lambda x: (-x["delta"], x["kind"], x["name"]))
    drift["falling"].sort(key=lambda x: (x["delta"], x["kind"], x["name"]))
    subs = {k: {"label": lab, "avg": _mean([r["scores"][k] for r in revs if k in r["scores"]]),
                "n": sum(1 for r in revs if k in r["scores"])} for k, lab, _ in SUBSCORES}
    months = {}
    for r in listened:
        m = (r["finished"] or r["updated"] or "")[:7]
        if m:
            d = months.setdefault(m, {"month": m, "books": 0, "hours": 0.0})
            d["books"] += 1
            d["hours"] = round(d["hours"] + (r["hours"] or 0), 1)
    q = get_queue(conn)
    qh = sum(i["hours"] or 0 for i in get_items(conn, ids=q))
    return {"weights": {k: {"w": v[0], "age": v[1]} for k, v in sorted(weights.items())},
            "focus": focus, "drift": drift, "loved_recent": loved_recent, "disliked_recent": disliked_recent,
            "wavg": _wmean([(weights[r["item_id"]][0], r["overall"]) for r in rated]),
            "recency": {"half_life_days": RECENCY_HALF_LIFE_DAYS, "floor": RECENCY_FLOOR,
                        "recent_n": RECENCY_RECENT_N, "recent_min": RECENCY_RECENT_MIN},
            "count": len(revs), "rated": len(rated), "avg": _mean([r["overall"] for r in rated]),
            "by_status": by_status, "books_listened": len(listened),
            "hours_listened": round(sum(r["hours"] or 0 for r in listened), 1),
            "avg_by": avg_by, "dist": dist, "top": top, "bottom": bottom, "tags": tags,
            "loved_tags": loved, "disliked_tags": disliked, "subscores": subs,
            "months": [months[k] for k in sorted(months)], "queue": len(q), "queue_hours": round(qh, 1)}


def _has_table(conn, name):
    return bool(conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (name,)).fetchone())


def _cols(conn, table):
    return [r[1] for r in conn.execute(f"PRAGMA table_info({table})")]


def _jload(s, default=None):
    try:
        return json.loads(s) if s else default
    except Exception:
        return default


def _iso_age_h(s, now):
    """Hours since an ISO timestamp (naive == UTC); None when unparsable."""
    if not s:
        return None
    try:
        d = datetime.fromisoformat(str(s).replace("Z", "+00:00"))
        if d.tzinfo is None:
            d = d.replace(tzinfo=timezone.utc)
        return round((now - d).total_seconds() / 3600, 1)
    except Exception:
        return None


def _by_day(rows, key, days=30):
    """[{day, n}] for the last `days` calendar days (UTC), zeros included, from ISO timestamps rows[i][key]."""
    today = datetime.now(timezone.utc).date()
    cnt = {}
    for r in rows:
        d = (r.get(key) or "")[:10]
        if d:
            cnt[d] = cnt.get(d, 0) + 1
    out = []
    for i in range(days - 1, -1, -1):
        d = (today - timedelta(days=i)).isoformat()
        out.append({"day": d, "n": cnt.get(d, 0)})
    return out


def _listened_stats(revs, now):
    """«Прослушано» для «Статистики»: только отзывы со статусом listened/dropped/in_progress; часы — из карточки книги
    (items.hours), месяц — по finished (нет — по updated). Всё считается на стороне сервера, фронт только рисует."""
    def hrs(rows):
        return round(sum((r.get("hours") or 0) for r in rows), 1)

    def month_of(r):
        return ((r.get("finished") or r.get("updated") or "")[:7]) or None

    def top(rows, key, limit=8, split=False):
        acc = {}
        for r in rows:
            k = (r.get(key) or "").strip()
            if split and k:
                k = k.split("/")[0]
            if not k or k.startswith("не указан"):
                continue
            d = acc.setdefault(k, {"name": k, "n": 0, "h": 0.0, "scores": []})
            d["n"] += 1
            d["h"] = round(d["h"] + (r.get("hours") or 0), 1)
            if isinstance(r.get("overall"), int):
                d["scores"].append(r["overall"])
        out = []
        for d in sorted(acc.values(), key=lambda x: (-x["h"], -x["n"], x["name"]))[:limit]:
            out.append({"name": d["name"], "n": d["n"], "h": d["h"], "avg": _mean(d["scores"])})
        return out

    done = [r for r in revs if r.get("status") == "listened"]
    dropped = [r for r in revs if r.get("status") == "dropped"]
    cur = [r for r in revs if r.get("status") == "in_progress"]
    heard = done + dropped
    rated = [r for r in done if isinstance(r.get("overall"), int)]
    dist = [0] * 11
    for r in rated:
        dist[r["overall"]] += 1
    # by month: the last 12 months, every month present (empty ones too), books and hours
    months = []
    y, m = now.year, now.month
    for _ in range(12):
        months.append(f"{y:04d}-{m:02d}")
        m -= 1
        if m == 0:
            y, m = y - 1, 12
    months.reverse()
    by_m = {k: {"month": k, "n": 0, "h": 0.0, "scores": []} for k in months}
    for r in done:
        k = month_of(r)
        if k in by_m:
            by_m[k]["n"] += 1
            by_m[k]["h"] = round(by_m[k]["h"] + (r.get("hours") or 0), 1)
            if isinstance(r.get("overall"), int):
                by_m[k]["scores"].append(r["overall"])
    timeline = [{"month": k, "n": v["n"], "h": v["h"], "avg": _mean(v["scores"])} for k, v in by_m.items()]
    # pace: hours per week over the last 4 and 12 weeks (finished dates), and the first/last finished date
    def since(days):
        lim = (now - timedelta(days=days)).strftime("%Y-%m-%d")
        return [r for r in done if (r.get("finished") or r.get("updated") or "")[:10] >= lim]
    pace = {"h4w": round(hrs(since(28)) / 4, 1), "h12w": round(hrs(since(84)) / 12, 1), "n4w": len(since(28)), "n12w": len(since(84))}
    dates = sorted(d for d in ((r.get("finished") or "")[:10] for r in done) if d)
    span_days = None
    if len(dates) >= 2:
        try:
            span_days = (datetime.strptime(dates[-1], "%Y-%m-%d") - datetime.strptime(dates[0], "%Y-%m-%d")).days
        except ValueError:
            span_days = None
    best = sorted(rated, key=lambda r: (-r["overall"], -(r.get("hours") or 0)))[:5]
    relisten = sum(1 for r in done if r.get("relisten"))
    in_progress = []
    for r in sorted(cur, key=lambda r: r.get("updated") or "", reverse=True)[:6]:
        in_progress.append({"id": r.get("item_id"), "author": r.get("author", ""), "title": r.get("title", ""), "hours": r.get("hours"),
                            "stopped_at": r.get("stopped_at", ""), "started": r.get("started", ""), "updated": r.get("updated", "")})
    dropped_rows = []
    for r in sorted(dropped, key=lambda r: r.get("updated") or "", reverse=True)[:6]:
        dropped_rows.append({"id": r.get("item_id"), "author": r.get("author", ""), "title": r.get("title", ""), "hours": r.get("hours"),
                             "overall": r.get("overall"), "section": (r.get("section") or "").split("/")[0]})
    return {"books": len(done), "hours": hrs(done), "dropped": len(dropped), "dropped_hours": hrs(dropped),
            "in_progress": len(cur), "in_progress_hours": hrs(cur), "want": sum(1 for r in revs if r.get("status") == "want"),
            "finish_rate": round(len(done) / len(heard), 3) if heard else None, "relisten": relisten,
            "rated": len(rated), "avg": _mean([r["overall"] for r in rated]), "dist": dist,
            "median_hours": round(sorted(r.get("hours") or 0 for r in done)[len(done) // 2], 1) if done else None,
            "timeline": timeline, "pace": pace, "first": dates[0] if dates else None, "last": dates[-1] if dates else None,
            "span_days": span_days,
            "sections": top(done, "section", split=True), "authors": top(done, "author"), "narrators": top(done, "narrator", limit=6),
            "best": [{"id": r.get("item_id"), "author": r.get("author", ""), "title": r.get("title", ""), "overall": r["overall"],
                      "hours": r.get("hours"), "finished": r.get("finished", "")} for r in best],
            "cur": in_progress, "dropped_rows": dropped_rows}


def compute_stats_full(conn):
    """«Статистика» целиком: библиотека и каталог источников — глобально, вкус/советы/поиск/экономика ИИ — текущий
    профиль. Все таблицы, кроме items/files/reviews, могут отсутствовать — тогда раздел честно пустой."""
    pid = _pid()
    now = datetime.now(timezone.utc)
    week = (now - timedelta(days=7)).isoformat()
    q = lambda sql, args=(): [dict(r) for r in conn.execute(sql, args)]   # noqa: E731

    # ---- 1. library --------------------------------------------------------------------------------------------
    items = q("SELECT i.id, i.section, i.hours, i.narrator, i.lang, i.ai_voice, i.bucket, i.added, f.status AS fstatus, "
              "f.seconds FROM items i LEFT JOIN files f ON f.item_id=i.id WHERE i.in_library=1")
    done = [i for i in items if i["fstatus"] == "done"]
    hours = lambda rows: round(sum(r["hours"] or 0 for r in rows), 1)   # noqa: E731
    secs = sorted(set(i["section"].split("/")[0] for i in items if i["section"]))
    sections = sorted(({"name": s, "n": sum(1 for i in items if i["section"].split("/")[0] == s),
                        "h": hours([i for i in items if i["section"].split("/")[0] == s])} for s in secs),
                      key=lambda x: (-x["n"], x["name"]))
    lbins = [("до 1 ч", 0, 1), ("1–2 ч", 1, 2), ("2–5 ч", 2, 5), ("5–10 ч", 5, 10), ("10–20 ч", 10, 20), ("от 20 ч", 20, 1e9)]
    lengths = [{"name": lab, "n": sum(1 for i in items if i["hours"] is not None and lo <= i["hours"] < hi),
                "h": hours([i for i in items if i["hours"] is not None and lo <= i["hours"] < hi])} for lab, lo, hi in lbins]
    langs = {}
    for i in items:
        langs[i["lang"] or "—"] = langs.get(i["lang"] or "—", 0) + 1
    langs = sorted(({"name": k, "n": v} for k, v in langs.items()), key=lambda x: -x["n"])
    narr = {}
    for i in items:
        nm = i["narrator"].strip()
        if nm and not nm.startswith("не указан"):
            d = narr.setdefault(nm, {"name": nm, "n": 0, "h": 0.0})
            d["n"] += 1
            d["h"] = round(d["h"] + (i["hours"] or 0), 1)
    narrators = sorted(narr.values(), key=lambda x: (-x["n"], -x["h"], x["name"]))[:8]
    # «Проверка»: отчёты ~/abook/check-reports/<id>.json, вердикт в result.verdict, цена в timings.cost_usd
    chk_dir = Path(os.environ.get("ABOOK_CHECK_REPORTS") or ABOOK_DIR / "check-reports")
    verdicts, chk_calls = {}, []
    lib_ids = {i["id"] for i in items}
    if chk_dir.is_dir():
        for f in chk_dir.glob("*.json"):
            try:
                rep = json.loads(f.read_text(encoding="utf-8"))
            except Exception:
                continue
            v = ((rep.get("result") or {}).get("verdict")) or "cant_tell"
            if rep.get("id") in lib_ids:
                verdicts[v] = verdicts.get(v, 0) + 1
            tm = rep.get("timings") or {}
            c = float(tm.get("cost_usd") or sum(float(x.get("cost_usd") or 0) for x in rep.get("llm") or []))
            chk_calls.append({"at": rep.get("checked_at") or "", "cost": c, "sec": float(tm.get("total_sec") or 0), "chars": None})
    checked = sum(verdicts.values())
    complete = verdicts.get("complete", 0) + verdicts.get("probably_complete", 0)
    tg = None
    if TG is not None:
        try:
            s = TG.sent_summary()
            tg = {"books": s.get("books_done", 0), "started": s.get("started_books", 0), "volumes": s.get("volumes", 0),
                  "gb": round((s.get("bytes") or 0) / 1024 ** 3, 2), "configured": bool(TG.configured())}
        except Exception:
            tg = None
    library = {"books": len(items), "hours": hours(items), "downloaded": len(done), "downloaded_hours": hours(done),
               "failed": sum(1 for i in items if i["fstatus"] == "failed"), "sections": sections, "lengths": lengths,
               "langs": langs, "narrators": narrators, "ai_voice": sum(1 for i in items if i["ai_voice"]),
               "checked": {"n": checked, "complete": complete, "verdicts": verdicts}, "tg": tg}

    # ---- 2. taste (profile) -------------------------------------------------------------------------------------
    revs = _joined_reviews(conn)
    rated = [r for r in revs if isinstance(r["overall"], int)]
    dist = [0] * 11
    for r in rated:
        dist[r["overall"]] += 1
    months = {}
    for r in rated:
        m = (r["finished"] or r["updated"] or "")[:7]
        if m:
            months.setdefault(m, []).append(r["overall"])
    timeline = [{"month": m, "n": len(v), "avg": _mean(v)} for m, v in sorted(months.items())]
    prof = conn.execute("SELECT id, name, is_default FROM profiles WHERE id=?", (pid,)).fetchone()
    ai = None
    if _has_table(conn, "ai_runs"):
        r = conn.execute("SELECT started, model, kind, result FROM ai_runs WHERE profile_id=? AND status='done' AND "
                         "kind IN ('initial','refresh') ORDER BY id DESC LIMIT 1", (pid,)).fetchone()
        if r:
            p = (_jload(r["result"], {}) or {}).get("profile") or {}
            ai = {"loves": [str(x) for x in p.get("loves") or []][:10], "avoid": [str(x) for x in p.get("avoid") or []][:10],
                  "at": r["started"], "model": r["model"], "kind": r["kind"],
                  "runs": conn.execute("SELECT COUNT(*) FROM ai_runs WHERE profile_id=? AND status='done'", (pid,)).fetchone()[0]}
    fb = {"like": 0, "dislike": 0, "read": 0}
    if _has_table(conn, "rec_feedback"):
        for r in conn.execute("SELECT verdict, COUNT(*) n FROM rec_feedback WHERE profile_id=? GROUP BY verdict", (pid,)):
            if r["verdict"] in fb:
                fb[r["verdict"]] = r["n"]
    feats, feat_total = [], 0
    if _has_table(conn, "book_features"):
        feat_total = conn.execute("SELECT COUNT(*) FROM book_features").fetchone()[0]
        score = {r["item_id"]: r["overall"] for r in rated}
        acc = {}
        for r in conn.execute("SELECT item_id, features FROM book_features"):
            if r["item_id"] not in score:
                continue
            f = _jload(r["features"], {}) or {}
            for key in ("themes", "ideas", "motifs", "tone", "genre"):
                vals = f.get(key)
                for v in (vals if isinstance(vals, list) else [vals] if vals else []):
                    v = str(v).strip().lower()
                    if v:
                        acc.setdefault(v, []).append(score[r["item_id"]])
        feats = sorted(({"name": k, "n": len(v), "avg": _mean(v)} for k, v in acc.items() if len(v) >= 2),
                       key=lambda x: (-x["avg"], -x["n"]))[:10]
    # память консультанта: факты по видам и по источнику; журнал mem_events (когда появится) — активность по дням
    memory = {"n": 0, "kinds": [], "sources": {"user": 0, "auto": 0}, "events": None, "events_n": 0}
    if _has_table(conn, "consultant_memory"):
        memory["n"] = conn.execute("SELECT COUNT(*) FROM consultant_memory WHERE profile_id=?", (pid,)).fetchone()[0]
        memory["kinds"] = q("SELECT kind AS name, COUNT(*) n FROM consultant_memory WHERE profile_id=? GROUP BY kind ORDER BY n DESC", (pid,))
        for r in conn.execute("SELECT source, COUNT(*) n FROM consultant_memory WHERE profile_id=? GROUP BY source", (pid,)):
            memory["sources"][r["source"] if r["source"] == "user" else "auto"] = \
                memory["sources"].get(r["source"] if r["source"] == "user" else "auto", 0) + r["n"]
    if _has_table(conn, "mem_events"):
        cols = _cols(conn, "mem_events")
        tcol = next((c for c in ("created", "at", "ts", "time") if c in cols), None)
        kcol = next((c for c in ("kind", "event", "action", "type") if c in cols), None)
        if tcol:
            where, args = ("WHERE profile_id=?", (pid,)) if "profile_id" in cols else ("", ())
            rows = q(f"SELECT {tcol} AS at{', ' + kcol + ' AS kind' if kcol else ''} FROM mem_events {where}", args)
            memory["events_n"] = len(rows)
            memory["events"] = _by_day(rows, "at")
            if kcol:
                kinds = {}
                for r in rows:
                    kinds[r["kind"]] = kinds.get(r["kind"], 0) + 1
                memory["event_kinds"] = sorted(({"name": k, "n": v} for k, v in kinds.items()), key=lambda x: -x["n"])
    # ---- 2b. listened (profile): what was actually heard — books and hours, by month, scores, sections, authors,
    #      narrators, finished vs dropped, the pace and what is in progress. reviews × items; dates = finished/started.
    listened = _listened_stats(revs, now)
    taste = {"profile": dict(prof) if prof else {"id": pid, "name": "—", "is_default": 0},
             "profiles": conn.execute("SELECT COUNT(*) FROM profiles").fetchone()[0],
             "reviews": len(revs), "rated": len(rated), "avg": _mean([r["overall"] for r in rated]), "dist": dist,
             "timeline": timeline, "ai": ai, "feedback": fb, "features": feats, "features_total": feat_total, "memory": memory,
             "listened": listened}

    # ---- 3. catalog (global) ------------------------------------------------------------------------------------
    catalog = {"total": 0, "sources": [], "works": 0, "works_public": 0, "crawls": [], "reports": [], "reports_n": 0,
               "members": 0, "downloadable": 0, "fetched": []}
    if _has_table(conn, "src_items"):
        src = q("SELECT src, platform, COUNT(*) n, SUM(downloadable) dl, SUM(availability='members') members "
                "FROM src_items GROUP BY src, platform ORDER BY n DESC")
        catalog["sources"] = [{"name": s["src"].replace("manifest:", ""), "platform": s["platform"], "n": s["n"],
                               "dl": s["dl"] or 0, "members": s["members"] or 0} for s in src]
        catalog["total"] = sum(s["n"] for s in src)
        catalog["members"] = sum(s["members"] or 0 for s in src)
        catalog["downloadable"] = sum(s["dl"] or 0 for s in src)
        since = (now - timedelta(days=30)).isoformat()
        day = {r["d"]: r["n"] for r in q("SELECT substr(fetched_at,1,10) d, COUNT(*) n FROM src_items WHERE fetched_at>=? GROUP BY d", (since,))}
        catalog["fetched"] = [{"day": x["day"], "n": day.get(x["day"], 0)} for x in _by_day([], "at")]
    if _has_table(conn, "works"):
        w = conn.execute("SELECT COUNT(*), SUM(n_public>0) FROM works").fetchone()
        catalog["works"], catalog["works_public"] = w[0], w[1] or 0
    if _has_table(conn, "src_crawls"):
        for r in q("SELECT source, fetched_at, n, members, error FROM src_crawls WHERE source NOT LIKE '\\_%' ESCAPE '\\' "
                   "ORDER BY fetched_at DESC"):
            catalog["crawls"].append({"source": r["source"].replace("manifest:", ""), "at": r["fetched_at"], "n": r["n"] or 0,
                                      "members": r["members"] or 0, "error": r["error"], "age_h": _iso_age_h(r["fetched_at"], now)})
    if _has_table(conn, "source_reports"):
        catalog["reports"] = q("SELECT reason AS name, COUNT(*) n FROM source_reports GROUP BY reason ORDER BY n DESC")
        catalog["reports_n"] = sum(r["n"] for r in catalog["reports"])

    # ---- 4. advice & search (profile) + AI economics ------------------------------------------------------------
    calls = {"chat": [], "find": [], "profile": [], "plus1": [], "check": chk_calls}   # {at, cost, sec, chars}
    budget = {}
    advice = {"sessions": 0, "asked": 0, "advices": 0, "feedback": fb, "actions": {}, "actions_n": 0, "downloaded": 0,
              "searches": {"n": 0, "done": 0, "failed": 0, "avg_sec": None, "auto": 0}, "chat_avg_sec": None}
    if _has_table(conn, "chat_sessions") and _has_table(conn, "chat_messages"):
        advice["sessions"] = conn.execute("SELECT COUNT(*) FROM chat_sessions WHERE profile_id=?", (pid,)).fetchone()[0]
        for r in q("SELECT m.role, m.created, m.meta FROM chat_messages m JOIN chat_sessions s ON s.id=m.session_id "
                   "WHERE s.profile_id=? AND m.status='done' ORDER BY m.id", (pid,)):
            if r["role"] == "user":
                advice["asked"] += 1
                continue
            advice["advices"] += 1
            m = _jload(r["meta"], {}) or {}
            calls["chat"].append({"at": r["created"] or "", "cost": float(m.get("cost_usd") or 0),
                                  "sec": float(m.get("seconds") or 0), "chars": m.get("prompt_chars")})
            b = m.get("budget")
            if isinstance(b, dict):
                for k, v in b.items():
                    if isinstance(v, (int, float)):
                        budget[k] = budget.get(k, 0) + v
    if _has_table(conn, "find_searches"):
        for r in q("SELECT status, started, meta, auto FROM find_searches WHERE profile_id=?", (pid,)):
            advice["searches"]["n"] += 1
            advice["searches"]["auto"] += 1 if r["auto"] else 0
            if r["status"] == "done":
                advice["searches"]["done"] += 1
            elif r["status"] in ("error", "failed"):
                advice["searches"]["failed"] += 1
            m = _jload(r["meta"], {}) or {}
            calls["find"].append({"at": r["started"] or "", "cost": float(m.get("cost_usd") or 0),
                                  "sec": float(m.get("seconds") or 0), "chars": None})
    if _has_table(conn, "ai_runs"):
        for r in q("SELECT kind, started, cost_usd, duration_sec, prompt_chars FROM ai_runs WHERE profile_id=? AND status='done'", (pid,)):
            calls["plus1" if r["kind"] == "plus1" else "profile"].append(
                {"at": r["started"] or "", "cost": float(r["cost_usd"] or 0), "sec": float(r["duration_sec"] or 0), "chars": r["prompt_chars"]})
    if _has_table(conn, "rec_actions"):
        for r in q("SELECT state, COUNT(*) n FROM rec_actions WHERE profile_id=? GROUP BY state", (pid,)):
            advice["actions"][r["state"]] = r["n"]
        advice["actions_n"] = sum(advice["actions"].values())
        advice["downloaded"] = conn.execute(
            "SELECT COUNT(*) FROM rec_actions a JOIN files f ON f.item_id=a.item_id AND f.status='done' WHERE a.profile_id=?",
            (pid,)).fetchone()[0]
    secs_ = [c["sec"] for c in calls["chat"] if c["sec"]]
    advice["chat_avg_sec"] = round(sum(secs_) / len(secs_), 1) if secs_ else None
    secs_ = [c["sec"] for c in calls["find"] if c["sec"]]
    advice["searches"]["avg_sec"] = round(sum(secs_) / len(secs_)) if secs_ else None
    labels = {"chat": "ответ консультанта", "find": "поиск книги", "profile": "профиль вкуса", "plus1": "+1 по запросу",
              "check": "проверка книги"}
    kinds, cost = [], {"all": {}, "week": {}}
    for k, rows in calls.items():
        n = len(rows)
        tot = sum(c["cost"] for c in rows)
        cost["all"][k] = round(tot, 2)
        cost["week"][k] = round(sum(c["cost"] for c in rows if c["at"] >= week), 2)
        chars = [c["chars"] for c in rows if c["chars"]]
        kinds.append({"kind": k, "label": labels[k], "n": n, "cost": round(tot, 2), "avg_cost": round(tot / n, 3) if n else None,
                      "avg_sec": round(sum(c["sec"] for c in rows) / n, 1) if n else None,
                      "avg_chars": round(sum(chars) / len(chars)) if chars else None})
    for k in cost:
        cost[k]["total"] = round(sum(cost[k].values()), 2)
    series = sorted(calls["chat"], key=lambda c: c["at"])[-40:]
    advice["cost"] = cost
    advice["ai"] = {"kinds": kinds, "chat_series": series,
                    "budget": sorted(({"name": k, "chars": v} for k, v in budget.items()), key=lambda x: -x["chars"])}
    return {"library": library, "taste": taste, "catalog": catalog, "advice": advice, "generated": now.isoformat()}


