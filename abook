  for(const k of ['halo','mist','near','flare','plane','far','waves','ring','beam'])w.style.setProperty('--bh-'+k,c[k].toFixed(3));
  const a=SC.api;if(!a||!a.ok)return;a.readTokens();
  const v=Math.min(1,c.v+scrollDim());a.setScroll(v);w.classList.toggle('past',v>=.999);
