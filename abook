def export_reviews_obj(conn):
    revs = all_reviews(conn, with_history=True)
    items = {i["id"]: i for i in get_items(conn, ids=sorted(set(revs) | set(get_queue(conn))))}
    orphan_hist = {}
    for h in conn.execute("SELECT * FROM review_history WHERE profile_id=? AND item_id NOT IN "
                          "(SELECT item_id FROM reviews WHERE profile_id=?) ORDER BY id DESC", (_pid(), _pid())):
        orphan_hist.setdefault(h["item_id"], []).append({"saved_at": h["saved_at"], "reason": h["reason"],
                                                         **json.loads(h["snapshot"])})
    out = []
    for iid in sorted(revs, key=lambda k: (revs[k]["updated"], k), reverse=True):
        it = items.get(iid, {})
        out.append({"item_id": iid, "author": it.get("author"), "title": it.get("title"),
                    "section": it.get("section"), **revs[iid]})
    custom = [dict(r) for r in conn.execute(
        "SELECT id,author,title,section,source FROM items WHERE source IN ('custom') ORDER BY id")]
    return {"format": "abook-reviews", "version": 2, "exported": now_iso(), "reviews": out,
            "queue": get_queue(conn), "custom_items": custom, "deleted_or_old_versions": orphan_hist,
