            "status": r["status"], "stopped_at": r["stopped_at"], "started": r["started"],
            "finished": r["finished"], "quote": r["quote"], "relisten": bool(r["relisten"]),
            "text": r["text"], "created": r["created"], "updated": r["updated"], "tags": tags}


def _tags_map(conn):
    m = {}
    for r in conn.execute("SELECT item_id, tag FROM item_tags WHERE profile_id=? ORDER BY rowid", (_pid(),)):
        m.setdefault(r[0], []).append(r[1])
    return m


def get_review(conn, iid, with_history=False):
    r = conn.execute("SELECT * FROM reviews WHERE profile_id=? AND item_id=?", (_pid(), iid)).fetchone()
