_VERIFY_JOB = {"running": False, "mode": None, "phase": None, "done": 0, "total": 0, "current": "",
               "started": None, "error": None}
_VERIFY_LOCK = threading.Lock()


def _verify_last():
    try:
        return json.loads(verify_last_path().read_text(encoding="utf-8"))
    except Exception:
        return None


def verify_start(mode):
    """Run verify_library() in a background thread (read-only: never --fix). One at a time."""
    with _VERIFY_LOCK:
        if _VERIFY_JOB["running"]:
            return False
        _VERIFY_JOB.update(running=True, mode=mode, phase="files", done=0, total=0, current="",
                           started=now_iso(), error=None)

    def prog(**k):
        with _VERIFY_LOCK:
            _VERIFY_JOB.update({x: k[x] for x in ("phase", "done", "total", "current") if x in k})

    def run():
        try:
            verify_library(full=(mode == "full"), fix=False, net=True, progress=prog)
        except Exception as e:
            with _VERIFY_LOCK:
                _VERIFY_JOB["error"] = f"{type(e).__name__}: {e}"
        finally:
            with _VERIFY_LOCK:
                _VERIFY_JOB["running"] = False

    threading.Thread(target=run, daemon=True, name="abook-verify").start()
    return True


def _verify_payload():
    with _VERIFY_LOCK:
        job = dict(_VERIFY_JOB)
    return {"job": job, "last": _verify_last()}


def open_item_dir(iid):
    """Explorer on an item's folder (file selected if it exists). Paths come from state.json only."""
    v = (read_state_ro().get("items") or {}).get(iid) or {}
    fp = v.get("final_path") or v.get("quarantined_path")
    if not fp:
        raise ValueError("Путь неизвестен")
    p = Path(fp)
    explorer = shutil.which("explorer.exe") or "/mnt/c/Windows/explorer.exe"
    if p.exists():
        cmd = [explorer, f"/select,{_win_path(p) or p}"]
    else:
        d = p.parent
        while not d.exists() and d != d.parent:
            d = d.parent
        cmd = [explorer, _win_path(d) or str(d)]
    subprocess.Popen(cmd, cwd="/mnt/c" if Path("/mnt/c").is_dir() else None, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {"cmd": cmd}


class _ReviewHandler(BaseHTTPRequestHandler):
    server_version = "abook-review/3"
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *a):
        pass

    def _send(self, code, body, ctype, extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        extra = dict(extra or {})
        self.send_header("Cache-Control", extra.pop("Cache-Control", "no-store"))
        for k, v in extra.items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj, ensure_ascii=False, default=str), "application/json; charset=utf-8")

    def _attach(self, body, ctype, name_utf8, name_ascii):
        disp = f"attachment; filename=\"{name_ascii}\"; filename*=UTF-8''{_urlquote(name_utf8)}"
        self._send(200, body, ctype, {"Content-Disposition": disp})

    def _host_ok(self):
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
        return host in ("127.0.0.1", "localhost", "[::1]")

    def _conn(self):
        conn = db_connect()
        _PROFILE.id = _resolve_profile(conn, self.headers.get("X-Abook-Profile")
                                       or (parse_qs(urlparse(self.path).query).get("profile") or [""])[0])
        with contextlib.suppress(Exception):
            sync_if_stale(conn)
        return conn

    def do_GET(self):
        if not self._host_ok():
            return self._json({"error": "bad host"}, 403)
        u = urlparse(self.path)
        qs = parse_qs(u.query)
        arg = lambda k, d="": (qs.get(k) or [d])[0]  # noqa: E731
        if u.path in ("/", "/index.html"):
            return self._send(200, _review_html(), "text/html; charset=utf-8")
        if u.path == "/favicon.ico":
            return self._send(200, FAVICON_SVG, "image/svg+xml")
        if u.path.startswith("/kit/"):   # cosmos-kit: fonts, tokens, components, scene (kit/ next to this script)
            target = (KIT_DIR / unquote(u.path[len("/kit/"):])).resolve()
            if KIT_DIR in target.parents and target.is_file() and target.suffix.lower() in KIT_TYPES:
                return self._send(200, target.read_bytes(), KIT_TYPES[target.suffix.lower()],
                                  {"Cache-Control": "public, max-age=3600"})
            return self._json({"error": "не найдено"}, 404)
        conn = None
        try:
            conn = self._conn()
            p = u.path
            if p == "/api/meta":
                return self._json(_meta_payload(conn))
            if p == "/api/search":
                t0 = time.perf_counter()
                ids = search_ids(conn, arg("q"))
                res = get_items(conn, ids=ids)
                return self._json({"results": res, "ms": round((time.perf_counter() - t0) * 1000, 1)})
            if p == "/api/similar":
                return self._json({"items": similar_items(conn, arg("author"), arg("title"))})
            if p == "/api/item":
                d = _item_payload(conn, arg("id"))
                return self._json(d) if d else self._json({"error": "не найдено"}, 404)
            if p == "/api/reviews":
                return self._json({"reviews": sorted(_joined_reviews(conn), key=lambda r: r["updated"], reverse=True)})
            if p == "/api/queue":
                return self._json({"queue": get_items(conn, ids=get_queue(conn))})
            if p == "/api/stats/full":
                return self._json(compute_stats_full(conn))
            if p == "/api/stats":
                return self._json(compute_stats(conn))
            if p == "/api/recommend":
                return self._json(recommend(conn, limit=int(arg("limit", "10") or 10)))
            if p == "/api/library":
                where = None if arg("all") == "1" else "i.in_library=1"
                return self._json({"items": get_items(conn, where=where)})
            if p == "/api/backups":
                return self._json(backups_info(_aidoc_names(conn, _pid())))
            if p == "/api/verify":
                return self._json(_verify_payload())
            day = datetime.now().strftime("%Y-%m-%d")
            if p == "/api/aidoc":
                lite = arg("mode") == "lite"
                out = refresh_outputs(conn, "download")   # regenerate now + refresh D:
                text = out["_lite" if lite else "_full"]
                if arg("inline") == "1":
                    return self._send(200, text, "text/markdown; charset=utf-8",
                                      {"X-Abook-Warnings": _urlquote("; ".join(out["warnings"]))})
                base = _aidoc_names(conn, _pid())[1 if lite else 0][:-3]
                return self._attach(text, "text/markdown; charset=utf-8", f"{base}_{day}.md",
                                    f"BIBLIOTEKA_DLYA_II{base[len('БИБЛИОТЕКА_ДЛЯ_ИИ'):]}_{day}.md")
            if p == "/api/export/reviews.json":
                return self._attach(json.dumps(export_reviews_obj(conn), ensure_ascii=False, indent=2),
                                    "application/json; charset=utf-8", f"отзывы_{day}.json", f"reviews_{day}.json")
            if p == "/api/export/reviews.csv":
                return self._attach(reviews_csv(conn), "text/csv; charset=utf-8", f"отзывы_{day}.csv", f"reviews_{day}.csv")
            if p == "/api/export/library.csv":
                return self._attach(library_csv(conn), "text/csv; charset=utf-8", f"библиотека_{day}.csv", f"library_{day}.csv")
            if p == "/api/tg/status":
                return self._json(TG.job_status() if TG else {"available": False})
            if FIND and (p.startswith("/api/find/") or p in ("/api/llm", "/api/setup", "/api/sync")):
                return FIND.handle_get(self, conn, p, arg)
            if AI and p.startswith(("/api/profiles", "/api/questionnaire", "/api/ai/")):
                return AI.handle_get(self, conn, p, arg)
            return self._json({"error": "not found"}, 404)
        except Exception as ex:
            return self._json({"error": str(ex)}, 500)
        finally:
            if conn:
                conn.close()

    def do_POST(self):
        if not self._host_ok():
            return self._json({"error": "bad host"}, 403)
        # JSON-only: a cross-site form can't send this content type without a CORS preflight
        if not (self.headers.get("Content-Type") or "").startswith("application/json"):
            return self._json({"error": "нужен application/json"}, 415)
        conn = None
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > 1_000_000:
                return self._json({"error": "слишком большой запрос"}, 413)
            payload = json.loads(self.rfile.read(n).decode("utf-8") or "{}")
            conn = self._conn()
            p = urlparse(self.path).path

            def clean(d):
                return {k: v for k, v in d.items() if not k.startswith("_")}

            if p == "/api/review":
                res = clean(save_review(conn, payload))
                with contextlib.suppress(Exception):     # журнал памяти профиля (abook_memory)
                    import abook_memory as _MEM
                    it = (get_items(conn, ids=[res.get("item_id")]) or [{}])[0]
                    _MEM.log_event(conn, _pid(), "отзыв", f"{it.get('author') or payload.get('author') or ''} — «{it.get('title') or payload.get('title') or ''}»: "
                                   f"{payload.get('status') or ''}" + (f", оценка {payload.get('overall')}/10" if payload.get("overall") not in (None, "") else ""))
                return self._json(res)
            if p == "/api/review/delete":
                return self._json(clean(delete_review(conn, str(payload.get("item_id") or ""))))
            if p == "/api/review/restore":
                return self._json(clean(restore_review(conn, str(payload.get("item_id") or ""),
                                                       int(payload.get("history_id") or 0))))
            if p == "/api/queue":
                return self._json(clean(queue_op(conn, payload)))
            if p == "/api/rebuild":
                with _WRITE_LOCK:
                    res = sync_db(conn, force=True)
                    out = refresh_outputs(conn, "rebuild")
                return self._json({"sync": res, **clean(out)})
            if p == "/api/verify":
                mode = "full" if payload.get("mode") == "full" else "quick"
                if not verify_start(mode):
                    return self._json({"error": "проверка уже идёт"}, 409)
                return self._json({"ok": True, "mode": mode})
            if p == "/api/open-dir":
                return self._json({"ok": True, **open_item_dir(str(payload.get("item_id") or ""))})
            if p == "/api/open":
                rows = conn.execute("SELECT path_wsl, path_win FROM files WHERE item_id=? AND status='done'",
                                    (str(payload.get("item_id") or ""),)).fetchone()
                if not rows:
                    raise ValueError("Файл ещё не скачан")
                what = "folder" if payload.get("what") == "folder" else "file"
                return self._json({"ok": True, **open_in_windows(dict(rows), what, bool(payload.get("dry")))})
            if p == "/api/tg/send":
                if not TG:
                    return self._json({"error": "abook_tg недоступен"}, 500)
                return self._json(TG.start_send(str(payload.get("item_id") or ""), force=bool(payload.get("force")),
                                                 skip_check=bool(payload.get("skip_check"))))
            if p == "/api/tg/remove":
                if not TG:
                    return self._json({"error": "abook_tg недоступен"}, 500)
                return self._json(TG.remove(str(payload.get("item_id") or "")))
            if p == "/api/tg/queue":
                if not TG:
                    return self._json({"error": "abook_tg недоступен"}, 500)
                return self._json(TG.start_queue(int(payload.get("n") or 3),
                                                  str(payload.get("profile") or "Основной"),
                                                  force=bool(payload.get("force"))))
            if p == "/api/tg/cancel":
                if not TG:
                    return self._json({"error": "abook_tg недоступен"}, 500)
                return self._json(TG.cancel())
            if p == "/api/tg/quality":
                if not TG:
                    return self._json({"error": "abook_tg недоступен"}, 500)
                return self._json(TG.set_quality(str(payload.get("quality") or "")))
            if FIND and (p.startswith("/api/find/") or p in ("/api/llm", "/api/setup", "/api/sync")):
                return FIND.handle_post(self, conn, p, payload)
            if AI and p.startswith(("/api/profiles", "/api/questionnaire", "/api/ai/")):
                return AI.handle_post(self, conn, p, payload)
            return self._json({"error": "not found"}, 404)
        except ValueError as ex:
            return self._json({"error": str(ex)}, 400)
        except Exception as ex:
            return self._json({"error": str(ex)}, 500)
        finally:
            if conn:
                conn.close()


def _open_browser(url):
    cwd = "/mnt/c" if Path("/mnt/c").is_dir() else None  # cmd.exe dislikes a UNC cwd
    cands = []
    if shutil.which("wslview"):
        cands.append(["wslview", url])
    cmd_exe = shutil.which("cmd.exe") or "/mnt/c/Windows/System32/cmd.exe"
    if Path(cmd_exe).exists():
        cands.append([cmd_exe, "/c", "start", "", url])
    explorer = shutil.which("explorer.exe") or "/mnt/c/Windows/explorer.exe"
    if Path(explorer).exists():
        cands.append([explorer, url])
    for c in cands:
        try:
            r = subprocess.run(c, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=10)
            if r.returncode == 0 or c[0] == explorer:  # explorer.exe exits 1 even on success
                return True
        except Exception:
            continue
    return False


_HTML_CACHE = {}


def _review_html():
    if "html" not in _HTML_CACHE:
        html = REVIEW_HTML
        if AI:
            html = AI.inject_html(html)
        else:   # without the module: drop the markers and the AI tab
            for m in ("/*AI:CSS*/", "<!--AI:RAIL-->", "<!--AI:VIEWS-->", "/*AI:JS*/"):
                html = html.replace(m, "")
        if FIND:
            html = FIND.inject_html(html)
        else:   # без модуля — без вкладки «Найти»
            for m in ("/*FIND:CSS*/", "<!--FIND:NAV-->", "<!--FIND:VIEWS-->", "/*FIND:JS*/"):
                html = html.replace(m, "")
        try:   # мастер «Настройка» первого запуска (abook_setup_ui.py)
            import abook_setup_ui as _SU
            html = _SU.inject(html)
        except ImportError:
            pass
        try:   # cache-bust the kit entry files (served with max-age): the stamp is the newest mtime under kit/css and kit/js
            stamp = str(int(max(f.stat().st_mtime for d in ("css", "js", "fonts") for f in (KIT_DIR / d).glob("*.*"))))
        except (OSError, ValueError):
            stamp = "0"
        html = html.replace("?kitv", "?v=" + stamp)
        _HTML_CACHE["html"] = html
    return _HTML_CACHE["html"]


def cmd_review(args):
    _configure_db_paths(args)
    conn = db_connect()
    res = sync_db(conn, force=True)
    if AI:
        AI.startup(conn)
    fstart = None
    if FIND:
        try:
            fstart = FIND.startup(conn)   # таблицы вкладки «Найти» (с копией базы перед миграцией), очередь загрузок
            with contextlib.suppress(Exception):   # профили между компьютерами (abook_sync.py), в фоне
                import abook_sync as _SY
                _SY.start_background()
            def _vec_warm():   # смысловой поиск: модель в память и досчёт векторов каталога заранее, не на первом запросе
                with contextlib.suppress(Exception):
                    import abook_vec as _V
                    c2 = db_connect()
                    try:
                        _V.call(c2, "embed", texts=["прогрев"], query=True)
                        _V.ensure_sync(c2)
                    finally:
                        c2.close()
            threading.Thread(target=_vec_warm, daemon=True, name="abook-vec-warm").start()
        except Exception as ex:
            print(f"  WARN «Найти»: {ex}", file=sys.stderr)
    _review_html()   # fail at startup, not on the first page load
    out = refresh_outputs(conn, "startup")
    conn.close()
    if not TEST_MODE:
        write_launcher()
    httpd = None
    for port in range(args.port, args.port + 20):
        try:
            httpd = ThreadingHTTPServer(("127.0.0.1", port), _ReviewHandler)  # bind = the port check
            break
        except OSError:
            continue
    if httpd is None:
        print(f"Нет свободного порта в диапазоне {args.port}–{args.port + 19}", file=sys.stderr)
        sys.exit(1)
    httpd.daemon_threads = True
    url = f"http://127.0.0.1:{httpd.server_address[1]}/"
    b = backups_info()
    print(f"Аудиотека: {url}")
    print(f"  база:   {DB_PATH}  (в библиотеке {res['in_library']}, скачано {res['downloaded']})")
    print(f"  для ИИ: {OUT_DIR / AIDOC_NAME}  (D: {'OK' if out['out']['d_ok'] else 'НЕ ОБНОВЛЁН'})")
    print(f"  бэкапы: {home_reviews_path()} · {OUT_DIR / D_REVIEWS_NAME} · {snapshots_dir()} · {db_backups_dir()}")
    print(f"  {b['cloud_note']}")
    for w in out["warnings"]:
        print(f"  WARN {w}")
    if fstart and fstart.get("backup"):
        print(f"  «Найти»: новые таблицы, копия базы до миграции — {fstart['backup']}")
    if fstart and fstart.get("resumed"):
        print(f"  «Найти»: очередь загрузок — {fstart['resumed']} книг(и), продолжаю")
    if TG:
        try:
            n_tg = TG.resume()   # TG-очередь с прошлого запуска (~/abook/tg-queue.json)
            if n_tg:
                print(f"  TG-очередь: {n_tg} книг(и) ждут отправки — продолжаю")
        except Exception as ex:
            print(f"  WARN TG-очередь: {ex}")
    print("Остановить: Ctrl+C", flush=True)
    if not args.no_browser:
        threading.Thread(target=_open_browser, args=(url,), daemon=True).start()
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nОстановлено.")
    finally:
        httpd.server_close()


