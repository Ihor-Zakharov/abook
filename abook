    return {"item_id": iid, "review": rev, "history": hist, **out}


def queue_op(conn, payload):
    op = payload.get("op")
    with _WRITE_LOCK:
        with _tx(conn):
            iid = str(payload.get("item_id") or "")
            if op == "add":
                if not conn.execute("SELECT 1 FROM items WHERE id=?", (iid,)).fetchone():
                    raise ValueError("Нет такой позиции")
                _queue_add(conn, iid)
            elif op == "remove":
                conn.execute("DELETE FROM queue WHERE profile_id=? AND item_id=?", (_pid(), iid))
            elif op == "order":
                cur = get_queue(conn)
                order = [k for k in (payload.get("order") or []) if k in cur]
                order = list(dict.fromkeys(order + [k for k in cur if k not in order]))
                conn.executemany("UPDATE queue SET position=? WHERE profile_id=? AND item_id=?",
                                 [(i + 1, _pid(), k) for i, k in enumerate(order)])
            else:
                raise ValueError("Неизвестная операция очереди")
        out = refresh_outputs(conn, "queue")
    return {"queue": get_queue(conn), **out}


