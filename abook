def cmd_get(args):
    items = merge_manifest_items(args.manifests)
    only = set(args.only) if args.only else None
    engine = getattr(args, "engine", None) or DEFAULT_ENGINE

    # One-time snapshot to decide what to run. Actual status changes during the
    # run go through state_update_item()/state_replace_item(), which re-read
    # fresh under a lock, so this snapshot is only used for item *selection*.
    snapshot = load_state()
    todo = []
    for item in items:
        iid = item["id"]
        if only and iid not in only:
            continue
        cur = snapshot["items"].get(iid)
        if cur:
            status = cur.get("status")
            if status == "done":
                log(f"[{iid}] skip (already done -> {cur.get('final_path')})")
                continue
            if status == "failed" and not args.retry_failed:
                log(f"[{iid}] skip (previously failed: {cur.get('error')}; use --retry-failed)")
                continue
            if status == "in_progress":
                log(f"[{iid}] was left 'in_progress' by an earlier interrupted run; "
                    f"treating as pending and reprocessing")
        todo.append(item)

    if args.dry_run:
        for item in todo:
            process_item(item, dry_run=True, bitrate=args.bitrate, engine=engine)
        return

    if not todo:
        log("nothing to do")
        return

    cleanup_stale_parts()
    state_backup()
    stop_backups = threading.Event()

    def backup_loop():
        while not stop_backups.wait(STATE_BACKUP_EVERY):
            state_backup()
    threading.Thread(target=backup_loop, daemon=True).start()

    jobs = max(1, args.jobs)
    low_disk_hit = threading.Event()

    def worker(item):
        if low_disk_hit.is_set():
            log(f"[{item['id']}] skip (batch halted: low disk space)")
            return
        try:
            process_item(item, dry_run=False, bitrate=args.bitrate, engine=engine)
        except LowDiskSpace as e:
            low_disk_hit.set()
            log(str(e))
        except Exception as e:   # never let one item take the whole batch down
            log(f"[{item['id']}] ERROR (unexpected): {type(e).__name__}: {e}")
            with contextlib.suppress(Exception):
                state_update_item(item["id"], status="failed", error=f"{type(e).__name__}: {e}", updated=now_iso())

    if jobs == 1 and threading.current_thread() is threading.main_thread():
        # один поток: SIGTERM (отмена из веб-интерфейса) помечает текущую книгу failed «отменено» и чистит staging
        signal.signal(signal.SIGTERM, _on_sigterm)
    log(f"processing {len(todo)} item(s) with --jobs {jobs}, engine {engine}, bitrate {args.bitrate} kbps")

    try:
        if jobs == 1:
            for item in todo:
                if low_disk_hit.is_set():
                    break
                worker(item)
        else:
            with ThreadPoolExecutor(max_workers=jobs) as ex:
                futures = [ex.submit(worker, item) for item in todo]
                for f in as_completed(futures):
                    f.result()
    finally:
        stop_backups.set()
        state_backup()

    if engine == "vydra":
        rescan_library()
    if not (getattr(args, "state", None) or os.environ.get("ABOOK_STATE")):
        post_get_refresh()   # library.db + БИБЛИОТЕКА_ДЛЯ_ИИ.md reflect the new downloads


def cmd_status(args):
    state = load_state()
    items_state = dict(state.get("items", {}))

    universe = {}  # id -> merged view
    for iid, v in items_state.items():
        universe[iid] = dict(v)
        universe[iid]["id"] = iid

    if args.manifests:
        for it in merge_manifest_items(args.manifests):
            iid = it["id"]
            if iid not in universe:
                universe[iid] = {
                    "id": iid, "status": "pending",
                    "section": it.get("section", ""), "author": it.get("author", ""),
                    "title": it.get("title", ""), "duration_sec": None,
                    "duration_h_manifest": it.get("duration_h"),
                }

    rows = list(universe.values())
    rows.sort(key=lambda r: (r.get("status", ""), r.get("section", ""), r.get("id", "")))

    fmt = "{:22.22} {:11.11} {:14.14} {:18.18} {:28.28} {:>8}"
    print(fmt.format("ID", "STATUS", "SECTION", "AUTHOR", "TITLE", "HOURS"))
    done_hours = done_gb = 0.0
    n_done = n_failed = n_pending = 0
    for r in rows:
        status = r.get("status", "pending")
        dur = r.get("duration_sec")
        if dur:
            hours_str = f"{dur / 3600:.2f}"
        elif r.get("duration_h_manifest"):
            hours_str = f"~{r['duration_h_manifest']:.1f}"
        else:
            hours_str = "-"
        print(fmt.format(r.get("id", ""), status, r.get("section", ""),
                          r.get("author", ""), r.get("title", ""), hours_str))
        if status == "done":
            n_done += 1
            done_hours += (dur or 0) / 3600
            done_gb += (r.get("size_bytes") or 0) / 1024**3
        elif status == "failed":
            n_failed += 1
        else:
            n_pending += 1

    print()
    print(f"done={n_done}  failed={n_failed}  pending={n_pending}   "
          f"total done: {done_hours:.2f} h, {done_gb:.2f} GB")


