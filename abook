def _node_bin():
    n = shutil.which("node")
    if n:
        return n
    cands = sorted((HOME / ".nvm/versions/node").glob("v*/bin/node"))
    return str(cands[-1]) if cands else None


def _ytdlp_run(args, work_dir, timeout):
    """Run yt-dlp with a private copy of the cookies (yt-dlp rewrites its cookie file on exit,
    so parallel jobs must never share one). Returns (CompletedProcess | None, error | None)."""
    work_dir = Path(work_dir)
    work_dir.mkdir(parents=True, exist_ok=True)
    cmd = [YTDLP_BIN, "--ignore-config", "--no-progress", "--socket-timeout", "30",
           "--retries", "10", "--fragment-retries", "10", "--extractor-retries", "3",
           "--ffmpeg-location", str(Path(FFMPEG_BIN).parent)]
    node = _node_bin()
    if node:
        cmd += ["--js-runtimes", f"node:{node}"]
    ck = None
    try:
        if COOKIES_PATH.is_file() and COOKIES_PATH.stat().st_size > 0:
            ck = work_dir / f".cookies-{os.getpid()}-{threading.get_ident()}.txt"
            shutil.copyfile(COOKIES_PATH, ck)
            os.chmod(ck, 0o600)
            cmd += ["--cookies", str(ck)]
        try:
            proc = subprocess.run(cmd + list(args), capture_output=True, text=True, timeout=timeout,
                                  cwd=str(work_dir), stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return None, f"yt-dlp timed out after {timeout}s"
        return proc, None
    finally:
        if ck:
            with contextlib.suppress(OSError):
                ck.unlink()


def _ytdlp_error(proc):
    errs = [l for l in (proc.stderr or "").splitlines() if "ERROR" in l]
    return (errs[-1] if errs else (proc.stderr or "").strip()[-500:]) or f"yt-dlp exit {proc.returncode}"


def is_playlist_url(url):
    p = urlparse(url)
    host = p.netloc.lower()
    q = parse_qs(p.query)
    if "youtube.com" in host or "youtu.be" in host:
        return p.path.rstrip("/") == "/playlist" or ("list" in q and "v" not in q and "youtu.be" not in host)
    return bool(re.search(r"/(?:playlist|plst|album|audio_playlist)s?(?:/|$|\b)|/details/", p.path))


_UNAVAILABLE_TITLE = re.compile(r"^\[(?:private|deleted|unavailable)[^\]]*\]$", re.I)


def ytdlp_list_playlist(url, work_dir, bitrate=None):
    """Flat listing of a playlist, in playlist order. {"ok", "playlist", "entries": [...]}"""
    proc, err = _ytdlp_run(["--flat-playlist", "--yes-playlist", "-J", url], work_dir, PLAYLIST_TIMEOUT)
    if err:
        return {"ok": False, "error": err}
    if proc.returncode != 0:
        return {"ok": False, "error": _ytdlp_error(proc)}
    try:
        info = json.loads(proc.stdout)
    except Exception as e:
        return {"ok": False, "error": f"bad JSON from yt-dlp: {e}"}
    if info.get("_type") != "playlist":
        return {"ok": True, "playlist": False, "info": info}
    entries = []
    for pos, e in enumerate(info.get("entries") or [], 1):
        e = e or {}
        u = e.get("url") or e.get("webpage_url")
        if u and not u.startswith("http") and e.get("ie_key") == "Youtube":
            u = f"https://www.youtube.com/watch?v={e.get('id') or u}"
        title = e.get("title") or ""
        entries.append({"playlist_index": pos, "id": e.get("id"), "url": u, "title": title,
                        "duration": e.get("duration"),
                        "unavailable": (not u) or bool(_UNAVAILABLE_TITLE.match(title.strip()))
                        or e.get("availability") in ("private", "needs_auth", "subscriber_only")})
    return {"ok": True, "playlist": True, "title": info.get("title"), "entries": entries,
            "playlist_count": info.get("playlist_count")}


_PERMANENT_ERR = re.compile(r"HTTP Error 404|HTTP Error 410|Video unavailable|video has been removed|"
                            r"Private video|This video is private|does not exist|account .* terminated", re.I)

YTDLP_PRINT = ("after_move:%(.{id,title,ext,acodec,duration,webpage_url,original_url,filepath,"
               "extractor_key})j")


def run_ytdlp_download(url, out_dir, bitrate=DEFAULT_BITRATE, stem="part"):
    """One video's best audio (m4a preferred), no re-encoding. {"ok", "info": {...}}"""
    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    for old in out_dir.glob(stem + ".*"):   # finished leftovers of a failed attempt (keep .part for resume)
        if not old.name.endswith((".part", ".ytdl")):
            with contextlib.suppress(OSError):
                old.unlink()
    args = ["--no-playlist", "-f", "bestaudio[ext=m4a]/bestaudio/best", "-N", "4", "--no-mtime",
            "-o", str(out_dir / f"{stem}.%(ext)s"), "--print", YTDLP_PRINT, "--no-simulate", url]
    if "reasd.org/" in url.split("?")[0]:
        args[:0] = ["--referer", "https://4read.org/"]   # файлы 4read.org (каталог): без Referer — 403
    proc, err = _ytdlp_run(args, out_dir, DOWNLOAD_TIMEOUT)
    if err:
        return {"ok": False, "error": err}
    info = None
    for line in reversed(proc.stdout.splitlines()):
        if line.startswith("{"):
            try:
                info = json.loads(line)
                break
            except Exception:
                continue
    if proc.returncode != 0 or not info or not info.get("filepath") or not Path(info["filepath"]).is_file():
        msg = _ytdlp_error(proc) if proc.returncode != 0 else "yt-dlp: no file produced"
        return {"ok": False, "error": msg, "permanent": bool(_PERMANENT_ERR.search(msg))}
    return {"ok": True, "info": info}


