// processes: one energy for all; the ring breathes once only when the last one finishes — starts are silent (ambient tempo)
const PROC=new Map();
function procSet(id,p){PROC.set(id,p);sceneLive();paintProcs()}
function procEnd(id,ok){if(!PROC.delete(id))return;sceneLive();paintProcs()}   // no ring pulse: the one scene animation is the swell on save
function sceneLive(){sceneWake();if(SC.swT)return;SC.api?.setEnergy(PROC.size?1:0);Reel.energy(PROC.size?1:0);smoke()}
// a finished event (a saved review): not a jolt but a swell — the disc spins up over ≈1.2 s and coasts down for seconds,
// plus a soft push; k 0.5–2 sets how long it stays awake. Visible on the star next to the card. Reduced motion: nothing.
function kick(k){sceneWake();const a=SC.api;if(!a||!a.ok||REDUCED)return;clearTimeout(SC.swT);a.setEnergy(1);Reel.energy(1);a.spin?.(Math.min(1,k*.5));Reel.kick(k*.5);
  SC.swT=setTimeout(()=>{SC.swT=0;sceneLive()},900+k*700)}
function paintProcs(){const box=$('#procs');box.hidden=!PROC.size;const seen=new Set();
  for(const [id,p] of PROC){seen.add(id);let r=box.querySelector(`[data-proc="${id}"]`);
    if(!r){r=el('div','proc');r.dataset.proc=id;r.innerHTML='<div class="pl"><i class="live-dot"></i><span></span><b></b></div><div class="meter"><div class="meter-fill"></div><div class="meter-glow"></div></div>';box.appendChild(r);enter(r,{dy:8,blur:4,scale:1,response:.5})}
    r.dataset.accent=p.accent||'white';r.querySelector('span').textContent=p.label;r.querySelector('b').textContent=p.pct!=null?Math.round(p.pct*100)+'%':'';
    const m=r.querySelector('.meter');m.classList.toggle('indet',p.pct==null);m.style.setProperty('--p',p.pct==null?1:p.pct)}
  box.querySelectorAll('[data-proc]').forEach(r=>{if(!seen.has(r.dataset.proc))r.remove()})}
// the brand reel: same flywheel as the scene (energy τ 1.2 s, kick in ≈ 0.2 s, coast τ 1.4 s); still when nothing happens
const Reel={el:$('#reel'),a:0,e:0,eT:0,v:0,k:0,raf:0,last:0,
  energy(x){this.eT=x;this.go()},kick(x){if(REDUCED)return;this.k=Math.min(2.5,this.k+x);this.go()},
  go(){if(REDUCED||this.raf)return;this.last=performance.now();this.raf=requestAnimationFrame(t=>this.step(t))},
  step(now){this.raf=0;const dt=Math.min(.05,(now-this.last)/1000);this.last=now;
    this.e+=(this.eT-this.e)*Math.min(1,dt/1.2);if(!this.eT&&this.e<.002)this.e=0;
    const dk=this.k*Math.min(1,dt/.18);this.k=this.k-dk<1e-4?0:this.k-dk;this.v=this.v*Math.exp(-dt/1.4)+dk*1.3;if(this.v<1e-3&&!this.k)this.v=0;
    this.a=(this.a+(120*this.e+300*this.v)*dt)%360;this.el.style.transform=`rotate(${this.a.toFixed(2)}deg)`;
    if(this.e||this.eT||this.v||this.k)this.go()}};
