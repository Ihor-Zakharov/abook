    wa, wt, wn = (26, 60, 26) if not lite else (22, 40, 0)
    L += ["# §5 CATALOG (в библиотеке; группы = разделы, внутри по автору и названию)",
          "строка: id|автор|название|К/Д|ч|" + ("чтец|" if wn else "") + "яз|ИИ|ст|фмт|оц|отзыв "
          "(фмт = mp3|m4a — формат файла)", ""]
    by_sec = {}
    for i in lib:
        by_sec.setdefault(i["section"], []).append(i)
    for sec in sorted(by_sec):
        rows = by_sec[sec]
        L.append(f"## {sec} ({len(rows)}, ≈{sum(x['hours'] or 0 for x in rows):.0f} ч)")
        for i in rows:
            r = revs.get(i["id"])
            L.append("|".join([
                i["id"], cell(i["author"], wa), cell(i["title"], wt),
                {"short": "К", "long": "Д"}.get(i["bucket"], "?"), _h(i["hours"], i["hours_exact"])]
                + ([cell(i["narrator"], wn)] if wn else [])
                + [i["lang"] or "?", "+" if i["ai_voice"] else "", DL_MARK[i["status"]], i["fmt"],
                   "" if not r or r["overall"] is None else str(r["overall"]),
                   REVIEW_STATUS_SHORT[r["status"]] if r else ("в очереди" if i["id"] in queue else "")]))
        L.append("")
    L += [f"## §5b OUTSIDE (вне библиотеки: {len(own)})", "строка: id|автор|название|год|формат|оц|отзыв|заметка"]
    for i in own:
        r = revs.get(i["id"])
        L.append("|".join([i["id"], cell(i["author"], 30), cell(i["title"], 60), cell(i["year"], 10),
                           cell(i["format"], 12), "" if not r or r["overall"] is None else str(r["overall"]),
                           REVIEW_STATUS_SHORT[r["status"]] if r else "", cell(i["note"], 90)]))
    L.append("")
    if not lite and outside:
        L += [f"## §5c КАНДИДАТЫ ({len(outside)}; найдены составителем, но не скачивались)",
              "строка: id|автор|название|раздел|ч"]
        for i in outside:
            L.append("|".join([i["id"], cell(i["author"], 26), cell(i["title"], 50), cell(i["section"], 24),
                               _h(i["hours"], False)]))
        L.append("")

    # §6 NOTES
    if not lite:
        L += ["# §6 NOTES (строка: [id] о чём || почему подобрано; под ней — суть отзыва, если есть)"]
        for sec in sorted(notes):
            L.append(f"раздел «{sec}»: {_one_line(notes[sec])}")
        L.append("")
        for i in lib:
            L.append(f"[{i['id']}] {cell(i['about'], 200) or '—'} || {cell(i['why'], 150) or '—'}")
            r = revs.get(i["id"])
            if r:
                gist = _one_line(r["text"])[:220]
                L.append(f"  отзыв: {'' if r['overall'] is None else str(r['overall']) + '/10 '}"
                         f"{REVIEW_STATUSES[r['status']]}" + (f" · {', '.join(r['tags'])}" if r["tags"] else "")
                         + (f" — {gist}" if gist else ""))
        L.append("")

    # §7 INDEX
    L += ["# §7 INDEX"]
    idx_author, idx_section, idx_tag = {}, {}, {}
    for i in lib:
        idx_author.setdefault(i["author"] or "?", []).append(i["id"])
        idx_section.setdefault(i["section"], []).append(i["id"])
    for k, r in sorted(revs.items()):
        for t in r["tags"]:
            idx_tag.setdefault(t, []).append(k)
    for a in sorted(idx_author):
        if len(idx_author[a]) >= (2 if not lite else 3):
            L.append(f"автор:{a} → {', '.join(idx_author[a])}")
    for t in sorted(idx_tag):
        L.append(f"тег:{t} → {', '.join(idx_tag[t])}")
    short = [i["id"] for i in lib if i["bucket"] == "short"]
    L.append(f"К (до 2 ч) → {', '.join(short) or '—'}")
    L.append(f"К+скачано → {', '.join(i['id'] for i in lib if i['bucket'] == 'short' and i['status'] == 'done') or '—'}")
    L.append(f"ИИ-озвучка → {', '.join(i['id'] for i in lib if i['ai_voice']) or '—'}")
    for lang in ("uk", "en"):
        ids = [i["id"] for i in lib if i["lang"] == lang]
        if ids:
            L.append(f"язык:{lang} → {', '.join(ids)}")
    for sl in start_lists:
        if sl["start_here"]:
            L.append(f"start_here:{sl['manifest']} → {', '.join(sl['start_here'])}")
        if sl["top_ids"] and not lite:
            L.append(f"top:{sl['manifest']} → {', '.join(sl['top_ids'])}")
    L.append("")

    # §8 PATHS
    if not lite:
        L += ["# §8 PATHS (id → файл в Windows)"]
        for i in lib:
            if i["path_win"]:
                L.append(f"{i['id']} → {i['path_win']}")
        L.append("")
    return "\n".join(L)


def write_launcher():
    distro = os.environ.get("WSL_DISTRO_NAME", "")
    d = f"-d {distro} " if distro and re.fullmatch(r"[\w.-]+", distro) else ""
    bat = ("@echo off\r\n"
           "chcp 65001 >nul\r\n"
           "title Аудиотека - отзывы\r\n"
           "echo Запуск... Закройте это окно или нажмите Ctrl+C, чтобы остановить.\r\n"
           f"wsl.exe {d}-e bash -lc \"~/.local/bin/abook review\"\r\n"
           "if errorlevel 1 pause\r\n")
    try:
        if LAUNCHER_PATH.exists() and LAUNCHER_PATH.read_bytes() == bat.encode("utf-8"):
            return
        LAUNCHER_PATH.write_bytes(bat.encode("utf-8"))
    except Exception as e:
        log(f"WARN: не удалось записать {LAUNCHER_PATH}: {e}")


def _configure_db_paths(args):
    """--db / $ABOOK_DB selects an isolated DB; then all outputs go next to it unless --out-dir."""
    global DB_PATH, OUT_DIR, TEST_MODE
    dbp = getattr(args, "db", None) or os.environ.get("ABOOK_DB")
    if dbp:
        DB_PATH = Path(dbp).expanduser().resolve()
        TEST_MODE = True
        OUT_DIR = DB_PATH.parent / "out"
    od = getattr(args, "out_dir", None) or os.environ.get("ABOOK_OUT_DIR")
    if od:
        OUT_DIR = Path(od).expanduser().resolve()
    if TEST_MODE and not od:
        OUT_DIR.mkdir(parents=True, exist_ok=True)


def cmd_sync(args):
    _configure_db_paths(args)
    conn = db_connect()
    res = sync_db(conn, force=True)
    out = refresh_outputs(conn, "sync")
    print(f"sync: {DB_PATH}  items={res['items']} in_library={res['in_library']} "
          f"downloaded={res['downloaded']} stale={res['stale']} ({res['ms']} ms)")
    for e in res["manifest_errors"]:
