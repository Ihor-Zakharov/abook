const SC={api:null,wrap:$('#cosmos-wrap'),comp:null,cur:null,from:null,to:null,score:null,rs:0,
  k:new Spring({response:1.2,damping:.85,epsilon:.0004})};   // Apple-like: a confident start, a long soft landing, a hint of settle
const phone=()=>innerWidth<=760;
// home and the open card: «hero» (the star on the right, live); every other screen: «side» (centre, dark). An open card that would
// cover the star on a narrow window goes dark as well. The search overlay changes nothing here — no move for it.
// the review card stands on the datum and grows up to the star's ring, never over it (560–1180px); from 840px — two columns
// (1920×1080 — ≈ 870px, two columns; 2560×1080 ultrawide — 1180px)
const ringLeft=()=>{const railW=$('.rail').offsetWidth,vw=innerWidth;return railW+COMPS.hero.x*(vw-railW)-COMPS.hero.r*innerHeight};
