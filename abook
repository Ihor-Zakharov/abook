def _fw(s, n):
    s = _one_line(s)
    return (s[:n - 1] + "…") if len(s) > n else s.ljust(n)


def _h(v, exact=True):
    if v is None:
        return "?"
    return (f"{v:.1f}" if exact else f"~{v:.1f}")


def _dshort(d):
    return d[2:] if d else ""   # 2026-10-12 -> 26-10-12


def build_aidoc(conn, lite=False):
