def run_vydra_download(url, out_dir, bitrate=DEFAULT_BITRATE):
    cmd = [VYDRA_BIN, "d", url, "-f", "mp3", "-b", str(bitrate), "-o", str(out_dir),
           "-y", "--yes-playlist", "--json"]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=DOWNLOAD_TIMEOUT)
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": f"vydra timed out after {DOWNLOAD_TIMEOUT}s"}
    lines = [l for l in proc.stdout.splitlines() if l.strip()]
    if not lines:
        return {"ok": False, "error": f"vydra produced no JSON (exit {proc.returncode}): "
                                       f"{proc.stderr.strip()[-500:]}"}
    try:
        data = json.loads(lines[-1])
    except Exception as e:
        return {"ok": False, "error": f"bad JSON from vydra (exit {proc.returncode}, {e}): "
                                       f"{lines[-1][:500]}"}
    if not data.get("ok"):
        if not data.get("error"):
            job_errors = [j.get("error") for j in (data.get("jobs") or []) if j.get("error")]
            if job_errors:
                data["error"] = "; ".join(job_errors)
            else:
                data["error"] = f"vydra exit {proc.returncode}: {proc.stderr.strip()[-500:]}"
    return data


def download_url_with_retry(url, out_dir, bitrate=DEFAULT_BITRATE, runner=None):
    """runner(url, out_dir, bitrate=...) -> {"ok": bool, "error": str, ...}; default: vydra."""
    runner = runner or run_vydra_download
    last_err = None
    for attempt in range(RETRY_ATTEMPTS):
        result = runner(url, out_dir, bitrate=bitrate)
        if result.get("ok"):
            return result, None
        last_err = result.get("error") or "unknown error"
        log(f"    attempt {attempt + 1}/{RETRY_ATTEMPTS} failed: {last_err}")
        if result.get("permanent"):
            break
        if attempt < RETRY_ATTEMPTS - 1:
            if is_bot_check_error(last_err):
                delay = random.uniform(*BOT_CHECK_BACKOFF_RANGE)
                log(f"    looks like a YouTube bot-check; backing off "
                    f"{delay / 60:.1f} min before retrying instead of a quick retry")
            else:
                delay = RETRY_DELAYS[attempt]
            time.sleep(delay)
    return None, last_err


