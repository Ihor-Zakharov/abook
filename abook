def _write_ffmeta(parts, durations, item, meta_path):
    title = item.get("title") or item["id"]
    author = item.get("author") or ""
    narrator = item.get("narrator") or ""
    meta_lines = [";FFMETADATA1", f"title={ffmeta_escape(title)}"]
    if author:
        meta_lines.append(f"artist={ffmeta_escape(author)}")
    meta_lines.append(f"album={ffmeta_escape(title)}")
    meta_lines.append("genre=Audiobook")
    if narrator:
        meta_lines.append(f"comment={ffmeta_escape(narrator)}")
    if len(parts) > 1:
        start_ms = 0
        for p, d in zip(parts, durations):
            end_ms = start_ms + int(round(d * 1000))
            meta_lines += ["[CHAPTER]", "TIMEBASE=1/1000", f"START={start_ms}",
                           f"END={end_ms}", f"title={ffmeta_escape(p['title'])}"]
            start_ms = end_ms
    meta_path.write_text("\n".join(meta_lines) + "\n", encoding="utf-8")


def _write_concat_list(parts, path):
    lines = []
    for p in parts:
        resolved = str(Path(p["path"]).resolve()).replace("'", "'\\''")
        lines.append(f"file '{resolved}'")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def build_merged(parts, durations, item, out_path):
    """MP3 (vydra engine). parts: list of {'path','title'}; durations: matching list of seconds."""
    stage_dir = out_path.parent
    meta_path = stage_dir / "chapters.ffmeta"
    _write_ffmeta(parts, durations, item, meta_path)
    multi = len(parts) > 1

    # best-effort cover art from the first part, if it has an embedded image stream
    cover_path = None
    try:
        if has_video_stream(parts[0]["path"]):
            candidate = stage_dir / "cover.jpg"
            cmd = [FFMPEG_BIN, "-y", "-i", parts[0]["path"], "-an", "-c:v", "copy",
                   "-frames:v", "1", str(candidate)]
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=FFPROBE_TIMEOUT)
            if proc.returncode == 0 and candidate.exists() and candidate.stat().st_size > 0:
                cover_path = candidate
    except Exception as e:
        log(f"  (no cover art extracted: {e})")
        cover_path = None

    if multi:
        concat_path = stage_dir / "concat_list.txt"
        _write_concat_list(parts, concat_path)
        cmd = [FFMPEG_BIN, "-y", "-f", "concat", "-safe", "0", "-i", str(concat_path),
               "-i", str(meta_path)]
    else:
        cmd = [FFMPEG_BIN, "-y", "-i", parts[0]["path"], "-i", str(meta_path)]

    map_args = ["-map_metadata", "1", "-map", "0:a"]
    if cover_path:
        cmd += ["-i", str(cover_path)]
        map_args += ["-map", "2", "-c:v", "copy", "-disposition:v", "attached_pic"]
    cmd += map_args + ["-c:a", "copy", "-id3v2_version", "3", "-write_id3v1", "1", str(out_path)]

    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=FFMPEG_TIMEOUT)
    if proc.returncode != 0:
        raise RuntimeError(f"ffmpeg failed: {proc.stderr.strip()[-1500:]}")


def build_merged_m4a(parts, durations, item, out_path):
    """AAC parts → one .m4a: concat demuxer, stream copy, chapters + tags from FFMETADATA, faststart."""
    stage_dir = out_path.parent
    meta_path = stage_dir / "chapters.ffmeta"
    _write_ffmeta(parts, durations, item, meta_path)
    concat_path = stage_dir / "concat_list.txt"
    _write_concat_list(parts, concat_path)
    cmd = [FFMPEG_BIN, "-y", "-nostdin", "-v", "error", "-f", "concat", "-safe", "0", "-i", str(concat_path),
           "-i", str(meta_path), "-map", "0:a", "-map_metadata", "1", "-map_chapters", "1",
           "-c", "copy", "-movflags", "+faststart", str(out_path)]
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=FFMPEG_TIMEOUT)
    if proc.returncode != 0:
        raise RuntimeError(f"ffmpeg failed: {proc.stderr.strip()[-1500:]}")


def harmonise_aac(parts, bitrate):
    """Keep AAC-in-MP4 parts as they are; transcode everything else (opus/webm, mp3…) to AAC with
    the sample rate / channels of the first native AAC part, so `-c copy` concat is valid."""
    def native(p):
        a = p.get("_audio") or {}
        return a.get("codec_name") == "aac" and Path(p["path"]).suffix.lower() in (".m4a", ".mp4")
    nat = [p for p in parts if native(p)]
    if nat:
        sr = int(nat[0]["_audio"].get("sample_rate") or 44100)
        ch = int(nat[0]["_audio"].get("channels") or 2)
    else:
        sr = 44100
        ch = min(2, max(int((p.get("_audio") or {}).get("channels") or 2) for p in parts))
    for i, p in enumerate(parts, 1):
        a = p.get("_audio") or {}
        if native(p) and int(a.get("sample_rate") or 0) == sr and int(a.get("channels") or 0) == ch:
            continue
        src = Path(p["path"])
        out = src.with_name(src.stem + ".aac.m4a")
        cmd = [FFMPEG_BIN, "-y", "-nostdin", "-v", "error", "-i", str(src), "-vn", "-map", "0:a:0",
               "-map_metadata", "-1", "-c:a", "aac", "-b:a", f"{bitrate}k", "-ar", str(sr), "-ac", str(ch),
               "-movflags", "+faststart", str(out)]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=FFMPEG_TIMEOUT)
        if proc.returncode != 0:
            raise ItemFailed(f"перекодирование части #{i} в AAC не удалось: {proc.stderr.strip()[-300:]}")
        pr = probe_media(out)
        p.update(path=str(out), transcoded_from=a.get("codec_name"), duration=pr["duration"], _audio=pr["audio"])


def harmonise_mp3(parts, bitrate):
    """vydra keeps each source's sample rate; MP3 frames with different rates/channels can't be
    stream-copied into one file. Re-encode the odd parts to the first part's parameters."""
    a0 = parts[0].get("_audio") or {}
    sr, ch = int(a0.get("sample_rate") or 44100), int(a0.get("channels") or 2)
    for i, p in enumerate(parts, 1):
        a = p.get("_audio") or {}
        if a.get("codec_name") == "mp3" and int(a.get("sample_rate") or 0) == sr and int(a.get("channels") or 0) == ch:
            continue
        src = Path(p["path"])
        out = src.with_name(src.stem + f".{sr}.mp3")
        cmd = [FFMPEG_BIN, "-y", "-nostdin", "-v", "error", "-i", str(src), "-vn", "-map", "0:a:0",
               "-c:a", "libmp3lame", "-b:a", f"{bitrate}k", "-ar", str(sr), "-ac", str(ch), str(out)]
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=FFMPEG_TIMEOUT)
        if proc.returncode != 0:
            raise ItemFailed(f"перекодирование части #{i} ({a.get('sample_rate')} Гц) не удалось: "
                             f"{proc.stderr.strip()[-300:]}")
        pr = probe_media(out)
        p.update(path=str(out), transcoded_from=f"{a.get('codec_name')}@{a.get('sample_rate')}",
                 duration=pr["duration"], _audio=pr["audio"])


