def _manifest_sources():
    paths = sorted(MANIFESTS_DIR.glob("*.json"))
    if F_TOP_PATH.exists():
        paths.append(F_TOP_PATH)
    return paths


def _sources_signature():
    sig = []
    for p in _manifest_sources() + [STATE_PATH, BRIEF_PATH]:
        try:
            st = p.stat()
            sig.append(f"{p}:{st.st_mtime_ns}:{st.st_size}")
        except OSError:
            sig.append(f"{p}:-")
    return hashlib.sha1("\n".join(sig).encode()).hexdigest()


def sync_db(conn, force=False):
    """Idempotently import manifests/*.json (+ F-buldakov-top.json) and state.json (read-only)
    into the DB. Returns a summary dict, or None when nothing changed since the last sync."""
    sig = _sources_signature()
    if not force and _meta_get(conn, "sources_sig") == sig:
        return None
    t0 = time.time()
    items, notes, start_lists, errors, ok_sources = {}, {}, [], [], set()
    for p in _manifest_sources():
        name = p.stem if p.parent == MANIFESTS_DIR else p.stem + "(top)"
        try:
            m = json.loads(p.read_text(encoding="utf-8"))
        except Exception as e:   # a manifest may be half-written right now: keep its old rows
            errors.append({"manifest": name, "error": str(e)[:200]})
            continue
        if isinstance(m, list):
            m = {"items": m}
        if not isinstance(m, dict):
            continue
        ok_sources.add(name)
        is_f_full = p.parent == MANIFESTS_DIR and p.stem == F_FULL_STEM
        top = {x for x in (m.get("top_ids") or []) if isinstance(x, str)}
        for k, v in (m.get("section_notes") or {}).items():
            if isinstance(v, str):
                notes.setdefault(k, v)
        sh = [x for x in (m.get("start_here") or []) if isinstance(x, str)]
        if sh or top:
            start_lists.append({"manifest": name, "start_here": sh,
                                "top_ids": [x for x in (m.get("top_ids") or []) if isinstance(x, str)]})
        for it in m.get("items") or []:
            if not isinstance(it, dict) or not it.get("id"):
                continue
            inlib = 0 if (is_f_full and it["id"] not in top) else 1
            prev = items.get(it["id"])
            d = dict(it, _src=name, _inlib=max(inlib, prev["_inlib"] if prev else 0))
            if prev and not is_f_full:
                d["_src"] = name
            elif prev:
                d = dict(prev, _inlib=d["_inlib"])
            items[it["id"]] = d
    st_items = read_state_ro().get("items", {}) or {}
    start_ids = set()
    for s in start_lists:
        start_ids.update(s["start_here"])
        start_ids.update(s["top_ids"])
    now = now_iso()
    rows, file_rows = [], []
    for iid in sorted(set(items) | {k for k, v in st_items.items() if isinstance(v, dict)}):
        # только в state.json (нет ни в одном манифесте): в библиотеке, лишь пока качается или скачано —
        # отменённая/неудачная загрузка из вкладки «Найти» не висит в библиотеке «ошибкой»
        it = items.get(iid) or {"id": iid, "_src": "state", "_inlib": 0}
        st = st_items.get(iid) if isinstance(st_items.get(iid), dict) else {}
        fstatus = st.get("status") or "pending"
        if fstatus not in DL_STATUS_RU:
            fstatus = "pending"
        dur = _to_float(st.get("duration_sec")) if fstatus == "done" else None
        hours = round(dur / 3600, 3) if dur else _to_float(it.get("duration_h"))
        fp = st.get("final_path") if fstatus == "done" else None
        bucket = None
        if fp:
            rel = str(fp)
            bucket = "short" if "/Короткое (до 2 ч)/" in rel else "long" if "/Длинное (от 2 ч)/" in rel else None
        if bucket is None and hours is not None:
            bucket = "short" if hours * 3600 <= SHORT_LIMIT_SEC else "long"
        narrator = it.get("narrator") or st.get("narrator") or ""
        inlib = 1 if (it["_inlib"] or fstatus in ("done", "in_progress")) else 0
        rows.append((
            iid, it.get("author") or st.get("author") or "", it.get("title") or st.get("title") or iid,
            it.get("section") or st.get("section") or "Без раздела", bucket, hours, 1 if dur else 0,
            narrator, it.get("lang") or "", 1 if re.search(r"ИИ|\bAI\b", narrator) else 0,
            it.get("kind") or "", it.get("about") or st.get("about") or "",
            it.get("why") or st.get("why") or "", it["_src"], inlib, 1 if iid in start_ids else 0,
            json.dumps(it.get("urls") or st.get("source_urls") or [], ensure_ascii=False), now, now))
        if st:
            file_rows.append((iid, fstatus, fp, _win_path(fp) if fp else None, dur,
                              st.get("size_bytes"), st.get("updated")))
    brief = load_brief()
    seen = {r[0] for r in rows}
    with _tx(conn):
        conn.executemany("""
            INSERT INTO items(id,author,title,section,bucket,hours,hours_exact,narrator,lang,ai_voice,
                              kind,about,why,source,in_library,start_here,urls,added,synced,custom)
            VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,0)
            ON CONFLICT(id) DO UPDATE SET author=excluded.author,title=excluded.title,
              section=excluded.section,bucket=excluded.bucket,hours=excluded.hours,
              hours_exact=excluded.hours_exact,narrator=excluded.narrator,lang=excluded.lang,
              ai_voice=excluded.ai_voice,kind=excluded.kind,about=excluded.about,why=excluded.why,
              source=excluded.source,in_library=excluded.in_library,start_here=excluded.start_here,
              urls=excluded.urls,synced=excluded.synced""", rows)
        for r in brief["read"]:   # «Уже прочитано»: seeded once as custom items (user may edit them)
            note = "прочитано ранее (из профиля)" + (f": {r['note']}" if r["note"] else "")
            conn.execute("INSERT OR IGNORE INTO items(id,author,title,section,source,custom,in_library,note,"
                         "format,added,synced) VALUES(?,?,?,?,'read',1,0,?,'книга',?,?)",
