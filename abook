  if(phone()){c.style.removeProperty('--card-w');c.classList.remove('wide');return}
  const v=$('#v-rate'),left=v.getBoundingClientRect().left+parseFloat(getComputedStyle(v).paddingLeft),w=Math.round(Math.min(1180,Math.max(560,ringLeft()-40-left)));
  c.style.setProperty('--card-w',w+'px');c.classList.toggle('wide',w>=840);SC.cardR=left+w}
function cardHitsStar(){return SC.cardR+8>ringLeft()}   // only when the window is too narrow for the card and the star together
function compName(){if(VIEW!=='rate')return phone()?'far':'side';if($('#card').hidden)return 'hero';return phone()||cardHitsStar()?(phone()?'far':'side'):'hero'}
const still=()=>SC.comp==='far'||SC.comp==='side';
const ease=(a,b,t)=>{t=Math.min(1,Math.max(0,(t-a)/(b-a)));return t*t*(3-2*t)};
