def open_in_windows(item, what, dry=False):
    """Open an item's mp3 with the default Windows player or reveal it in Explorer.
    Only paths known from state.json are used — never client input."""
    if not item.get("path_wsl"):
        raise ValueError("Файл ещё не скачан")
    if not dry and not Path(item["path_wsl"]).exists():
        raise ValueError(f"Файл не найден: {item['path_win']}")
    win = item["path_win"] or _win_path(item["path_wsl"])
    explorer = shutil.which("explorer.exe") or "/mnt/c/Windows/explorer.exe"
    cmd = [explorer, f"/select,{win}"] if what == "folder" else [explorer, win]
    if not dry:
        subprocess.Popen(cmd, cwd="/mnt/c" if Path("/mnt/c").is_dir() else None, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {"cmd": cmd, "win_path": win}


def _item_payload(conn, iid):
    items = get_items(conn, ids=[iid], full=True)
    if not items:
        return None
    rev, hist = get_review(conn, iid, with_history=True)
    tags = [dict(r) for r in conn.execute("SELECT tag, is_preset, polarity FROM tags")]
    return {"item": items[0], "review": rev, "history": hist, "tags_known": tags}


def _meta_payload(conn):
    c = conn.execute("""SELECT (SELECT count(*) FROM items WHERE in_library=1),
        (SELECT count(*) FROM files WHERE status='done'), (SELECT count(*) FROM reviews WHERE profile_id=?1),
        (SELECT count(*) FROM queue WHERE profile_id=?1), (SELECT coalesce(sum(hours),0) FROM items WHERE in_library=1),
        (SELECT count(*) FROM items WHERE in_library=0 AND source NOT IN ('read','custom','orphan'))""",
                     (_pid(),)).fetchone()
    tags = [dict(r) for r in conn.execute(
        "SELECT t.tag, t.is_preset, t.polarity, count(it.item_id) AS n FROM tags t "
        "LEFT JOIN item_tags it ON it.tag=t.tag AND it.profile_id=? GROUP BY t.tag "
        "ORDER BY t.is_preset DESC, n DESC, t.tag", (_pid(),))]
    return {"counts": {"library": c[0], "downloaded": c[1], "reviews": c[2], "queue": c[3],
                       "hours": round(c[4]), "outside": c[5]},
            "statuses": REVIEW_STATUSES, "subscores": [[k, lab] for k, lab, _ in SUBSCORES],
            "tags": tags, "out": out_status(), "synced_at": _meta_get(conn, "synced_at"),
            "authors": [r[0] for r in conn.execute("SELECT DISTINCT author FROM items WHERE author!='' ORDER BY author")],
            "sections": [r[0] for r in conn.execute("SELECT DISTINCT section FROM items WHERE section!='' ORDER BY section")],
            "db": str(DB_PATH), "test_mode": TEST_MODE,
            "check": ((_verify_last() or {}).get("totals") or {}).get("problems")}


