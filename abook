// behind data screens the hole is a still backdrop: the scene renders while something happens there (the move, a smoke
// change, a process, a flick) and pauses ≈4.5 s after (a flick coasts ≈4 s) — big translucent tables over a live canvas cost frames for nothing
function sceneWake(){const a=SC.api;if(!a||!a.ok)return;clearTimeout(SC.sleepT);if(SC.idle){SC.idle=false;sceneWrite()}
  if(SC.comp==='far'&&!PROC.size&&!REDUCED)SC.sleepT=setTimeout(()=>{if(SC.comp==='far'&&!PROC.size){SC.idle=true;a.pause()}},4500)}
function smoke(){const a=SC.api;if(!a||!a.ok)return;
