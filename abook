_RISK_RE = re.compile(
    r"возможно\s+неполн|неполн\w*|сокращ\w*|избранн\w*|част\w*\s+(?:отсутств|нет\b)|отсутству\w*\s+част|"
    r"не\s+хватает|без\s+(?:последн|финал)|глав[аы]?\s+\d+\s*[–—-]\s*\d+|только\s+(?:перв|част|глав)|"
    r"abridged|incomplete|excerpt", re.I)
_RISK_FIELDS = ("title", "narrator", "about", "why", "note_ru", "quality", "kind", "source")


def verify_last_path():
    return STATE_PATH.parent / "verify-last.json"


def text_estimates_path():
    return Path(os.environ.get("ABOOK_TEXT_ESTIMATES") or (ABOOK_DIR / "text-estimates.json"))


def library_universe(manifest_paths=None):
    """id -> manifest item for everything «in library» (full Buldakov list: only its top_ids)."""
    paths = [Path(p) for p in manifest_paths] if manifest_paths else _manifest_sources()
    out = {}
    for p in paths:
        try:
            m = json.loads(p.read_text(encoding="utf-8"))
        except Exception:
            continue
        if isinstance(m, list):
            m = {"items": m}
        if not isinstance(m, dict):
            continue
        is_f_full = p.parent == MANIFESTS_DIR and p.stem == F_FULL_STEM
        top = {x for x in (m.get("top_ids") or []) if isinstance(x, str)}
        for it in m.get("items") or []:
            if not isinstance(it, dict) or not it.get("id"):
                continue
            if is_f_full and it["id"] not in top:
                continue
            if is_f_full and it["id"] in out:
                continue
            out[it["id"]] = it
    return out


def risk_note(it):
    """A snippet if the manifest text hints the recording may be incomplete/abridged."""
    for k in _RISK_FIELDS:
        v = it.get(k)
        if not isinstance(v, str):
            continue
        for m in _RISK_RE.finditer(v):
            before = v[max(0, m.start() - 30):m.start()].lower()
            if re.search(r"(?:не|бы\s)$", before) or re.search(r"\bбез\b[^.,;:!?]{0,24}$", before):
                continue   # «несокращённая», «без купюр и сокращений», «была бы неполной»
            return _one_line(v[max(0, m.start() - 50):m.end() + 60])
    return None


def load_text_estimates():
    try:
        d = json.loads(text_estimates_path().read_text(encoding="utf-8"))
        return d.get("items") or {}
    except Exception:
        return {}


def text_estimate_warning(est, real_sec):
    if not est or not est.get("applies"):
        return None
    try:
        lo, hi = float(est["expected_h_low"]), float(est["expected_h_high"])
    except (KeyError, TypeError, ValueError):
        return None
    h = real_sec / 3600
    conf = est.get("confidence")
    tail = f" (по объёму текста {lo:.1f}–{hi:.1f} ч, уверенность {conf})"
    if h < lo * 0.9:
        return f"вероятно сокращённая/неполная: {h:.1f} ч" + tail
    if h > hi * 1.15:
        return f"длиннее ожидаемого — проверить дубли: {h:.1f} ч" + tail
    return None


def fetch_source_duration(url, work_dir):
    """Duration the platform reports for a URL (a playlist = sum of its entries). (sec|None, error|None)"""
    if is_playlist_url(url):
        args = ["--flat-playlist", "--yes-playlist", "-J", url]
    else:
        args = ["--skip-download", "--no-playlist", "-J", url]
    proc, err = _ytdlp_run(args, work_dir, 180)
    if err:
        return None, err
    if proc.returncode != 0:
        return None, _ytdlp_error(proc)
    try:
        info = json.loads(proc.stdout)
    except Exception as e:
        return None, f"bad JSON: {e}"
    if info.get("_type") == "playlist":
        ds = [(e or {}).get("duration") for e in info.get("entries") or []]
        if not ds or any(d is None for d in ds):
            return None, "у части роликов плейлиста нет длительности"
        return float(sum(ds)), None
    d = info.get("duration")
    return (float(d), None) if d else (None, "площадка не сообщила длительность")


def _item_label(v, it=None):
    it = it or {}
    a = v.get("author") or it.get("author") or ""
    t = v.get("title") or it.get("title") or ""
    return (a + " — " if a else "") + t


def verify_library(full=False, fix=False, net=True, manifests=None, progress=None):
    """Check every done item. Never deletes anything; with fix=True broken files are moved to
    <library>/.quarantine/ and their items marked failed (so `get --retry-failed` redownloads them).
    Safe next to a running `abook get`: reads state without locking, skips in_progress items,
    and writes back only through the state lock after re-checking the item hasn't changed."""
    prog = progress or (lambda **k: None)
    started, mono = now_iso(), time.monotonic()
    universe = library_universe(manifests)
    st = read_state_ro().get("items", {}) or {}
    done = {k: v for k, v in st.items() if isinstance(v, dict) and v.get("status") == "done"}
    estimates = load_text_estimates()
    cks = checksums_read()

    # ---- 1. files: existence + size (quick); + one-read SHA-256/decode/silence, probe, chapters (full)
    def check_one(iid, v):
        r = {"problems": [], "warnings": []}
        fp = v.get("final_path")
        if not fp or not Path(fp).is_file():
            r["problems"].append(("missing", fp or "нет final_path в state"))
            return r
        size = Path(fp).stat().st_size
        r["size"] = size
        if v.get("size_bytes") is not None and size != int(v["size_bytes"]):
            r["problems"].append(("size", f"{size} байт, а записано {int(v['size_bytes'])}"))
        if not full:
            return r
        try:
            pr = probe_media(fp)
        except Exception as e:
            r["problems"].append(("decode", f"ffprobe: {e}"))
            return r
        dur = pr["duration"]
        r["duration"], r["chapters"] = dur, len(pr["chapters"])
        dec = decode_scan(fp)
        r["sha"] = dec["sha256"]
        if v.get("sha256") and dec["sha256"] != v["sha256"]:
            r["problems"].append(("sha", f"сейчас {dec['sha256'][:16]}…, записано {v['sha256'][:16]}…"))
        rel = lib_rel(fp)
        if rel and cks.get(rel) and cks[rel] != dec["sha256"] and not v.get("sha256"):
            r["problems"].append(("sha", f"не совпадает с {CHECKSUMS_NAME}"))
        mp, mw = media_problems(dec, dur)
        for m in mp:
            if m.startswith(("тишина", "суммарно тишины")):
                r["problems"].append(("silence", m))
            else:
                r["problems"].append(("decode", m.replace("ошибка декодирования: ", "", 1)))
        r["warnings"] += mw
        if v.get("duration_sec") and abs(dur - float(v["duration_sec"])) > max(1.0, 0.001 * dur):
            r["problems"].append(("duration", f"{dur:.1f} с, а записано {float(v['duration_sec']):.1f} с"))
        parts = v.get("parts") or []
        chs = pr["chapters"]
        if parts:
            pd = [float(p.get("duration") or 0) for p in parts]
            cp = chapter_problems(chs, pd)
            if cp:
                r["problems"].append(("chapters", "; ".join(cp)))
            r["part_durations"] = pd
            r["chapters_ok"] = not cp
        else:
            # made by the old code: parts not recorded; one chapter per URL unless a URL was a playlist
            urls = v.get("source_urls") or []
            exp = len(urls) if len(urls) > 1 else 0
            starts = [c[0] for c in chs]
            if any(b <= a for a, b in zip(starts, starts[1:])):
                r["problems"].append(("chapters", "начала глав не возрастают"))
            elif urls and not any(is_playlist_url(u) for u in urls) and len(chs) != exp:
                r["problems"].append(("chapters", f"глав {len(chs)}, а ссылок {len(urls)}"))
            elif chs and abs(chs[-1][1] - dur) > max(2.0, 0.01 * dur):
                r["problems"].append(("chapters", f"последняя глава кончается в {chs[-1][1]:.0f} с, файл {dur:.0f} с"))
            r["chapters_ok"] = not any(k == "chapters" for k, _ in r["problems"])
            if len(chs) > 1:
                r["part_durations"] = [c[1] - c[0] for c in chs]
        return r

    results = {}
    ids = sorted(done)
    total = len(ids)
    prog(phase="files", done=0, total=total, current="")
    lock = threading.Lock()
    counter = [0]

    def run(iid):
        try:
            res = check_one(iid, done[iid])
        except Exception as e:
            res = {"problems": [("decode", f"{type(e).__name__}: {e}")], "warnings": []}
        with lock:
            counter[0] += 1
            prog(phase="files", done=counter[0], total=total, current=_item_label(done[iid]))
        return iid, res

    with ThreadPoolExecutor(max_workers=HASH_THREADS if full else 8) as ex:
        for iid, res in ex.map(run, ids):
            results[iid] = res

    # ---- 2. source durations for items made by the old code (cached in state), full + net only
    src_cache = {}
    net_note = None
    if full and net:
        need = []
        for iid in ids:
            v = done[iid]
            if any(p.get("source_duration") for p in v.get("parts") or []):
                continue
            have = v.get("source_durations") or {}
            urls = v.get("source_urls") or (universe.get(iid) or {}).get("urls") or []
            need += [(iid, u) for u in urls if not have.get(u)]   # unknown or failed last time
        work = STATE_PATH.parent / "verify-tmp"
        for n, (iid, u) in enumerate(need, 1):
            prog(phase="source", done=n - 1, total=len(need), current=_item_label(done[iid]))
            d, err = fetch_source_duration(u, work)
            if err and is_bot_check_error(err):
                net_note = f"YouTube просит подтвердить, что вы не бот — остальные {len(need) - n + 1} ссылок не проверены"
                break
            src_cache.setdefault(iid, {})[u] = d if d else None
            if n < len(need):
                time.sleep(3)
        shutil.rmtree(work, ignore_errors=True)
        prog(phase="source", done=len(need), total=len(need), current="")

    # ---- 3. completeness verdicts
    incomplete, suspicious = {}, {}
    source_verified = set()
    for iid in ids:
        v, r = done[iid], results[iid]
        it = universe.get(iid) or {}
        real = r.get("duration") or float(v.get("duration_sec") or 0)
        parts = v.get("parts") or []
        inc, sus = [], list(v.get("warnings") or []) if not full else []
        if full:
            sus += r.get("warnings", [])
        if parts and all(p.get("source_duration") for p in parts):
            tr = truncated_parts(parts)
            inc += tr
            if not tr:
                source_verified.add(iid)
        else:
            urls = v.get("source_urls") or it.get("urls") or []
            sd = dict(v.get("source_durations") or {})
            sd.update(src_cache.get(iid, {}))
            vals = [sd.get(u) for u in urls]
            if urls and all(vals):
                tot = float(sum(vals))
                tol = max(5.0, 0.005 * tot)
                if real < tot - tol:
                    inc.append(f"длительность {real / 3600:.2f} ч, а по источнику {tot / 3600:.2f} ч "
                               f"(не хватает {(tot - real) / 60:.1f} мин)")
                elif real > tot + max(tol, 0.01 * tot):
                    sus.append(f"файл длиннее источника: {real / 3600:.2f} ч против {tot / 3600:.2f} ч — проверить дубли")
                else:
                    source_verified.add(iid)
        pd = r.get("part_durations") or [float(p.get("duration") or 0) for p in parts]
        if full:
            sus += short_part_warnings(pd)
        w = manifest_duration_warning(real, it.get("duration_h"))
        if w:
            sus.append(w)
        tw = text_estimate_warning(estimates.get(iid), real)
        if tw:
            sus.append(tw)
        sus = list(dict.fromkeys(sus))
        if inc:
            incomplete[iid] = inc
            r["problems"].append(("incomplete", "; ".join(inc)))
        if sus:
            suspicious[iid] = sus

    # ---- 4. write back (sha256 for old items, verified_at, source-duration cache) — under the lock
    updates, ck_add, ck_remove, fixed = {}, {}, [], []
    for iid in ids:
        v, r = done[iid], results[iid]
        upd = {}
        if src_cache.get(iid):
            upd["source_durations"] = {**(v.get("source_durations") or {}), **src_cache[iid]}
        if full and not r["problems"] and r.get("sha"):
            if not v.get("sha256"):
                upd["sha256"] = r["sha"]
            if v.get("size_bytes") is None:
                upd["size_bytes"] = r.get("size")
            if v.get("chapters") is None:
                upd["chapters"] = r.get("chapters")
            upd["verified_at"] = now_iso()
            rel = lib_rel(v["final_path"])
            if rel:
                ck_add[rel] = v.get("sha256") or r["sha"]
        if upd:
            updates[iid] = upd
    to_fix = [iid for iid in ids if any(k in FIXABLE_KINDS for k, _ in results[iid]["problems"])] if fix else []
    if updates or to_fix:
        qdir = AUDIOBOOKS_ROOT / QUARANTINE_NAME
        with _state_lock():
            state = load_state()
            for iid, upd in updates.items():
                cur = state["items"].get(iid)
                if cur and cur.get("status") == "done" and cur.get("final_path") == done[iid].get("final_path"):
                    cur.update(upd)
            for iid in to_fix:
                cur = state["items"].get(iid)
                if not (cur and cur.get("status") == "done" and cur.get("final_path") == done[iid].get("final_path")):
                    continue
                reason = "; ".join(f"{PROBLEM_KINDS[k]}: {d}" for k, d in results[iid]["problems"])
                fp = Path(cur.get("final_path") or "")
                qpath = None
                if fp.is_file():
                    qdir.mkdir(parents=True, exist_ok=True)
                    qpath = qdir / f"{datetime.now():%Y%m%d-%H%M%S}__{fp.name}"
                    shutil.move(str(fp), str(qpath))
                rel = lib_rel(fp)
                if rel:
                    ck_remove.append(rel)
                    ck_add.pop(rel, None)
                cur.update(status="failed", error=f"verify: {reason}"[:1500], quarantined_path=str(qpath) if qpath else None,
                           updated=now_iso())
                fixed.append({"id": iid, "quarantined_path": str(qpath) if qpath else None})
            save_state(state)
    if ck_add or ck_remove:
        try:
            checksums_update(ck_add, ck_remove)
        except Exception as e:
            log(f"WARN: {CHECKSUMS_NAME} not updated: {e}")

    # ---- 5. report
    fixed_ids = {f["id"] for f in fixed}
    problems = []
    for iid in ids:
        v = done[iid]
        for k, d in results[iid]["problems"]:
            problems.append({"id": iid, "label": _item_label(v, universe.get(iid)), "section": v.get("section", ""),
                             "kind": k, "kind_ru": PROBLEM_KINDS[k], "detail": d, "path": v.get("final_path"),
                             "win_path": _win_path(v.get("final_path")), "fixed": iid in fixed_ids})
    for iid, v in sorted(st.items()):
        if isinstance(v, dict) and v.get("status") == "failed":
            err = v.get("error") or ""
            k = "order" if err.startswith("порядок частей") else "failed"
            problems.append({"id": iid, "label": _item_label(v, universe.get(iid)), "section": v.get("section", ""),
                             "kind": k, "kind_ru": PROBLEM_KINDS[k], "detail": _one_line(err)[:500],
                             "path": v.get("final_path"), "win_path": _win_path(v.get("final_path")),
                             "fixed": False})
    lib_ids = set(universe) | set(done)
    not_dl = []
    for iid in sorted(lib_ids - set(done)):
        it, v = universe.get(iid) or {}, st.get(iid) or {}
        not_dl.append({"id": iid, "label": _item_label(v, it), "section": it.get("section") or v.get("section") or "Без раздела",
                       "status": v.get("status") or "pending", "error": _one_line(v.get("error") or "")[:300],
                       "hours": it.get("duration_h")})
    manual = []
    for iid in sorted(lib_ids):
        note = risk_note(universe.get(iid) or {})
        if note:
            v = st.get(iid) or {}
            manual.append({"id": iid, "label": _item_label(v, universe.get(iid)),
                           "section": (universe.get(iid) or {}).get("section", ""),
                           "status": v.get("status") or "pending", "note": note})
    lab = lambda iid: _item_label(done[iid], universe.get(iid))  # noqa: E731
    bad_ids = {p["id"] for p in problems if p["id"] in done}
    guaranteed = [iid for iid in ids
                  if full and not results[iid]["problems"] and results[iid].get("sha")
                  and results[iid].get("chapters_ok") and iid in source_verified and iid not in suspicious]
    with_sha = sum(1 for iid in ids if done[iid].get("sha256") or (iid in updates and updates[iid].get("sha256")))
    n_failed = sum(1 for v in st.values() if isinstance(v, dict) and v.get("status") == "failed")
    res = {
        "version": 1, "started": started, "finished": now_iso(), "seconds": round(time.monotonic() - mono, 1),
        "mode": "full" if full else "quick", "fix": fix, "net": bool(full and net), "net_note": net_note,
        "library_root": str(AUDIOBOOKS_ROOT),
        "totals": {
            "in_library": len(lib_ids), "downloaded": len(done), "ok": len(done) - len(bad_ids),
            "problems": len({p["id"] for p in problems}), "not_downloaded": len(not_dl), "failed": n_failed,
            "in_progress": sum(1 for x in not_dl if x["status"] == "in_progress"),
            "incomplete": len(incomplete), "suspicious": len(suspicious), "manual": len(manual),
            "guaranteed": len(guaranteed) if full else None, "source_verified": len(source_verified),
            "hours": round(sum(float(done[i].get("duration_sec") or 0) for i in ids) / 3600, 1),
            "gb": round(sum(int(done[i].get("size_bytes") or 0) for i in ids) / 1024 ** 3, 2),
            "checksum_coverage": round(100.0 * with_sha / len(done), 1) if done else 100.0,
        },
        "problems": problems,
        "incomplete": [{"id": i, "label": lab(i), "notes": incomplete[i]} for i in sorted(incomplete)],
        "suspicious": [{"id": i, "label": lab(i), "notes": suspicious[i]} for i in sorted(suspicious)],
        "manual": manual,
        "not_downloaded": not_dl,
        "guaranteed": guaranteed,
        "fixed": fixed,
    }
    try:
        _atomic_write_text(verify_last_path(), json.dumps(res, ensure_ascii=False, indent=1))
    except Exception as e:
        log(f"WARN: cannot save {verify_last_path()}: {e}")
    prog(phase="done", done=total, total=total, current="")
    return res


def print_verify_report(res):
    t = res["totals"]
    mode = "полная (SHA-256, декодирование, главы, тишина)" if res["mode"] == "full" else "быстрая (наличие + размер)"
    print(f"Проверка: {mode}, {res['seconds']} с, {res['finished']}")
    print(f"  в библиотеке {t['in_library']} · скачано {t['downloaded']} · OK {t['ok']} · проблем {t['problems']} · "
          f"не скачано {t['not_downloaded']} (с ошибкой {t['failed']}, качается {t['in_progress']})")
    print(f"  {t['hours']} ч, {t['gb']} ГБ · SHA-256 записан у {t['checksum_coverage']}% скачанного"
          + (f" · гарантированно проверено: {t['guaranteed']} из {t['downloaded']}" if t.get("guaranteed") is not None else ""))
    print(f"  полнота: сверено с источником {t['source_verified']} · неполных {t['incomplete']} · "
          f"подозрительных {t['suspicious']} · требуют ручной проверки {t['manual']}")
    if res.get("net_note"):
        print(f"  ! {res['net_note']}")
    if res["problems"]:
        print("\nПРОБЛЕМЫ:")
        fmt = "  {:26.26} {:36.36} {}"
        print(fmt.format("ID", "ПРОБЛЕМА", "ПОДРОБНОСТИ"))
        for p in res["problems"]:
            print(fmt.format(p["id"], p["kind_ru"] + (" → карантин" if p["fixed"] else ""), p["detail"][:220]))
    for key, head in (("incomplete", "НЕПОЛНЫЕ"), ("suspicious", "ПОДОЗРИТЕЛЬНО")):
        if res[key]:
            print(f"\n{head}:")
            for x in res[key]:
                print(f"  {x['id']:26.26} {x['label'][:50]}")
                for n in x["notes"]:
                    print(f"      - {n}")
    if res["manual"]:
        print("\nТРЕБУЮТ РУЧНОЙ ПРОВЕРКИ ПОЛНОТЫ (по тексту манифеста):")
        for x in res["manual"]:
            print(f"  {x['id']:26.26} [{x['status']}] «…{x['note'][:110]}…»")
    if res["fixed"]:
        print(f"\nВ карантин ({AUDIOBOOKS_ROOT / QUARANTINE_NAME}) и в failed: {len(res['fixed'])}. "
              f"Перекачать: abook get <манифесты> --retry-failed")
    elif any(p["kind"] in FIXABLE_KINDS for p in res["problems"]):
        print("\nЧтобы перекачать сломанное: abook verify --full --fix, затем abook get <манифесты> --retry-failed")


def cmd_verify(args):
    def progress(**k):
        if k.get("phase") == "source" and k.get("total"):
            print(f"\r  источник: {k['done']}/{k['total']} {k.get('current', '')[:60]:60}", end="", file=sys.stderr, flush=True)
        elif k.get("phase") == "files" and k.get("total"):
            print(f"\r  файлы: {k['done']}/{k['total']} {k.get('current', '')[:60]:60}", end="", file=sys.stderr, flush=True)
        elif k.get("phase") == "done":
            print("\r" + " " * 90 + "\r", end="", file=sys.stderr, flush=True)
    res = verify_library(full=args.full, fix=args.fix, net=not args.no_net, manifests=args.manifests or None,
                         progress=progress if sys.stderr.isatty() else None)
    if args.json:
        print(json.dumps(res, ensure_ascii=False, indent=1))
    else:
        print_verify_report(res)
    bad = [p for p in res["problems"] if p["kind"] != "failed" or args.fix]
    sys.exit(1 if bad else 0)


# --------------------------------------------------------------------------
# Durability helpers for `get`: state backups, stale *.part cleanup
# --------------------------------------------------------------------------

STATE_BACKUP_EVERY = 30 * 60
STATE_BACKUP_KEEP = 48


def state_backup():
    try:
        d = STATE_PATH.parent / "state-backups"
        d.mkdir(parents=True, exist_ok=True)
        if not STATE_PATH.exists():
            return
        dst = d / f"state-{datetime.now():%Y%m%d-%H%M%S}.json"
        with _state_lock():
            shutil.copyfile(STATE_PATH, dst)
        olds = sorted(d.glob("state-*.json"))
        for o in olds[:-STATE_BACKUP_KEEP]:
            with contextlib.suppress(OSError):
                o.unlink()
    except Exception as e:
        log(f"WARN: state backup failed: {e}")


def _other_get_running():
    me = os.getpid()
    try:
        out = subprocess.run(["pgrep", "-f", r"^python3? .*abook get"], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return True
    return any(int(x) != me for x in out.split() if x.isdigit())


def cleanup_stale_parts(min_age_sec=15 * 60):
    """Leftover <name>.mp3.part / .m4a.part from a crash mid-copy: removed on start (all of them when
    no other `abook get` is running, otherwise only ones untouched for 15 min)."""
    if not AUDIOBOOKS_ROOT.is_dir():
        return
    alone = not _other_get_running()
    now = time.time()
    for root, dirs, files in os.walk(AUDIOBOOKS_ROOT):
        dirs[:] = [x for x in dirs if x != QUARANTINE_NAME]
        for fn in files:
            if fn.endswith((".mp3.part", ".m4a.part")):
                p = Path(root) / fn
                try:
                    if alone or now - p.stat().st_mtime > min_age_sec:
                        p.unlink()
                        log(f"removed leftover partial copy {p}")
                except OSError:
                    pass


def cmd_notes(args):
    state = load_state()
    items_state = state.get("items", {})

    sections = {}       # section -> {"notes": str, "rows": [state dict]}
    section_order = []
    start_here_blocks = []

    for mpath in args.manifests:
        manifest = load_manifest_raw(mpath)
        section_notes = manifest.get("section_notes", {}) or {}
        start_here = manifest.get("start_here")
        if start_here:
            start_here_blocks.append(start_here)
        for it in manifest.get("items", []):
            iid = it.get("id")
            sec = it.get("section") or "Без раздела"
            st = items_state.get(iid)
            if not st or st.get("status") != "done":
                continue
            fp = st.get("final_path")
            key = (str(Path(fp).parent) if fp else sec)
            if key not in sections:
                sections[key] = {"notes": section_notes.get(sec, ""), "rows": [], "title": sec,
                                 "dir": Path(fp).parent if fp else None}
                section_order.append(key)
            sections[key]["rows"].append(st)

    AUDIOBOOKS_ROOT.mkdir(parents=True, exist_ok=True)
    hours_by_section = {}

    for sec in section_order:
        info = sections[sec]
        sec_dir = info["dir"] or AUDIOBOOKS_ROOT
        rel = str(sec_dir.relative_to(AUDIOBOOKS_ROOT)) if info["dir"] else info["title"]
        lines = [rel, "=" * len(rel), ""]
        if info["notes"]:
            lines.append(info["notes"])
            lines.append("")
        sec_hours = 0.0
        for st in info["rows"]:
            hrs = (st.get("duration_sec") or 0) / 3600
            sec_hours += hrs
            lines.append(f"{st.get('author', '')} — {st.get('title', '')}")
            if st.get("narrator"):
                lines.append(f"Читает: {st['narrator']}")
            lines.append(f"Длительность: {hrs:.1f} ч")
            if st.get("about"):
                lines.append(f"О чём: {st['about']}")
            if st.get("why"):
                lines.append(f"Почему стоит послушать: {st['why']}")
            lines.append("")
        hours_by_section[sec] = (rel, sec_hours)
        out_path = sec_dir / "ОБ ЭТОМ.txt"
        write_windows_text(out_path, "\n".join(lines))
        log(f"notes: wrote {out_path}")

    top_lines = ["Аудиокниги", "==========", ""]
    for sec in section_order:
        rel, hrs = hours_by_section[sec]
        top_lines.append(f"{rel}: {hrs:.1f} ч")
    if start_here_blocks:
        top_lines.append("")
        top_lines.append("С чего начать")
        top_lines.append("-------------")
        for block in start_here_blocks:
            top_lines.append(block)
    top_path = AUDIOBOOKS_ROOT / "ЧИТАЙ МЕНЯ.txt"
    write_windows_text(top_path, "\n".join(top_lines))
    log(f"notes: wrote {top_path}")


