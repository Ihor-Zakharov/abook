def load_brief():
    """Listener profile, «Уже прочитано» titles and favourite narrators from BRIEF-COMMON.md."""
    try:
        text = BRIEF_PATH.read_text(encoding="utf-8")
    except Exception:
        return {"profile": "", "read": [], "narrators": ""}
    m = re.search(r"^##\s*Кто слушатель\s*\n(.*?)(?=^##\s|\Z)", text, re.S | re.M)
    profile = m.group(1).strip() if m else ""
    read = []
    m2 = re.search(r"Уже прочитано[^:\n]*:([^\n]*)", profile)
    if m2:
        for t, note in re.findall(r"«([^»]+)»\s*(?:\(([^)]*)\))?", m2.group(1)):
            t = t.strip()
            read.append({"id": "custom:" + _translit_slug(t), "title": t,
                         "author": READ_AUTHORS.get(_norm(t), ""), "note": note.strip()})
    profile = re.sub(r"Уже прочитано\s*—\s*НЕ включать:", "Уже прочитано:", profile)
    m3 = re.search(r"хороший чтец\s*\(([^)]*)\)", text)
    return {"profile": profile, "read": read, "narrators": m3.group(1).strip() if m3 else ""}


