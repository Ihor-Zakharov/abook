def all_reviews(conn, with_history=False):
    tmap = _tags_map(conn)
    revs = {}
    for r in conn.execute("SELECT * FROM reviews WHERE profile_id=? ORDER BY item_id", (_pid(),)):
        revs[r["item_id"]] = _review_row_dict(r, tmap.get(r["item_id"], []))
    if with_history:
        for rv in revs.values():
            rv["history"] = []
