class Stagger:
    """Enforces a minimum wall-clock gap between successive item starts,
    across all worker threads, to avoid bursts of simultaneous requests
    that can trip YouTube's bot check."""

    def __init__(self, min_gap):
        self.min_gap = min_gap
        self._lock = threading.Lock()
        self._last = 0.0

    def wait(self):
        with self._lock:
            now = time.monotonic()
            delay = self._last + self.min_gap - now
            if delay > 0:
                time.sleep(delay)
                now = time.monotonic()
            self._last = now


_stagger = Stagger(STAGGER_SECONDS)


