# --------------------------------------------------------------------------- utils

def hms(sec):
    sec = max(0, int(round(sec or 0)))
    return f"{sec // 3600}:{sec % 3600 // 60:02d}:{sec % 60:02d}"


def norm(s):
    s = unicodedata.normalize("NFKC", str(s or "")).lower().replace("ё", "е")
    return re.sub(r"[^\w]+", " ", s).strip()


def load_json(p, default=None):
    try:
        return json.loads(Path(p).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def load_catalog():
    """id -> манифестная запись (+ _manifest). Более ранние файлы важнее; F-buldakov.json — последним."""
    items = {}
    files = [f for f in MANIFEST_FILES if f.name != FULL_CATALOG] + \
            [f for f in MANIFEST_FILES if f.name == FULL_CATALOG]
    for f in files:
        d = load_json(f, {}) or {}
        for it in d.get("items", []) if isinstance(d, dict) else []:
            if isinstance(it, dict) and it.get("id") and it["id"] not in items:
                items[it["id"]] = {**it, "_manifest": f.name}
    return items


def load_state():
    d = load_json(STATE, {}) or {}
    return d.get("items", {}) if isinstance(d, dict) else {}


def load_estimates():
    d = load_json(ESTIMATES, {}) or {}
    return d.get("items", {}) if isinstance(d, dict) else {}


def find_item(query, catalog, state):
    """Точный id или нечёткий поиск по id/автору/названию. Возвращает (id, [кандидаты])."""
    ids = set(catalog) | set(state)
    if query in ids:
        return query, []
    q = norm(query)
    toks = q.split()

    def hay(iid):
        m, s = catalog.get(iid, {}), state.get(iid, {})
        return norm(" ".join([iid.replace("-", " "), m.get("author") or s.get("author") or "",
                              m.get("title") or s.get("title") or ""]))
    hits = [i for i in ids if all(t in hay(i) for t in toks)]
    if not hits:
        scored = sorted(((difflib.SequenceMatcher(None, q, hay(i)).ratio(), i) for i in ids), reverse=True)
        hits = [i for r, i in scored[:8] if r > 0.35]
    # сначала скачанные
    hits.sort(key=lambda i: (state.get(i, {}).get("status") != "done", i))
    if len(hits) == 1:
        return hits[0], []
    return None, hits


# --------------------------------------------------------------------------- media

def ffprobe(path):
    r = subprocess.run([FFPROBE, "-v", "error", "-show_chapters", "-show_format", "-of", "json", str(path)],
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        raise RuntimeError(f"ffprobe: {r.stderr.strip()[-300:]}")
    return json.loads(r.stdout or "{}")


def part_layout(st, probe):
    """Список частей [{'n','start','end','title'}] — по главам файла, иначе по state.parts."""
    dur = float((probe.get("format") or {}).get("duration") or st.get("duration_sec") or 0)
    parts = []
    for i, c in enumerate(probe.get("chapters") or []):
        try:
            parts.append({"n": i + 1, "start": float(c["start_time"]), "end": float(c["end_time"]),
                          "title": (c.get("tags") or {}).get("title") or ""})
        except (KeyError, ValueError, TypeError):
            pass
    src = "главы файла (ffprobe)"
    if len(parts) < 2 and len(st.get("parts") or []) > 1:
        parts, t = [], 0.0
        for i, p in enumerate(st["parts"]):
            d = float(p.get("duration") or 0)
            parts.append({"n": i + 1, "start": t, "end": t + d, "title": p.get("title") or ""})
            t += d
        src = "state.json parts"
    if not parts:
        parts = [{"n": 1, "start": 0.0, "end": dur, "title": ""}]
        src = "один файл без глав"
    # сведения о частях из state (длительность у источника, sha)
    sp = st.get("parts") or []
    if len(sp) == len(parts):
        for p, s in zip(parts, sp):
            p["source_duration"] = s.get("source_duration")
            p["url"] = s.get("url")
    return dur, parts, src


def plan_clips(dur, parts, n_interior, clip_len):
    clips = [{"key": "start", "label": "НАЧАЛО КНИГИ", "start": 0.0, "len": min(90.0, dur)}]
    for a, b in zip(parts, parts[1:]):
        t = b["start"]
        clips.append({"key": f"b{a['n']:03d}_end", "label": f"КОНЕЦ ЧАСТИ {a['n']} (стык {a['n']}→{b['n']})",
                      "start": max(0.0, t - 45.0), "len": min(45.0, t), "boundary": a["n"]})
        clips.append({"key": f"b{a['n']:03d}_beg", "label": f"НАЧАЛО ЧАСТИ {b['n']} (стык {a['n']}→{b['n']})",
                      "start": t, "len": min(45.0, max(0.0, dur - t)), "boundary": a["n"]})
    for k in range(1, n_interior + 1):
        c = dur * k / (n_interior + 1) - clip_len / 2
        clips.append({"key": f"mid{k}", "label": f"СЕРЕДИНА, образец {k} из {n_interior}",
                      "start": max(0.0, c), "len": min(clip_len, dur)})
    clips.append({"key": "end", "label": "КОНЕЦ КНИГИ", "start": max(0.0, dur - 120.0), "len": min(120.0, dur)})
    for c in clips:
        c["start"], c["len"] = round(c["start"], 2), round(c["len"], 2)
    return [c for c in clips if c["len"] >= 1.0]


SIL_START = re.compile(r"silence_start: (-?[\d.]+)")
SIL_END = re.compile(r"silence_end: (-?[\d.]+) \| silence_duration: ([\d.]+)")
VOL = re.compile(r"(mean|max)_volume: (-?[\d.]+|-inf) dB")


def cut_clip(src, clip, wav):
    """Вырезать фрагмент в WAV 16 кГц моно + заодно паузы (silencedetect) и громкость."""
    cmd = [FFMPEG, "-hide_banner", "-nostdin", "-y", "-ss", f"{clip['start']:.2f}", "-t", f"{clip['len']:.2f}",
           "-i", str(src), "-vn", "-ac", "1", "-ar", "16000",
           "-af", "silencedetect=n=-40dB:d=1.5,volumedetect", "-c:a", "pcm_s16le", str(wav)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    if r.returncode != 0 or not Path(wav).exists():
        raise RuntimeError(f"ffmpeg: {r.stderr.strip()[-300:]}")
    sil, cur = [], None
    for line in r.stderr.splitlines():
        m = SIL_START.search(line)
        if m:
            cur = float(m.group(1))
        m = SIL_END.search(line)
        if m:
            e = float(m.group(1))
            sil.append([round(cur if cur is not None else e - float(m.group(2)), 1), round(e, 1)])
            cur = None
    if cur is not None:
        sil.append([round(cur, 1), round(clip["len"], 1)])
    vol = {k: (None if v == "-inf" else float(v)) for k, v in VOL.findall(r.stderr)}
    return {"silences": sil, "mean_db": vol.get("mean"), "max_db": vol.get("max")}


# --------------------------------------------------------------------------- STT (venv)

def stt_worker():
    """Запускается в ~/abook/.venv-check: читает задание JSON из stdin, пишет транскрипты в файлы."""
    job = json.load(sys.stdin)
    from faster_whisper import WhisperModel
    t0 = time.time()
    model = WhisperModel(job["model"], device="cpu", compute_type="int8", cpu_threads=job.get("threads", 4))
    print(f"  модель {job['model']} загружена за {time.time() - t0:.1f} с", file=sys.stderr, flush=True)
    for i, c in enumerate(job["clips"], 1):
        t1 = time.time()
        det = None
        if c.get("detect"):
            try:
                _, info = model.transcribe(c["wav"], language=None, beam_size=1, without_timestamps=True,
                                           condition_on_previous_text=False)
                det = [info.language, round(info.language_probability, 2)]
            except Exception as e:                                   # noqa: BLE001
                det = [f"?({type(e).__name__})", 0]
        segs, info = model.transcribe(c["wav"], language=job["lang"], beam_size=1, vad_filter=False,
                                      condition_on_previous_text=False, temperature=0.0)
        out = []
        for s in segs:
            out.append([round(s.start, 1), round(s.end, 1), s.text.strip(), round(s.no_speech_prob, 2)])
        res = {"segments": out, "text": " ".join(s[2] for s in out).strip(), "detected": det,
               "stt_sec": round(time.time() - t1, 1)}
        Path(c["out"]).write_text(json.dumps(res, ensure_ascii=False), encoding="utf-8")
        print(f"  [{i}/{len(job['clips'])}] {Path(c['out']).stem}: {res['stt_sec']} с", file=sys.stderr, flush=True)


def transcribe(clips, lang, model, threads, verbose):
    if not VENV_PY.exists():
        die("нет venv для распознавания: uv venv ~/abook/.venv-check && "
            "uv pip install --python ~/abook/.venv-check faster-whisper")
    job = {"model": model, "lang": lang, "threads": threads,
           "clips": [{"wav": c["_wav"], "out": c["_txt"], "detect": c["key"] in ("start", "mid1")} for c in clips]}
    r = subprocess.run(["nice", "-n", "10", str(VENV_PY), os.path.abspath(__file__), "--_stt-worker"],
                       input=json.dumps(job), text=True, stdout=subprocess.PIPE,
                       stderr=None if verbose else subprocess.PIPE, timeout=3600)
    if r.returncode != 0:
        die(f"распознавание речи упало: {(r.stderr or '')[-800:]}")


