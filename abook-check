def build_prompt(ctx, clips_out):
    m, st, est = ctx["manifest"], ctx["state"], ctx["estimate"]
    L = ["# Задача",
         "Проверь, что скачанная аудиокнига ПОЛНАЯ и её части склеены в ПРАВИЛЬНОМ ПОРЯДКЕ. У тебя нет аудио — "
         "только фрагменты, распознанные Whisper (small, могут быть ошибки распознавания, особенно в именах; "
         "пустой текст = тишина или музыка).", "",
         "# Книга",
         f"- id: {ctx['id']}",
         f"- автор: {m.get('author') or st.get('author') or '?'}",
         f"- название: {m.get('title') or st.get('title') or '?'}",
         f"- чтец/постановка: {m.get('narrator') or st.get('narrator') or 'не указан'}",
         f"- язык: {ctx['lang']}; тип: {m.get('kind') or '?'}; источник: {m.get('source') or '?'}"]
    if m.get("about"):
        L.append(f"- о книге: {m['about']}")
    for k in ("note_ru", "quality"):
        if m.get(k):
            L.append(f"- заметка составителя: {m[k]}")
    L.append(f"- реальная длительность файла: {hms(ctx['duration'])} ({ctx['duration'] / 3600:.2f} ч)")
    if m.get("duration_h"):
        L.append(f"- длительность по данным площадки (манифест): {float(m['duration_h']):.2f} ч")
    if est.get("expected_h_low") is not None:
        L.append(f"- ожидаемо по объёму текста: {est.get('expected_h_low')}–{est.get('expected_h_high')} ч "
                 f"(≈{est.get('words_est')} слов; оценка «{est.get('verdict')}», уверенность {est.get('confidence')}; "
                 f"{est.get('note') or ''})")
    elif est:
        L.append(f"- оценка по объёму текста неприменима ({est.get('note') or est.get('verdict')})")
    if ctx.get("replacement"):
        L.append(f"- история замены источника: {ctx['replacement']}")
    if st.get("warnings"):
        L.append(f"- предупреждения загрузчика: {'; '.join(map(str, st['warnings']))}")
    L += ["", f"# Части ({len(ctx['parts'])}; разметка: {ctx['layout_src']})"]
    for p in ctx["parts"]:
        extra = ""
        if p.get("source_duration"):
            extra = f", у источника {hms(p['source_duration'])}"
        L.append(f"{p['n']}. {hms(p['start'])}–{hms(p['end'])} ({hms(p['end'] - p['start'])}{extra}) "
                 f"«{p.get('title') or ''}»")
    L += ["", "# Фрагменты (время — от начала склеенного файла; паузы ≥1,5 с указаны относительно начала фрагмента)"]
    for c in clips_out:
        t = c.get("transcript") or {}
        meta = [f"{hms(c['start'])}–{hms(c['start'] + c['len'])}"]
        if c.get("mean_db") is not None:
            meta.append(f"громкость ср. {c['mean_db']:.0f} дБ")
        if c.get("silences"):
            meta.append("паузы: " + ", ".join(f"{a:g}–{b:g} с" for a, b in c["silences"][:6]))
        if t.get("detected"):
            meta.append(f"язык по Whisper: {t['detected'][0]} ({t['detected'][1]})")
        L.append(f"\n## [{c['key']}] {c['label']} · " + " · ".join(meta))
        L.append((t.get("text") or "").strip() or "(речь не распознана: тишина/музыка)")
    L += ["", "# Что оценить",
          "1. Начало: это настоящее начало произведения (первые строки текста) или обычное вступление аудиокниги "
          "(название, автор, чтец, музыка), после которого идёт начало? Или запись начинается с середины / это другое "
          "произведение? Если знаешь первые строки оригинала/перевода — сравни.",
          "2. Конец: это настоящая концовка произведения (последние строки, «конец», титры после финала) или обрыв "
          "посреди действия?",
          "3. Каждый стык частей: продолжает ли начало части N+1 конец части N — без пропуска (выпал кусок), без "
          "повтора/нахлёста (тот же текст дважды) и в правильном порядке (не следующая-через-одну часть, не "
          "предыдущая)? Нормально, если на стыке заставка/«часть вторая»/повтор названия — это chapter_break или "
          "continuous. Учитывай, что фрагменты короткие: если не можешь решить — unclear, а не gap.",
          "4. Признаки: сокращённое издание/радиоверсия (длительность заметно меньше ожидаемой, пересказ), не то "
          "произведение, не тот перевод, не тот язык, искажённая/«машинная» ИИ-озвучка (бессвязные слова), реклама и "
          "вставки канала, повторяющиеся куски.",
          "5. Итог: complete / probably_complete / incomplete / wrong_order / wrong_work / cant_tell, уверенность "
          "0–1 и конкретные доказательства (дословные цитаты с меткой фрагмента). Не выдумывай содержание, которого "
          "нет во фрагментах; если чего-то не знаешь о тексте — так и скажи.",
          "", "# Формат ответа",
          "Верни ТОЛЬКО один JSON-объект строго по схеме (все ключи обязательны; boundaries — по одному на каждый "
          "стык, в порядке; пустые списки допустимы):", SCHEMA]
    return "\n".join(L)


def extract_json(text):
    text = (text or "").strip()
    text = re.sub(r"^```(?:json)?\s*|\s*```$", "", text)
    try:
        return json.loads(text)
    except ValueError:
        pass
    a, b = text.find("{"), text.rfind("}")
    if a >= 0 and b > a:
        return json.loads(text[a:b + 1])
    raise ValueError("в ответе нет JSON")


def call_claude(prompt, model, timeout):
    cmd = [CLAUDE, "-p", "--model", model, "--output-format", "json", "--tools", "",
           "--no-session-persistence", "--strict-mcp-config", "--system-prompt", SYSTEM]
    t0 = time.time()
    r = subprocess.run(cmd, input=prompt, text=True, capture_output=True, timeout=timeout,
                       cwd=str(CACHE))
    dt = time.time() - t0
    if r.returncode != 0 and not r.stdout.strip():
        raise RuntimeError(f"claude exit {r.returncode}: {r.stderr.strip()[-500:]}")
    env = json.loads(r.stdout)
    if env.get("is_error"):
        raise RuntimeError(f"claude: {str(env.get('result'))[:500]}")
    return env.get("result") or "", {"sec": round(dt, 1), "cost_usd": env.get("total_cost_usd"),
                                     "model": ",".join((env.get("modelUsage") or {}).keys()) or model}


def ask_claude(prompt, model, timeout):
    meta_all = []
    text, meta = call_claude(prompt, model, timeout)
    meta_all.append(meta)
    try:
        res = extract_json(text)
    except ValueError:
        retry = (prompt + "\n\nВНИМАНИЕ: предыдущий ответ не был корректным JSON. Верни ТОЛЬКО один JSON-объект "
                 "по схеме — первый символ «{», последний «}», без пояснений и без ```.")
        text, meta = call_claude(retry, model, timeout)
        meta_all.append(meta)
        res = extract_json(text)
    if res.get("verdict") not in VERDICTS:
        res["verdict_raw"], res["verdict"] = res.get("verdict"), "cant_tell"
    return res, meta_all


# --------------------------------------------------------------------------- report

def print_report(rep):
    r, b = rep["result"], rep["book"]
    print(f"\n{b['author']} — {b['title']}  [{rep['id']}]")
    print(f"Файл: {rep['file']}")
    exp = ""
    if b.get("expected_h") and None not in b["expected_h"]:
        exp = f"; ожидалось по тексту {b['expected_h'][0]}–{b['expected_h'][1]} ч"
    print(f"Длительность: {hms(b['duration_sec'])} ({b['duration_sec'] / 3600:.2f} ч){exp}; частей: {b['parts']}")
    print("")
    conf = r.get("confidence")
    conf = f"{float(conf):.0%}" if isinstance(conf, (int, float)) else str(conf)
    print(f"ВЕРДИКТ: {VERDICTS.get(r.get('verdict'), r.get('verdict'))}  (уверенность {conf}, модель {rep['model']})")
    if r.get("summary_ru"):
        print(f"  {r['summary_ru']}")
    print("")
    for key, name in (("opening", "Начало"), ("ending", "Конец")):
        o = r.get(key) or {}
        print(f"{name}: {SEGMENT_ST.get(o.get('status'), o.get('status'))}. {o.get('comment') or ''}")
        if o.get("evidence"):
            print(f"    «{o['evidence']}»")
    bs = r.get("boundaries") or []
    if bs:
        print("\nСтыки частей:")
        print(f"  {'№':>3}  {'стык':<7} {'время':>8}  {'оценка':<26} комментарий")
        for x in bs:
            print(f"  {x.get('boundary', ''):>3}  {x.get('between', ''):<7} {x.get('time', ''):>8}  "
                  f"{BOUNDARY_ST.get(x.get('status'), str(x.get('status'))):<26} {x.get('comment') or ''}")
            if x.get("evidence_end") or x.get("evidence_start"):
                print(f"{'':25}…«{x.get('evidence_end') or ''}» | «{x.get('evidence_start') or ''}»…")
    if r.get("issues"):
        print("\nПроблемы:")
        for x in r["issues"]:
            print(f"  - [{x.get('severity')}] {x.get('type')} @ {x.get('where') or '—'}: {x.get('comment') or ''}")
            if x.get("evidence"):
                print(f"      «{x['evidence']}»")
    if r.get("duration_assessment"):
        print(f"\nДлительность: {r['duration_assessment']}")
    if r.get("translation_or_edition"):
        print(f"Перевод/редакция: {r['translation_or_edition']}")
    rec = {"keep": "оставить", "listen_manually": "послушать вручную", "redownload": "перекачать",
           "replace_source": "искать другой источник"}
    print(f"\nРекомендация: {rec.get(r.get('recommendation'), r.get('recommendation'))}")
    if r.get("listen_at"):
        print("Послушать:")
        for x in r["listen_at"]:
            print(f"  {x.get('time')}  {x.get('why')}")
    t = rep["timings"]
    print(f"\nВремя: нарезка {t['cut_sec']} с, распознавание {t['stt_sec']} с "
          f"({t['clips_transcribed']} новых из {t['clips']}), Claude {t['llm_sec']} с; всего {t['total_sec']} с"
          + (f"; ${t['cost_usd']:.3f}" if t.get("cost_usd") else ""))
    print(f"Отчёт: {REPORTS / (rep['id'] + '.json')}")


# --------------------------------------------------------------------------- list-risky

# те же «рискованные» слова, что ищет `abook verify` в полях манифеста
RISK_RE = re.compile(
    r"возможно\s+неполн|неполн\w*|сокращ\w*|избранн\w*|част\w*\s+(?:отсутств|нет\b)|отсутству\w*\s+част|"
    r"не\s+хватает|без\s+(?:последн|финал)|глав[аы]?\s+\d+\s*[–—-]\s*\d+|только\s+(?:перв|част|глав)|"
    r"abridged|incomplete|excerpt", re.I)
RISK_FIELDS = ("title", "narrator", "about", "why", "note_ru", "quality", "kind", "source")


def list_risky(catalog, state):
    est = load_estimates()
    repl = (load_json(REPLACEMENTS, {}) or {}).get("items", {})
    rows = []
    for iid in sorted(set(catalog) | set(state)):
        m, st, e = catalog.get(iid, {}), state.get(iid, {}), est.get(iid, {})
        if m.get("_manifest") == FULL_CATALOG and iid not in state:
            continue
        why, score = [], 0
        if e.get("verdict") in ("short", "long"):
            why.append(f"по объёму текста {'КОРОЧЕ' if e['verdict'] == 'short' else 'длиннее'} ожидаемого "
                       f"(ratio {e.get('ratio')}, {e.get('expected_h_low')}–{e.get('expected_h_high')} ч)")
            score += 3 if e["verdict"] == "short" else 2
        if st.get("warnings"):
            why.append("предупреждения: " + "; ".join(map(str, st["warnings"]))[:160])
            score += 3
        checks = st.get("checks")
        if isinstance(checks, dict) and any(v is False or (isinstance(v, dict) and v.get("ok") is False)
                                            for v in checks.values()):
            why.append("проваленные проверки в state")
            score += 4
        if m.get("note_ru"):
            why.append("заметка: " + m["note_ru"][:120])
            score += 2
        risky = sorted({f for f in RISK_FIELDS if f != "note_ru" and RISK_RE.search(str(m.get(f) or ""))})
        if risky:
            hit = RISK_RE.search(" ".join(str(m.get(f)) for f in risky)).group(0)
            why.append(f"в манифесте «{hit}» ({', '.join(risky)})")
            score += 2
        r = repl.get(iid) or {}
        if r.get("action") == "replace":
            why.append("источник заменён после ресёрча")
            score += 1
        n_urls = len(m.get("urls") or st.get("source_urls") or [])
        if why and n_urls > 1:
            why.append(f"{n_urls} частей")
            score += 1
        if not why:
            continue
        rep = load_json(REPORTS / f"{iid}.json")
        checked = VERDICTS.get(((rep or {}).get("result") or {}).get("verdict"), "") if rep else ""
        rows.append((st.get("status") != "done", -score, iid, st.get("status") or "не начата", checked, why))
    rows.sort()
    print(f"{'id':<42} {'статус':<11} {'проверка':<18} почему")
    for _, s, iid, status, checked, why in rows:
        print(f"{iid:<42} {status:<11} {checked or '—':<18} {' | '.join(why)}")
    done = sum(1 for r in rows if r[3] == "done")
    print(f"\nВсего {len(rows)} (скачано {done}). Проверять: abook-check <id>")


# --------------------------------------------------------------------------- main

def main():
    if "--_stt-worker" in sys.argv:
        return stt_worker()
    ap = argparse.ArgumentParser(prog="abook-check", description=__doc__.split("\n\n")[0])
    ap.add_argument("query", nargs="*", help="id книги или часть автора/названия")
    ap.add_argument("--model", default="sonnet", help="sonnet (по умолчанию) или opus")
    ap.add_argument("--clips", type=int, default=3, help="сколько фрагментов из середины (по умолчанию 3)")
    ap.add_argument("--clip-len", type=float, default=60, help="длина фрагмента из середины, с (60)")
    ap.add_argument("--whisper", default="small", help="модель faster-whisper (small)")
    ap.add_argument("--threads", type=int, default=4, help="потоков CTranslate2 (4; больше при загруженном CPU только хуже)")
    ap.add_argument("--json", action="store_true", help="напечатать сырой JSON отчёта")
    ap.add_argument("--prompt-only", action="store_true", help="собрать промпт и напечатать его, без Claude")
    ap.add_argument("--no-cache", action="store_true", help="распознать заново")
    ap.add_argument("--timeout", type=int, default=900, help="таймаут вызова Claude, с")
    ap.add_argument("--list-risky", action="store_true", help="что проверять в первую очередь")
    ap.add_argument("--show", action="store_true", help="показать сохранённый отчёт, ничего не запуская")
    ap.add_argument("-v", "--verbose", action="store_true")
    a = ap.parse_args()

    catalog, state = load_catalog(), load_state()
    if a.list_risky:
        return list_risky(catalog, state)
    if not a.query:
        ap.error("укажите id или запрос (или --list-risky)")
    iid, cands = find_item(" ".join(a.query), catalog, state)
    if not iid:
        if not cands:
            die("ничего не найдено")
        print("Найдено несколько — уточните id:", file=sys.stderr)
        for c in cands[:25]:
            m, s = catalog.get(c, {}), state.get(c, {})
            print(f"  {c:<42} {s.get('status') or '—':<11} {m.get('author') or s.get('author')} — "
                  f"{m.get('title') or s.get('title')}", file=sys.stderr)
        sys.exit(2)
    m, st = catalog.get(iid, {}), state.get(iid, {})
    if a.show:
        rep = load_json(REPORTS / f"{iid}.json")
        if not rep:
            die(f"{iid}: отчёта ещё нет — запустите abook-check {iid}")
        return print(json.dumps(rep, ensure_ascii=False, indent=1)) if a.json else print_report(rep)
    if st.get("status") != "done":
        die(f"{iid}: книга ещё не скачана (статус: {st.get('status') or 'нет в state'})")
    src = Path(st.get("final_path") or "")
    if not src.is_file():
        die(f"{iid}: файл не найден: {src}")
    if a.model not in ("sonnet", "opus") and not a.model.startswith("claude-"):
        die("--model: sonnet или opus")

    t_all = time.time()
    lang = (m.get("lang") or "ru").strip().lower()[:2]
    if lang not in ("ru", "uk", "en"):
        lang = "ru"
    probe = ffprobe(src)
    dur, parts, layout_src = part_layout(st, probe)
    clips = plan_clips(dur, parts, max(0, a.clips), a.clip_len)

    cdir = CACHE / iid
    cdir.mkdir(parents=True, exist_ok=True)
    fst = src.stat()
    fp = hashlib.sha1(f"{st.get('sha256') or ''}|{fst.st_size}|{int(fst.st_mtime)}|{a.whisper}|{lang}"
                      .encode()).hexdigest()[:12]
    meta_p = cdir / "meta.json"
    meta = load_json(meta_p, {}) or {}
    if meta.get("fingerprint") != fp or a.no_cache:
        for f in cdir.glob("*.json"):
            f.unlink()
        meta = {"fingerprint": fp, "file": str(src), "clips": {}}

    # 1. нарезка (+ паузы/громкость) — только для фрагментов без кэша
    t0 = time.time()
    todo = []
    for c in clips:
        ck = f"{c['key']}_{c['start']:.1f}_{c['len']:.1f}"
        c["_txt"] = str(cdir / f"{ck}.json")
        c["_wav"] = str(cdir / f"{ck}.wav")
        if Path(c["_txt"]).exists() and ck in meta["clips"]:
            c.update(meta["clips"][ck])
            continue
        info = cut_clip(src, c, c["_wav"])
        c.update(info)
        meta["clips"][ck] = info
        todo.append(c)
    cut_sec = time.time() - t0
    if a.verbose or todo:
        print(f"{iid}: {len(clips)} фрагментов ({len(todo)} новых), частей {len(parts)} [{layout_src}], "
              f"язык {lang}, нарезка {cut_sec:.1f} с; распознаю…", file=sys.stderr, flush=True)

    # 2. распознавание
    t0 = time.time()
    if todo:
        transcribe(todo, lang, a.whisper, a.threads, a.verbose)
        for c in todo:
            Path(c["_wav"]).unlink(missing_ok=True)
    stt_sec = time.time() - t0
    meta_p.write_text(json.dumps(meta, ensure_ascii=False, indent=1), encoding="utf-8")
    clips_out = []
    for c in clips:
        tr = load_json(c["_txt"], {}) or {}
        clips_out.append({k: v for k, v in c.items() if not k.startswith("_")} | {"transcript": tr})

    est = load_estimates().get(iid) or {}
    repl = ((load_json(REPLACEMENTS, {}) or {}).get("items", {}).get(iid) or {}).get("reason")
    ctx = {"id": iid, "manifest": m, "state": st, "estimate": est, "replacement": repl, "lang": lang,
           "duration": dur, "parts": parts, "layout_src": layout_src}
    prompt = build_prompt(ctx, clips_out)
    (cdir / "prompt.txt").write_text(prompt, encoding="utf-8")
    if a.prompt_only:
        print(prompt)
        print(f"\n[промпт сохранён: {cdir / 'prompt.txt'}]", file=sys.stderr)
        return

    # 3. Claude
    print(f"{iid}: спрашиваю Claude ({a.model})…", file=sys.stderr, flush=True)
    try:
        result, llm_meta = ask_claude(prompt, a.model, a.timeout)
    except (RuntimeError, ValueError, subprocess.TimeoutExpired, json.JSONDecodeError) as e:
        die(f"{iid}: Claude не дал корректный ответ: {e}\nПромпт: {cdir / 'prompt.txt'}")

    rep = {
        "id": iid, "checked_at": datetime.now().isoformat(timespec="seconds"), "model": a.model,
        "llm": llm_meta, "file": str(src), "sha256": st.get("sha256"), "whisper": a.whisper, "lang": lang,
        "file_size": fst.st_size, "file_mtime": int(fst.st_mtime),   # чтобы abook_tg мог переиспользовать свежий отчёт
        "book": {"author": m.get("author") or st.get("author"), "title": m.get("title") or st.get("title"),
                 "narrator": m.get("narrator") or st.get("narrator"), "duration_sec": round(dur, 1),
                 "parts": len(parts), "layout": layout_src,
                 "expected_h": [est.get("expected_h_low"), est.get("expected_h_high")]
                 if est.get("expected_h_low") is not None else None,
                 "estimate_verdict": est.get("verdict")},
        "parts": parts,
        "clips": [{k: v for k, v in c.items() if k != "transcript"} | {"text": c["transcript"].get("text", ""),
                  "detected": c["transcript"].get("detected")} for c in clips_out],
        "result": result,
        "timings": {"cut_sec": round(cut_sec, 1), "stt_sec": round(stt_sec, 1),
                    "llm_sec": round(sum(x["sec"] for x in llm_meta), 1),
                    "total_sec": round(time.time() - t_all, 1), "clips": len(clips),
                    "clips_transcribed": len(todo),
                    "cost_usd": sum(x.get("cost_usd") or 0 for x in llm_meta) or None},
    }
    REPORTS.mkdir(parents=True, exist_ok=True)
    out = REPORTS / f"{iid}.json"
    tmp = out.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(rep, ensure_ascii=False, indent=1), encoding="utf-8")
    os.replace(tmp, out)
    if a.json:
        print(json.dumps(rep, ensure_ascii=False, indent=1))
    else:
        print_report(rep)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        die("прервано", 130)
